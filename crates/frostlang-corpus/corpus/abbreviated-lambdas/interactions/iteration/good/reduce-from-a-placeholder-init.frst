# A `reduce` call inside an abbreviated lambda may take its initial value and
# its collection from placeholders, with a `fn` as the function.
#= {
#=     result: [16, 10],
#=     lints: ['lambda in abbreviated lambda'],
#=     inputs: {xs: [1, 2, 3], none: []},
#= }
def {xs, none} = import('inputs')
def total = $(reduce($2, $1, fn acc, x -> acc + x))
[total(10, xs), total(10, none)]
