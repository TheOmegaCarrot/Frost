# `map` with an abbreviated lambda over an Array known only at runtime,
# including the empty and single-element cases.
#= {result: [[2, 4, 6], [], [-2]], inputs: {xs: [1, 2, 3], none: [], one: [-1]}}
def {xs, none, one} = import('inputs')
def double = $($ * 2)
[map(xs, double), map(none, double), map(one, double)]
