# Arithmetic on a placeholder wraps in two's complement at the Int limits,
# as everywhere in Frost.
#= {result: [-9223372036854775808, 9223372036854775807, 0]}
def inc = $($ + 1)
def dec = $($ - 1)
def double = $($ * 2)
[inc(9223372036854775807), dec(-9223372036854775808), double(-9223372036854775808)]
