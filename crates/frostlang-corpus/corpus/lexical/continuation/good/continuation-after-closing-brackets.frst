# A continuation line may follow an expression that ends with a closing
# bracket or brace: a `do` block, a `match`, a Map literal, a call, and an
# index.
#= {result: [2, 5, 1, 3, 9]}
def a = do {
    [1, 2]
}
    @ len()
def b = match 1 {
    _ => {k: 5},
}
    .k
def c = {k: 1}
    .k
def d = len([1, 2, 3])
    @ to_string()
    @ len()
def e = [{k: 9}][0]
    .k
[a, b, c, d + 2, e]
