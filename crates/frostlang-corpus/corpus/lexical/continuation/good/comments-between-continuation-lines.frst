# Comments, whether trailing a line or on lines of their own, do not break a
# continuation: a pipeline's steps can each be commented.
#= {result: [20, 40], inputs: {xs: [1, 2, 3, 4]}}
xs # the input
    # keep the even ones
    @ filter(fn x -> x % 2 == 0)
    # then scale them
    @ map(fn x -> x * 10) # by ten
