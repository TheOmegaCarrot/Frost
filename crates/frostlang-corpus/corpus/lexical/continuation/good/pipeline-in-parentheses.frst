# A pipeline wrapped in parentheses may span lines, with each step on its own
# line; inside the parentheses even an `@` ending a line continues.
#= {result: [120, 6], inputs: {xs: [10, 20, 30]}}
def doubled_total = (
    xs
    @ map(fn x -> x * 2)
    @ reduce(0, fn (acc, x) -> acc + x)
)
def digits = (xs @
    map(to_string) @
    reduce('', fn (acc, s) -> acc + s) @
    len())
[doubled_total, digits]
