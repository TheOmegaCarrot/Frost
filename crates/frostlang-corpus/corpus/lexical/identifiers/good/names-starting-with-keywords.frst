def iffy = 2
def nullable = 3
def trueish = 4
def falsey = 5
def android = 6
def order = 7
def notable = 8
def isle = 9
def ascend = 10
def fnord = 11
def matches = 12
def exported = 13
def elsewhere = 14
def elifant = 15
def done = 16
[define, iffy, nullable, trueish, falsey, android, order, notable, isle, ascend, fnord, matches, exported, elsewhere, elifant, done]
