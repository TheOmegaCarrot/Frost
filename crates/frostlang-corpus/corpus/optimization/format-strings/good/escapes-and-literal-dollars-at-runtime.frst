# The format strings of escapes-and-literal-dollars-folded, beside a binding
# only known at runtime, give the same text: the escaped interpolation never
# reads the binding.
#= {result: ['plain', '${name}', 'cost: $5', 'x$'], inputs: {name: 'x'}}
[
    $'plain',
    $'\${name}',
    $'cost: $5',
    $'${name}$',
]
