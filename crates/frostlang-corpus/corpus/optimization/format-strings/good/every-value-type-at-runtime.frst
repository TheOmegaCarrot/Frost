# The interpolations of every-value-type-folded, of values only known at
# runtime, build the same text.
#= {
#=     result: [
#=         'null',
#=         'true',
#=         '-9223372036854775808',
#=         '1.5',
#=         '-0.0',
#=         's',
#=         "x'6162'",
#=         '[ 1, "a" ]',
#=         '{ ["a"]: 1 }',
#=         '[]',
#=     ],
#=     inputs: {values: [null, true, -9223372036854775808, 1.5, -0.0, 's', x'6162', [1, 'a'], {a: 1}, []]},
#= }
def {values} = import('inputs')
map(values, fn v -> $'${v}')
