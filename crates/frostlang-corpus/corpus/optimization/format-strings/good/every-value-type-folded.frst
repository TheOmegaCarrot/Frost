# Interpolating a constant of each type folds to the same text as at runtime;
# a negative zero keeps its sign.
#= {
#=     result: [
#=         'null',
#=         'true',
#=         '-9223372036854775808',
#=         '1.5',
#=         '-0.0',
#=         's',
#=         "x'6162'",
#=         '[ 1, "a" ]',
#=         '{ ["a"]: 1 }',
#=         '[]',
#=     ],
#= }
[
    $'${null}',
    $'${true}',
    $'${-9223372036854775808}',
    $'${1.5}',
    $'${-0.0}',
    $'${'s'}',
    $'${x'6162'}',
    $'${[1, 'a']}',
    $'${{a: 1}}',
    $'${[]}',
]
