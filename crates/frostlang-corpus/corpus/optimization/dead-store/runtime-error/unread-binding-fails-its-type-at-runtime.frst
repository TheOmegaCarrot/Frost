# A binding nothing reads still has its type constraint checked, so a value
# only known at runtime of the wrong type raises.
#= {
#=     raises: 'expected a string',
#=     lints: [['unused binding', '`unused`']],
#=     inputs: {five: 5},
#= }
def {five} = import('inputs')
def unused is String = five
'ok'
