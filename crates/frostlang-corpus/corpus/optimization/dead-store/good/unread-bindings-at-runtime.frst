# The unread bindings of unread-bindings-do-not-change-the-result, over values
# only known at runtime, leave the result unchanged.
#= {
#=     result: 1,
#=     lints: [
#=         ['unused binding', '`unused`'],
#=         ['unused binding', '`chain_c`'],
#=         ['unused binding', '`b`'],
#=     ],
#=     inputs: {text: 'never read', one: 1, pair: [1, 2]},
#= }
def {text, one, pair} = import('inputs')
def unused = text
def chain_a = one
def chain_b = chain_a
def chain_c = chain_b
def [a, b] = pair
a
