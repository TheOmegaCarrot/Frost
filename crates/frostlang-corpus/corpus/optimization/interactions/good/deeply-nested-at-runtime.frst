# The reads of deeply-nested-constant, from a value only known at runtime,
# give the same parts.
#= {
#=     result: [1.5, 'é', [null, true, 1.5, x'00', 'é'], 'deep'],
#=     inputs: {data: {[1]: [{a: [null, true, 1.5, x'00', 'é']}], b: {c: {d: [['deep']]}}}},
#= }
def {data} = import('inputs')
def {b: {c: {d: [[deepest]]}}} = data
[data[1][0].a[2], data[1][0].a[-1], data[1][0].a, deepest]
