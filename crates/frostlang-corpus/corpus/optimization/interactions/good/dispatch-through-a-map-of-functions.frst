# Known functions held in a Map, chosen by key and matched against Null for an
# unknown operation, compute their results.
#= {result: [5, 6, 'unknown']}
def handlers = {add: fn a, b -> a + b, mul: fn a, b -> a * b}
defn apply(op, a, b) -> match handlers[op] {
    null => 'unknown',
    f => f(a, b),
}
[apply('add', 2, 3), apply('mul', 2, 3), apply('pow', 2, 3)]
