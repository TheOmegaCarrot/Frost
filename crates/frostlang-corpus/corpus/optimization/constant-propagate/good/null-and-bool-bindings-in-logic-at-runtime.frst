# The logic of null-and-bool-bindings-in-logic, over values only known at
# runtime, returns the same operands.
#= {
#=     result: ['default', null, false, 0, true, 'yes'],
#=     inputs: {nothing: null, no: false, zero: 0, yes: true},
#= }
[
    nothing or 'default',
    nothing and 'unreached',
    no and 'unreached',
    no or zero,
    not nothing,
    yes and 'yes',
]
