# The patterns of pin-before-a-shadowing-part, over values only known at
# runtime, read the outer bindings the same way.
#= {
#=     result: [2, 5, [3, 'z']],
#=     inputs: {first: [1, 2], second: [2, 5], third: {c: 3, k: 'z'}},
#= }
def {first, second, third} = import('inputs')
def b = 1
def f = fn x -> x * 2
def k = 'c'
[
    do {
        def [(b), b] = first
        b
    },
    do {
        def [(f(1)), f] = second
        f
    },
    do {
        def {[k]: v, k} = third
        [v, k]
    },
]
