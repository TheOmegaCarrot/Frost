# The functions of wrapping-in-a-known-function, called over values only known
# at runtime, return the same wrapped values.
#= {
#=     result: [-9223372036854775808, -9223372036709301616, 9223372036854775805],
#=     inputs: {greatest: 9223372036854775807, root: 3037000500},
#= }
defn inc(n) -> n + 1
defn square(n) -> n * n
defn triple(n) -> n * 3
[inc(greatest), square(root), triple(greatest)]
