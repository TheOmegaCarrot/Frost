# An `if` as the result of another `if` or `elif` branch yields its own branch's
# value for every combination of truthy and falsy conditions.
#= {
#=     result: [1, 2, 3, 4, 5, 6, 7, 8],
#=     inputs: {zero: 0, empty: '', arr: [], nil: null, no: false},
#= }
def {zero, empty, arr, nil, no} = import('inputs')
defn classify(a, b, c) -> if a: do {
    if b: do { if c: 1 else: 2 }
    else: do { if c: 3 else: 4 }
}
elif b: do { if c: 5 else: 6 }
else: do { if c: 7 else: 8 }
[
    classify(zero, empty, arr),
    classify(zero, empty, nil),
    classify(zero, nil, arr),
    classify(zero, no, nil),
    classify(nil, empty, arr),
    classify(no, arr, no),
    classify(nil, no, zero),
    classify(no, nil, nil),
]
