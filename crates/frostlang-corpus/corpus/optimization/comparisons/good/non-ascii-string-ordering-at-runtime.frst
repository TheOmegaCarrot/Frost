# The orderings of folded-non-ascii-string-ordering, over Strings only known
# at runtime, give the same answers.
#= {
#=     result: [true, true, true, true, true],
#=     inputs: {accented: 'é', a: 'a', japanese: '日', ab: 'ab', hello: 'héllo'},
#= }
def {accented, a, japanese, ab, hello} = import('inputs')
[
    accented > 'z',
    a < 'é',
    japanese > 'é',
    ab < 'b',
    hello < 'héllo!',
]
