# The orderings of folded-ordering, over values only known at runtime, give
# the same answers.
#= {
#=     result: [true, true, false, true, true, true, true, true, false],
#=     inputs: {
#=         one: 1,
#=         two: 2,
#=         three: 3,
#=         half: 2.5,
#=         a: 'a',
#=         low: x'01',
#=         greatest: 9223372036854775807,
#=         least: -9223372036854775808,
#=     },
#= }
def {one, two, three, half, a, low, greatest, least} = import('inputs')
[
    one < 2,
    two <= 2,
    three > 4,
    one < 1.5,
    half >= 2,
    a < 'b',
    low < x'02',
    greatest < 9223372036854775807.0,
    least > -9223372036854775808.0,
]
