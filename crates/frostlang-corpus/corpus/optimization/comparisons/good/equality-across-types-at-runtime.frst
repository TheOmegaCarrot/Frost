# The equalities of folded-equality-across-types, over values only known at
# runtime, give the same answers.
#= {
#=     result: [false, false, false, false, true, true, false, false, true],
#=     inputs: {
#=         three: 3,
#=         one: 1,
#=         nothing: null,
#=         a: 'a',
#=         nested: [1, [2]],
#=         m: {a: 1, b: 2},
#=         zero: 0.0,
#=         single: [1],
#=     },
#= }
def {three, one, nothing, a, nested, m, zero, single} = import('inputs')
[
    three == 3.0,
    one == '1',
    nothing == false,
    a == x'61',
    nested == [1, [2]],
    m == {b: 2, a: 1},
    zero == -0.0,
    single != [1],
    nothing == null,
]
