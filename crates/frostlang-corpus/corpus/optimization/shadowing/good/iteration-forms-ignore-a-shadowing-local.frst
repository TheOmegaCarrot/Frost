# The iteration forms always call their global, even where a local of the
# same name is in scope, while a direct call of the name calls the local.
#= {result: [[10, 20], [2], 3, [1, 2], ['shadow', 'shadow', 'shadow', 'shadow']]}
def transform = fn s, op -> 'shadow'
def select = fn s, op -> 'shadow'
def fold = fn s, op -> 'shadow'
def each = fn s, op -> 'shadow'
[
    map [1, 2] with $($ * 10),
    filter [1, 2] with $($ > 1),
    reduce [1, 2] with fn a, b -> a + b,
    foreach [1, 2] with fn x -> x,
    [transform([1], 0), select([1], 0), fold([1], 0), each([1], 0)],
]
