# The conditions of truthiness-of-constant-conditions, only known at runtime,
# pick the same branches.
#= {
#=     result: ['t', 't', 't', 't', 't', 't', 'f', 'f'],
#=     inputs: {conditions: [0, 0.0, '', x'', [], {}, null, false]},
#= }
def {conditions} = import('inputs')
map(conditions, fn c -> if c: 't' else: 'f')
