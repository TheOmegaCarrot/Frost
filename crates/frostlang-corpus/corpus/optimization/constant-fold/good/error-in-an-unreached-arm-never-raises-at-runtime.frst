# The matches of error-in-an-unreached-arm-never-raises, on targets only known
# at runtime, never run the arm that would raise.
#= {result: ['first', 'safe'], inputs: {one: 1, k: 'k'}}
[
    match one {
        1 => 'first',
        _ => 1 / 0,
    },
    match k {
        'j' => {a: 1}.b,
        'k' => 'safe',
    },
]
