# The checks of is-family-over-every-type, over values only known at runtime,
# give exactly the answers the folder computes.
#= {
#=     result: [
#=         [true, false, true, false, false, false],
#=         [false, true, true, false, false, true],
#=         [false, true, true, false, false, true],
#=         [false, false, true, false, false, true],
#=         [false, false, true, false, true, true],
#=         [false, false, true, false, true, true],
#=         [false, false, false, true, false, true],
#=         [false, false, false, true, false, true],
#=     ],
#=     inputs: {values: [null, 1, 1.5, true, 's', x'00', [], {}]},
#= }
def {values} = import('inputs')
def check = fn v -> [is_null(v), is_numeric(v), is_primitive(v), is_structured(v), is_flat(v), is_nonnull(v)]
map(values, check)
