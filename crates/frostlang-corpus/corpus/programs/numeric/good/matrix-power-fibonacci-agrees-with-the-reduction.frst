# Fibonacci numbers two ways: by raising [[1, 1], [1, 0]] to the nth power
# with repeated squaring, and by a plain reduction. The matrix power also holds
# fib(n + 1), so fib(91) is the largest whose matrix power stays within an Int.
# Subtle: the squaring path reaches each result through very different
# products than the reduction's sums, yet the two paths agree on every result.
#= {
#=     result: [[0, 1, 55, 2880067194370816120, 4660046610375530309], true],
#=     inputs: {ns: [0, 1, 10, 90, 91]},
#= }
def {ns} = import('inputs')
defn mul(a, b) -> [
    [a[0][0] * b[0][0] + a[0][1] * b[1][0], a[0][0] * b[0][1] + a[0][1] * b[1][1]],
    [a[1][0] * b[0][0] + a[1][1] * b[1][0], a[1][0] * b[0][1] + a[1][1] * b[1][1]],
]
defn power(m, n) -> match n {
    0 => [[1, 0], [0, 1]],
    _ if: n % 2 == 0 => do {
        def half = power(m, n / 2)
        mul(half, half)
    },
    _ => mul(m, power(m, n - 1)),
}
defn by_matrix(n) -> power([[1, 1], [1, 0]], n)[0][1]
defn by_reduction(n) -> reduce(range(n), [0, 1], fn pair, _ -> [pair[1], pair[0] + pair[1]])[0]

def matrix = map(ns, by_matrix)
[matrix, matrix == map(ns, by_reduction)]
