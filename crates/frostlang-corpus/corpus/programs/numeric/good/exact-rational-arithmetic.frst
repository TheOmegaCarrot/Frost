# Exact fractions as Maps kept in lowest terms by Euclid's gcd, with the sign
# carried by the numerator. Summing 1/1 through 1/6 gives 49/20 exactly,
# where the same sum in Floats would be inexact. A zero result normalizes
# to 0/1, and a negative denominator moves its sign up.
#= {
#=     result: {
#=         harmonic: '49/20',
#=         cancels: '0/1',
#=         negative: '-1/6',
#=         flipped: '-2/3',
#=         product: '1/3',
#=     },
#=     inputs: {n: 6},
#= }
defn gcd(a, b) -> if b == 0: (if a < 0: -a else: a) else: gcd(b, a % b)

defn ratio(num, den) -> {
    def g = gcd(num, den)
    def sign = if den < 0: -1 else: 1
    {num: sign * num / g, den: sign * den / g}
}

defn add(x, y) -> ratio(x.num * y.den + y.num * x.den, x.den * y.den)
defn multiply(x, y) -> ratio(x.num * y.num, x.den * y.den)
defn show(x) -> $'${x.num}/${x.den}'

defn harmonic(k) -> if k == 0: ratio(0, 1) else: add(harmonic(k - 1), ratio(1, k))

{
    harmonic: show(harmonic(n)),
    cancels: show(add(ratio(1, 2), ratio(-1, 2))),
    negative: show(add(ratio(-1, 2), ratio(1, 3))),
    flipped: show(ratio(4, -6)),
    product: show(multiply(ratio(2, 3), ratio(3, 6))),
}
