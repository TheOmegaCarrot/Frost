# Fibonacci numbers two ways: by raising [[1, 1], [1, 0]] to the nth power
# with repeated squaring, and by a plain fold. Past fib(92) both wrap. Subtle:
# the squaring path multiplies huge wrapped values, yet wrapping arithmetic
# is exact modulo 2^64, so the two paths still agree on every result.
#= {
#=     result: [
#=         [0, 1, 55, 7540113804746346429, -6246583658587674878, 3736710778780434371, -1123705814761610347],
#=         true,
#=     ],
#=     inputs: {ns: [0, 1, 10, 92, 93, 100, 200]},
#= }
defn mul(a, b) -> [
    [a[0][0] * b[0][0] + a[0][1] * b[1][0], a[0][0] * b[0][1] + a[0][1] * b[1][1]],
    [a[1][0] * b[0][0] + a[1][1] * b[1][0], a[1][0] * b[0][1] + a[1][1] * b[1][1]],
]
defn power(m, n) -> match n {
    0 => [[1, 0], [0, 1]],
    _ if: n % 2 == 0 => do {
        def half = power(m, n / 2)
        mul(half, half)
    },
    _ => mul(m, power(m, n - 1)),
}
defn by_matrix(n) -> power([[1, 1], [1, 0]], n)[0][1]
defn by_fold(n) -> (reduce range(n) init: [0, 1] with fn pair, _ -> [pair[1], pair[0] + pair[1]])[0]

def matrix = map ns with by_matrix
[matrix, matrix == map ns with by_fold]
