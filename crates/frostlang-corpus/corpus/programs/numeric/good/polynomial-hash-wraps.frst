# A polynomial hash folded over character codes: multiplying by a large
# constant overflows within a few steps, and every multiply and add wraps in
# two's complement, so the hash is the exact value modulo 2^64. The empty
# input hashes to the seed.
#= {
#=     result: [-5405162754168362655, 7000167000914001536, 7, 7000021, -9223365036813775749],
#=     inputs: {
#=         inputs_to_hash: [
#=             [104, 101, 108, 108, 111, 32, 119, 111, 114, 108, 100],
#=             [104, 101, 108],
#=             [],
#=             [0],
#=             [-1, 9223372036854775807],
#=         ],
#=     },
#= }
defn hash(codes) -> fold(codes, 7, fn h, code -> h * 1000003 + code)

transform(inputs_to_hash, hash)
