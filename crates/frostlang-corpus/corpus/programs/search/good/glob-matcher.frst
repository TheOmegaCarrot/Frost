# A glob matcher over character Arrays, matching pattern and text together
# as a pair of Array patterns: `?` takes any one character, and `*` either
# matches nothing or swallows one character and tries again, backtracking
# through `or`. Literal characters, non-ASCII ones included, must agree.
#= {
#=     result: [true, false, true, false, true, false, true, true, true, false],
#=     inputs: {
#=         cases: [
#=             [['*', '.', 't', 'x', 't'], ['n', 'o', 't', 'e', 's', '.', 't', 'x', 't']],
#=             [['*', '.', 't', 'x', 't'], ['n', 'o', 't', 'e', 's', '.', 'm', 'd']],
#=             [['a', '?', 'c'], ['a', 'b', 'c']],
#=             [['a', '?', 'c'], ['a', 'c']],
#=             [['*'], []],
#=             [[], ['x']],
#=             [['*', '*', 'a'], ['b', 'b', 'a']],
#=             [['é', '*'], ['é', 't', 'é']],
#=             [['a', '*', 'b', '*', 'c'], ['a', 'X', 'b', 'Y', 'b', 'Z', 'c']],
#=             [['a', '*', 'b', '*', 'c'], ['a', 'c', 'b']],
#=         ],
#=     },
#= }
defn glob(pattern, text) -> match [pattern, text] {
    [[], []] => true,
    [['*', ...rest], []] => glob(rest, []),
    [['*', ...rest], [_, ...more]] => glob(rest, text) or glob(pattern, more),
    [['?', ...rest], [_, ...more]] => glob(rest, more),
    [[p, ...rest], [t, ...more]] if: p == t => glob(rest, more),
    _ => false,
}

transform(cases, fn c -> glob(c[0], c[1]))
