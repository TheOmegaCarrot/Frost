# The Towers of Hanoi: the move list is built by the classic double
# recursion, then replayed by a fold over a Map of pegs (each an Array with
# the top disk last) that checks no disk ever lands on a smaller one. All
# disks end on the target peg after 2^n - 1 moves.
#= {
#=     result: {
#=         three: [['a', 'c'], ['a', 'b'], ['c', 'b'], ['a', 'c'], ['b', 'a'], ['b', 'c'], ['a', 'c']],
#=         final: {a: [], b: [], c: [6, 5, 4, 3, 2, 1]},
#=         move_count: 63,
#=         legal: true,
#=     },
#=     inputs: {small: 3, large: 6},
#= }
defn moves(n, from, to, via) ->
    if n == 0: []
    else: moves(n - 1, from, via, to) + [[from, to]] + moves(n - 1, via, to, from)

defn from_to(high, low) -> if high < low: [] else: [high] + from_to(high - 1, low)

defn replay(pegs, move) -> {
    def [from, to] = move
    def disk = pegs[from][-1]
    def target = pegs[to]
    def legal = pegs.legal and (target == [] or target[-1] > disk)
    def remaining = fold(pegs[from], [], fn kept, d -> if d == disk: kept else: kept + [d])
    pegs + {[from]: remaining, [to]: target + [disk], legal}
}

def plan = moves(large, 'a', 'c', 'b')
def finished = fold(plan, {a: from_to(large, 1), b: [], c: [], legal: true}, replay)
{
    three: moves(small, 'a', 'c', 'b'),
    final: {a: finished.a, b: finished.b, c: finished.c},
    move_count: len(plan),
    legal: finished.legal,
}
