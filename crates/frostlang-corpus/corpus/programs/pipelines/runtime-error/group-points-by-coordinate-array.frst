# Grouping points by their [x, y] coordinates fails: an Array is not a valid
# Map key, so a program must encode such a key, for example as a String.
#= {
#=     raises: ['not a valid Map key', 'Array'],
#=     inputs: {points: [{at: [0, 1], name: 'a'}, {at: [0, 1], name: 'b'}]},
#= }
def {points} = import('inputs')
reduce(points, {}, fn acc, p -> acc + {[p.at]: (acc[p.at] or []) + [p.name]})
