# A report builder concatenates a name with a count without converting it:
# String plus Int is a type error, raised from inside the `reduce` that
# builds the lines, not silently stringified.
#= {
#=     raises: 'String + Int',
#=     inputs: {counts: {apples: 3, pears: 5}},
#= }
reduce(counts, [], fn lines, name, count -> lines + [name + ': ' + count])
