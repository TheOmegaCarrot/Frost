# The sales report over literal records, which the optimizer may compute
# ahead of time, Map merges and key-ordered reductions included: it must
# agree with the report over runtime records.
#= {
#=     result: {
#=         lines: ['east: 20', 'north: 16', 'south: 9'],
#=         best: 'east',
#=         total: 45,
#=     },
#= }
def sales = [
    {region: 'north', item: 'apple', qty: 3, price: 2},
    {region: 'south', item: 'pear', qty: 1, price: 5},
    {region: 'north', item: 'pear', qty: 2, price: 5},
    {region: 'east', item: 'apple', qty: 10, price: 2},
    {region: 'south', item: 'plum', qty: 4, price: 1},
]

defn add_sale(totals, sale) -> {
    def {region, qty, price} = sale
    totals + {[region]: (totals[region] or 0) + qty * price}
}

def totals = reduce(sales, {}, add_sale)
def lines = reduce(totals, [], fn acc, region, total -> acc + [$'${region}: ${total}'])
def best = reduce(totals, null, fn leader, region, total ->
    if leader == null or total > totals[leader]: region else: leader)
def total = reduce(totals, 0, fn sum, region, amount -> sum + amount)
{lines, best, total}
