# Merging intervals: sort by start, then fold, extending the last merged
# interval or starting a new one. Intervals that merely touch merge, one
# inside another vanishes into it, and the input need not be sorted.
#= {
#=     result: [[[1, 6], [8, 10], [15, 18]], 10, []],
#=     inputs: {
#=         spans: [[8, 10], [1, 3], [15, 18], [2, 4], [4, 6], [9, 9]],
#=         none: [],
#=     },
#= }
defn merge_into(merged, span) -> match merged {
    [] => [span],
    _ if: span[0] <= merged[-1][1] => do {
        def last = merged[-1]
        drop_tail(merged, 1) + [[last[0], maximum([last[1], span[1]])]]
    },
    _ => merged + [span],
}
defn merge_all(intervals) -> intervals
    @ sort_by(fn span -> span[0])
    @ reduce([], merge_into)
defn covered(intervals) -> reduce(intervals, 0, fn total, span ->
    total + span[1] - span[0])

def merged = merge_all(spans)
[merged, covered(merged), merge_all(none)]
