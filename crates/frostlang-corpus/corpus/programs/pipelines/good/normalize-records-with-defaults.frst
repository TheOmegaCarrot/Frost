# Cleaning raw records: a record without a String name is dropped (marked
# Null, then selected out), a missing or Null field takes a default via
# `or`, and a Bool field defaulting to true is read with `has` instead.
# Subtle: `raw['notify'] or true` would turn an explicit false into true,
# since `or` replaces every falsy value, not just a missing one.
#= {
#=     result: {
#=         kept: [
#=             {name: 'ana', age: 30, tags: [], notify: true},
#=             {name: 'ben', age: 0, tags: [], notify: true},
#=             {name: 'cy', age: 0, tags: ['x'], notify: false},
#=         ],
#=         rejected: 2,
#=     },
#=     inputs: {
#=         raw: [
#=             {name: 'ana', age: 30, notify: true},
#=             {name: 'ben'},
#=             {age: 5},
#=             {name: 'cy', age: null, tags: ['x'], notify: false},
#=             {name: 7},
#=         ],
#=     },
#= }
def {raw} = import('inputs')
defn normalize(record) -> if not is_string(record['name']): null else: {
    name: record.name,
    age: record['age'] or 0,
    tags: record['tags'] or [],
    notify: if has(record, 'notify'): record.notify else: true,
}

def normalized = map(raw, normalize)
def kept = filter(normalized, is_nonnull)
{kept, rejected: len(normalized) - len(kept)}
