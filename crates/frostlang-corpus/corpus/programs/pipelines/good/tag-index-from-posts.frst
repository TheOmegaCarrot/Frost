# An inverted index: flatten every post's tags into one Array, dedupe them by
# using Map keys as a set, and map each tag to the ids of the posts carrying
# it. A post with no tags contributes nothing, and a tag repeated within one
# post lists that post once.
#= {
#=     result: {
#=         all: ['frost', 'lang', 'frost', 'vm', 'vm', 'lang', 'zed'],
#=         unique: ['frost', 'lang', 'vm', 'zed'],
#=         index: {frost: [1, 2], lang: [1, 4], vm: [3], zed: [4]},
#=     },
#=     inputs: {
#=         posts: [
#=             {id: 1, tags: ['frost', 'lang']},
#=             {id: 2, tags: ['frost']},
#=             {id: 3, tags: ['vm', 'vm']},
#=             {id: 4, tags: ['lang', 'zed']},
#=             {id: 5, tags: []},
#=         ],
#=     },
#= }
def all = fold(posts, [], fn acc, post -> acc + post.tags)
def set = fold(all, {}, fn acc, tag -> acc + {[tag]: true})
def unique = reduce set init: [] with fn acc, tag, present -> acc + [tag]

defn add_post(index, post) -> {
    def post_tags = fold(post.tags, {}, fn acc, tag -> acc + {[tag]: true})
    reduce post_tags init: index with fn acc, tag, present -> acc + {[tag]: (acc[tag] or []) + [post.id]}
}

{all, unique, index: fold(posts, {}, add_post)}
