# An object as a Map of closures over its state: every "mutating" method
# returns a new object, so calls chain with field reads and the original is
# left as it was. Methods are called through field reads.
#= {
#=     result: {
#=         chained: 12,
#=         original: 0,
#=         branch_a: 1,
#=         branch_b: -5,
#=         history: [0, 1, 2, 12],
#=     },
#=     inputs: {start: 0, step: 10},
#= }
defn counter(n, history) -> {
    value: fn -> n,
    history: fn -> history + [n],
    increment: fn -> counter(n + 1, history + [n]),
    add: fn k -> counter(n + k, history + [n]),
}

def zero = counter(start, [])
def twelve = zero.increment().increment().add(step)
{
    chained: twelve.value(),
    original: zero.value(),
    branch_a: zero.increment().value(),
    branch_b: zero.add(-5).value(),
    history: twelve.history(),
}
