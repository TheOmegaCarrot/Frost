# An event dispatcher object: `on` returns a new dispatcher with a handler
# appended for an event name, and `emit` calls that event's handlers in
# registration order, returning their results. Handlers are closures, one
# capturing a prefix given when it was made. Events with no handlers do
# nothing, and the dispatcher made before a registration does not see it.
#= {
#=     result: {
#=         saved: ['logged', 'audited'],
#=         quit: ['bye ada'],
#=         unknown: [],
#=         before: [],
#=     },
#=     printed: ['log: saved doc.txt', 'audit: saved doc.txt', 'bye ada'],
#=     inputs: {user: 'ada', file: 'doc.txt'},
#= }
defn dispatcher(handlers) -> {
    on: fn event, handler -> dispatcher(handlers + {[event]: (handlers[event] or []) + [handler]}),
    emit: fn event, payload -> transform(handlers[event] or [], fn handler -> handler(payload)),
}

defn prefixed(prefix, result) -> fn payload -> {
    print($'${prefix}: saved ${payload}')
    result
}

def empty = dispatcher({})
def ready = (
    empty.on('save', prefixed('log', 'logged'))
    .on('save', prefixed('audit', 'audited'))
    .on('quit', fn name -> {
        print($'bye ${name}')
        $'bye ${name}'
    })
)
{
    saved: ready.emit('save', file),
    quit: ready.emit('quit', user),
    unknown: ready.emit('resize', null),
    before: empty.emit('save', file),
}
