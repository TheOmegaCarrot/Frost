# The persistent binary search tree built from literal keys, which the
# optimizer may build ahead of time: the walks must agree with the tree built
# from runtime keys.
#= {
#=     result: {
#=         in_order: [20, 30, 40, 50, 60, 70, 80],
#=         height: 3,
#=         members: [true, false],
#=     },
#= }
defn insert(tree, key) ->
    if tree == null: {key, left: null, right: null}
    elif key < tree.key: tree + {left: insert(tree.left, key)}
    elif key > tree.key: tree + {right: insert(tree.right, key)}
    else: tree

defn in_order(tree) -> if tree == null: [] else: in_order(tree.left) + [tree.key] + in_order(tree.right)

defn height(tree) -> if tree == null: 0 else: do {
    def l = height(tree.left)
    def r = height(tree.right)
    1 + (if l > r: l else: r)
}

defn contains(tree, key) ->
    if tree == null: false
    elif key == tree.key: true
    elif key < tree.key: contains(tree.left, key)
    else: contains(tree.right, key)

def tree = reduce [50, 30, 70, 20, 40, 60, 80, 30] init: null with insert
{
    in_order: in_order(tree),
    height: height(tree),
    members: [contains(tree, 60), contains(tree, 65)],
}
