# An invoice built with abbreviated lambdas throughout (`$` for one
# argument, `$1` and `$2` for two, `$$` for all of them) and rendered with
# format strings: an escaped `\${` stays literal, a bare `$` just before an
# interpolation is literal text, interpolations hold arithmetic and conditionals, and
# non-ASCII item names pass through. A `$$` lambda called through `call`
# gathers its arguments back into an Array.
#= {
#=     result: [
#=         'crème x2 @ $3 = $6',
#=         '日本茶 x1 @ $12 = $12',
#=         'pen x10 @ $1 = $10 (bulk)',
#=         'total: $28 for 3 lines; template ${total}',
#=         [2, 1, 10],
#=     ],
#=     inputs: {
#=         lines: [
#=             {name: 'crème', qty: 2, price: 3},
#=             {name: '日本茶', qty: 1, price: 12},
#=             {name: 'pen', qty: 10, price: 1},
#=         ],
#=     },
#= }
def amounts = map(lines, $($.qty * $.price))
def total = reduce(amounts, 0, $($1 + $2))
def rendered = map(lines, $($'${$.name} x${$.qty} @ $${$.price} = $${$.qty * $.price}${if $.qty >= 10: ' (bulk)' else: ''}'))
def gather = $($$)
rendered + [
    $'total: $${total} for ${len(lines)} lines; template \${total}',
    call(gather, map(lines, $($.qty))),
]
