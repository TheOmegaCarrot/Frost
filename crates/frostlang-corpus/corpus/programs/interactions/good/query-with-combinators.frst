# A product query written with the function combinators: `inv` negates a
# predicate, `index` and `dig` read fields (`dig` giving Null for a missing
# link), `curry` fixes a leading argument, `spread` unpacks pairs, `rev_args`
# swaps arguments, `const` makes a fallback, `collect` gathers arguments,
# and `tap` prints a total in passing without changing it.
#= {
#=     result: {
#=         expensive: ['lamp', 'desk'],
#=         colors: ['blue', 'none', 'red', 'none'],
#=         doubled: [6, 80, 16, 240],
#=         total: 171,
#=         areas: [2, 12],
#=         swapped: 9,
#=         defaults: ['fallback', 5, false],
#=         gathered: ['a', 'b'],
#=     },
#=     printed: ['total 171'],
#=     inputs: {
#=         products: [
#=             {name: 'pen', price: 3, tags: {color: 'blue'}},
#=             {name: 'lamp', price: 40, tags: {}},
#=             {name: 'mug', price: 8, tags: {color: 'red'}},
#=             {name: 'desk', price: 120},
#=         ],
#=         pairs: [[1, 2], [3, 4]],
#=         maybes: [null, 5, false],
#=     },
#= }
defn cheap(p) -> p.price < 10
def fallback = const('fallback')

{
    expensive: products @ filter(inv(cheap)) @ map(index('name')),
    colors: map(products, fn p -> dig(p, 'tags', 'color') or 'none'),
    doubled: map(products, curry(fn factor, p -> p.price * factor, 2)),
    total: tap(reduce(products, 0, fn sum, p -> sum + p.price), fn t -> print($'total ${t}')),
    areas: map(pairs, spread(fn w, h -> w * h)),
    swapped: rev_args(fn a, b -> a - b)(1, 10),
    defaults: map(maybes, fn v -> if v == null: fallback() else: v),
    gathered: collect('a', 'b'),
}
