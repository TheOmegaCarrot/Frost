# A module-style program: private helpers compute values, and the top level
# exports results of every non-function type, including Null and a Map
# with keys of every type. Exports are ordinary bindings too, so later
# definitions read earlier exports, and the tail value reads them as well.
#= {
#=     result: 'primes below 20: 8',
#=     exports: {
#=         version: '1.2',
#=         primes: [2, 3, 5, 7, 11, 13, 17, 19],
#=         lookup: {[false]: 'no', [1]: 'one', [1.5]: 'one and a half', one: [1], [x'01']: 'bytes'},
#=         ratio: 0.5,
#=         enabled: false,
#=         missing: null,
#=         signature: x'00ff',
#=         prime_count: 8,
#=     },
#=     inputs: {limit: 20, major: 1, minor: 2},
#= }
def {limit, major, minor} = import('inputs')
defn from_to(low, high) -> if low > high: [] else: [low] + from_to(low + 1, high)
defn sieve(xs) -> match xs {
    [] => [],
    [p, ...rest] => [p] + sieve(filter(rest, fn n -> n % p != 0)),
}

export def version = $'${major}.${minor}'
export def primes = sieve(from_to(2, limit - 1))
export def lookup = {[false]: 'no', [1]: 'one', [1.5]: 'one and a half', one: [1], [x'01']: 'bytes'}
export def ratio = minor / 4.0
export def enabled = len(primes) > limit
export def missing = lookup['absent']
export def signature = x'00' + x'ff'
export def prime_count = len(primes)
$'primes below ${limit}: ${prime_count}'
