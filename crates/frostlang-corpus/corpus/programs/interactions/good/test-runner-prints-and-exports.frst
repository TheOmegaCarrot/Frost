# A tiny test runner: each case names a function, its arguments, and the
# expected result. Cases run through `try_call`, so a raising case fails
# instead of ending the run; the runner prints one line per case in order
# and exports its summary and the names of the failures.
#= {
#=     result: 'ran 5',
#=     exports: {
#=         summary: {passed: 3, failed: 2},
#=         failures: ['halve odd', 'divide by zero'],
#=     },
#=     printed: [
#=         'PASS add',
#=         'PASS halve even',
#=         'FAIL halve odd: got 1',
#=         'FAIL divide by zero: raised',
#=         'PASS concat',
#=     ],
#=     inputs: {zero: 0},
#= }
defn add(a, b) -> a + b
defn halve(n) -> n / 2
defn divide(a, b) -> a / b

def cases = [
    {name: 'add', f: add, args: [2, 3], expected: 5},
    {name: 'halve even', f: halve, args: [8], expected: 4},
    {name: 'halve odd', f: halve, args: [3], expected: 1.5},
    {name: 'divide by zero', f: divide, args: [1, zero], expected: null},
    {name: 'concat', f: add, args: ['ab', 'cd'], expected: 'abcd'},
]

defn run(results, c) -> {
    def outcome = try_call(c.f, c.args)
    def passed = outcome.ok and outcome.value == c.expected
    print(
        if passed: $'PASS ${c.name}'
        elif outcome.ok: $'FAIL ${c.name}: got ${outcome.value}'
        else: $'FAIL ${c.name}: raised'
    )
    results + [{name: c.name, passed}]
}

def results = reduce(cases, [], run)
export def summary = {
    passed: len(filter(results, fn r -> r.passed)),
    failed: len(filter(results, fn r -> not r.passed)),
}
def failed = filter(results, fn r -> not r.passed)
export def failures = map(failed, fn r -> r.name)
$'ran ${len(results)}'
