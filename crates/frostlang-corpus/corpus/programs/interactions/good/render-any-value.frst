# A recursive renderer for any Frost value, dispatching on type constraints
# in `match`: every type has an arm, Maps render their entries in key order
# (Bool, then Int, then Float, then String, then Bytes keys), and nesting of
# empty structures and Null renders exactly.
#= {
#=     result: '{true: [1, 2.5, null, false], -3: "neg", 0.5: {}, "name": "é", "nested": [[], [[null]]], <2 bytes>: [<function>]}',
#=     inputs: {
#=         value: {
#=             name: 'é',
#=             [x'00ff']: [fn -> 1],
#=             [0.5]: {},
#=             nested: [[], [[null]]],
#=             [-3]: 'neg',
#=             [true]: [1, 2.5, null, false],
#=         },
#=     },
#= }
defn join(parts) -> if parts == []: '' else: reduce(parts, fn text, part -> text + ', ' + part)

defn render(v) -> match v {
    null => 'null',
    b is Bool => if b: 'true' else: 'false',
    n is Int => to_string(n),
    f is Float => to_string(f),
    s is String => $'"${s}"',
    b is Bytes => $'<${len(b)} bytes>',
    xs is Array => '[' + join(map(xs, render)) + ']',
    m is Map => '{' + join(reduce(m, [], fn acc, k, item -> acc + [$'${render(k)}: ${render(item)}'])) + '}',
    _ is Function => '<function>',
}

render(value)
