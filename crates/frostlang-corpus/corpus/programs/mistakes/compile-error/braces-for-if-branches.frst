# A classifier whose `if` branches are written in braces is rejected: an
# `if` takes a colon after its condition, and a multi-statement branch is a
# `do` block.
#= {
#=     rejects: ['`if`', 'colon'],
#=     inputs: {xs: [-1, 0, 1]},
#= }
defn sign(n) -> if n > 0 { 1 } elif n < 0 { -1 } else { 0 }
map(xs, sign)
