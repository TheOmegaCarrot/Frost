# A helper written with another language's `let` is rejected: Frost binds
# names with `def`, and the compiler says so.
#= {
#=     rejects: 'no `let`',
#=     inputs: {xs: [1, 2, 3]},
#= }
def {xs} = import('inputs')
defn average(items) -> {
    let total = reduce(items, 0, fn acc, x -> acc + x)
    total / len(items)
}
average(xs)
