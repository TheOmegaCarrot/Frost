# A reduce step that tries to update its state in place is rejected: values
# are immutable, so the step must return a new state, such as `s + {...}`.
#= {
#=     rejects: ['`=`', 'immutable'],
#=     inputs: {xs: [1, 2, 3]},
#= }
def {xs} = import('inputs')
defn step(s, x) -> {
    s.count = s.count + x
    s
}
reduce(xs, {count: 0}, step)
