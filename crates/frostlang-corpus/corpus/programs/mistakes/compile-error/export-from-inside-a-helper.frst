# A helper that tries to export a value it computes is rejected: `export`
# belongs only to top-level definitions, so a program exports results by
# binding them at the top level.
#= {
#=     rejects: ['`export`', 'top level'],
#=     inputs: {xs: [1, 2, 3]},
#= }
def {xs} = import('inputs')
defn summarize(items) -> {
    export def count = len(items)
    count
}
summarize(xs)
