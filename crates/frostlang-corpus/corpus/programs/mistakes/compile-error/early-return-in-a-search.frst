# A linear search that tries to `return` early is rejected: a Frost
# function's value is its last expression, so the search must recurse or
# fold instead.
#= {
#=     rejects: 'no `return`',
#=     inputs: {xs: [4, 8, 15]},
#= }
defn find_index(items, target, i) -> {
    if items[i] == target: return i
    find_index(items, target, i + 1)
}
find_index(xs, 8, 0)
