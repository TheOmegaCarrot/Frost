# A type checker for a small expression language, written as one `match`
# over node shapes. Literals take their Frost type, operators check their
# operands, and a mismatch raises a structured error that the caller catches
# and reports. Subtle: a 3-element `==` node first meets the arithmetic arm,
# whose guard rejects it, and falls through; and an unbound name reports a
# Null `found`, which the error pattern still matches, since a key holding
# Null is present.
#= {
#=     result: [
#=         'Int',
#=         'String',
#=         'Int',
#=         '+: wanted Int, found Bool',
#=         'if: wanted Bool, found Int',
#=         'if: wanted Int, found String',
#=         '-: wanted Int, found Bool',
#=         'z: wanted a bound name, found null',
#=     ],
#=     inputs: {
#=         programs: [
#=             ['+', 1, ['*', 2, 3]],
#=             ['if', ['==', 1, 2], 'yes', 'no'],
#=             ['let', 'x', 5, ['if', ['==', {var: 'x'}, 5], {var: 'x'}, 0]],
#=             ['+', 1, true],
#=             ['if', 1, 2, 3],
#=             ['if', true, 2, 'two'],
#=             ['let', 'y', true, ['-', {var: 'y'}, 1]],
#=             ['+', {var: 'z'}, 1],
#=         ],
#=     },
#= }
defn expect(wanted, found, where) -> if wanted == found: found
    else: error({where, wanted, found})

defn check(env, node) -> match node {
    _ is Int => 'Int',
    _ is Bool => 'Bool',
    _ is String => 'String',
    {var: name} => env[name] or error({where: name, wanted: 'a bound name', found: null}),
    [op, a, b] if: op == '+' or op == '-' or op == '*' => do {
        expect('Int', check(env, a), op)
        expect('Int', check(env, b), op)
    },
    ['==', a, b] => do {
        expect(check(env, a), check(env, b), '==')
        'Bool'
    },
    ['if', c, t, e] => do {
        expect('Bool', check(env, c), 'if')
        expect(check(env, t), check(env, e), 'if')
    },
    ['let', name, value, body] => check(env + {[name]: check(env, value)}, body),
}

defn report(node) -> match try_call(check, [{}, node]) {
    {ok: true, value} => value,
    {error: {where, wanted, found}} => $'${where}: wanted ${wanted}, found ${found}',
}

map programs with report
