# An evaluator for a lambda language represents each interpreted function as
# a Frost closure over the interpreter's environment. The third program
# checks that scoping is lexical: `f` was made where `x` is 1, so calling it
# under an inner `x` of 100 still yields 1.
#   first:  ((fn x -> fn y -> x + y)(3))(4)
#   second: twice(fn n -> n * 3)(2), with twice = fn f -> fn x -> f(f(x))
#   third:  (fn x -> (fn f -> (fn x -> f(0))(100))(fn y -> x))(1)
#= {
#=     result: [7, 18, 1],
#=     inputs: {
#=         first: {app: [
#=             {app: [{lam: 'x', body: {lam: 'y', body: {add: [{var: 'x'}, {var: 'y'}]}}}, {num: 3}]},
#=             {num: 4},
#=         ]},
#=         second: {app: [
#=             {app: [
#=                 {lam: 'f', body: {lam: 'x', body: {app: [{var: 'f'}, {app: [{var: 'f'}, {var: 'x'}]}]}}},
#=                 {lam: 'n', body: {mul: [{var: 'n'}, {num: 3}]}},
#=             ]},
#=             {num: 2},
#=         ]},
#=         third: {app: [
#=             {lam: 'x', body: {app: [
#=                 {lam: 'f', body: {app: [{lam: 'x', body: {app: [{var: 'f'}, {num: 0}]}}, {num: 100}]}},
#=                 {lam: 'y', body: {var: 'x'}},
#=             ]}},
#=             {num: 1},
#=         ]},
#=     },
#= }
def {first, second, third} = import('inputs')
defn evaluate(node, env) -> match node {
    {num} => num,
    {var} => env[var],
    {add: [l, r]} => evaluate(l, env) + evaluate(r, env),
    {mul: [l, r]} => evaluate(l, env) * evaluate(r, env),
    {lam: param, body} => fn argument -> evaluate(body, env + {[param]: argument}),
    {app: [callee, argument]} => evaluate(callee, env)(evaluate(argument, env)),
}

[evaluate(first, {}), evaluate(second, {}), evaluate(third, {})]
