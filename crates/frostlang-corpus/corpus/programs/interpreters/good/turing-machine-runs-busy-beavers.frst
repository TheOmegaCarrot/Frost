# A Turing machine simulator: the tape is a Map from Int positions to
# symbols, so it grows in both directions and a blank cell is a missing key
# read as Null and defaulted with `or`. Subtle: a negative position is a Map
# key, not an index from the end, and the tape's cells come back in ascending
# key order. The machines are the two- and three-state busy beavers.
#= {
#=     result: [
#=         {steps: 6, ones: 4, cells: [-2, -1, 0, 1]},
#=         {steps: 14, ones: 6, cells: [-1, 0, 1, 2, 3, 4]},
#=     ],
#=     inputs: {
#=         two_state: {
#=             A: {[0]: [1, 1, 'B'], [1]: [1, -1, 'B']},
#=             B: {[0]: [1, -1, 'A'], [1]: [1, 1, 'H']},
#=         },
#=         three_state: {
#=             A: {[0]: [1, 1, 'B'], [1]: [1, 1, 'H']},
#=             B: {[0]: [0, 1, 'C'], [1]: [1, 1, 'B']},
#=             C: {[0]: [1, -1, 'C'], [1]: [1, -1, 'A']},
#=         },
#=     },
#= }
defn run(rules, state, tape, head, steps) -> if state == 'H': {steps, tape} else: do {
    def [write, move, next] = rules[state][tape[head] or 0]
    run(rules, next, tape + {[head]: write}, head + move, steps + 1)
}

defn summarize(rules) -> {
    def {steps, tape} = run(rules, 'A', {}, 0, 0)
    {
        steps,
        ones: reduce(tape, 0, fn total, cell, symbol -> total + symbol),
        cells: reduce(tape, [], fn found, cell, symbol -> found + [cell]),
    }
}

[summarize(two_state), summarize(three_state)]
