# A coin-operated turnstile driven by a fold over its events: the state Map
# carries the current state and counters, and each transition is a match on
# the [state, event] pair that merges in only what changes.
#= {
#=     result: [
#=         {state: 'locked', passed: 2, blocked: 1, refunds: 1},
#=         {state: 'locked', passed: 0, blocked: 0, refunds: 0},
#=         {state: 'unlocked', passed: 0, blocked: 3, refunds: 0},
#=     ],
#=     inputs: {
#=         busy: ['coin', 'push', 'push', 'coin', 'coin', 'push'],
#=         idle: [],
#=         stubborn: ['push', 'push', 'push', 'coin'],
#=     },
#= }
defn transition(s, event) -> match [s.state, event] {
    ['locked', 'coin'] => s + {state: 'unlocked'},
    ['locked', 'push'] => s + {blocked: s.blocked + 1},
    ['unlocked', 'push'] => s + {state: 'locked', passed: s.passed + 1},
    ['unlocked', 'coin'] => s + {refunds: s.refunds + 1},
}

defn run(events) -> reduce events init: {state: 'locked', passed: 0, blocked: 0, refunds: 0} with transition

[run(busy), run(idle), run(stubborn)]
