# A linear congruential generator modulo 2^31, run for five thousand steps by
# tail recursion. The modulus is applied at every step, so the multiply never
# leaves the Int range. The last digit of each value is tallied into an
# Int-keyed Map.
#= {
#=     result: {
#=         first: [1250496027, 1116302264, 1000676753],
#=         last: 967461122,
#=         tally: {
#=             [0]: 525, [1]: 522, [2]: 499, [3]: 536, [4]: 466,
#=             [5]: 439, [6]: 515, [7]: 506, [8]: 495, [9]: 497,
#=         },
#=     },
#=     inputs: {seed: 42, steps: 5000},
#= }
def {seed, steps} = import('inputs')
defn next(x) -> (x * 1103515245 + 12345) % 2147483648

defn first_values(x, n) -> if n == 0: [] else: do {
    def value = next(x)
    [value] + first_values(value, n - 1)
}

defn run(x, n, tally) -> if n == 0: {last: x, tally} else: do {
    def value = next(x)
    def digit = value % 10
    run(value, n - 1, tally + {[digit]: (tally[digit] or 0) + 1})
}

run(seed, steps, {}) + {first: first_values(seed, 3)}
