# Word break by dynamic programming: a fold over end positions records, for
# each prefix of the phrase, one way to split it into dictionary words, or
# Null when there is none. The table is a Map from position to the words so
# far; the answer is the entry for the whole phrase. Each prefix keeps the
# split whose last word starts earliest, so `pineapple` beats `pine apple`.
# Subtle: an empty prefix splits into no words, an empty Array, which is
# not the Null of an unsplittable prefix; so the empty phrase yields `[]`.
#= {
#=     result: [['pineapple', 'pen', 'apple'], null, [], ['a', 'aa']],
#=     inputs: {
#=         dictionary: {apple: true, pen: true, pine: true, pineapple: true, a: true, aa: true},
#=         phrases: ['pineapplepenapple', 'applepie', '', 'aaa'],
#=     },
#= }
defn segment(phrase) -> {
    def n = len(phrase)
    def table = reduce range(1, n + 1) init: {[0]: []} with fn found, stop ->
        found + {[stop]: reduce range(0, stop) init: null with fn best, start -> do {
            def word = slice(phrase, start, stop)
            if best == null and found[start] != null and has(dictionary, word):
                found[start] + [word]
            else: best
        }}
    table[n]
}
map phrases with segment
