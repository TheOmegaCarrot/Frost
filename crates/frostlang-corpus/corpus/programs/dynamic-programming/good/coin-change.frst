# Two coin-change tables built by folds. Counting the ways to make an amount
# folds each coin over the table, reading the new row's earlier cells. The
# fewest-coins table uses Null for an amount that cannot be made, so Null
# flows through as a value: it is compared with `==`, never added to.
# Subtle: for [1, 3, 4] and 6 the answer is 2 (3 + 3), where taking the
# largest coin first would need 3.
#= {
#=     result: {
#=         ways: [11, 1, 0, 0, 1],
#=         fewest: [2, null, 0, 3, null],
#=     },
#=     inputs: {
#=         ways_cases: [[[1, 2, 5], 11], [[1, 2, 5], 0], [[2], 3], [[], 4], [[], 0]],
#=         fewest_cases: [[[1, 3, 4], 6], [[5], 3], [[2], 0], [[3, 7], 13], [[3, 7], 11]],
#=     },
#= }
defn upto(n) -> if n == 0: [] else: upto(n - 1) + [n - 1]

defn ways(coins, target) -> {
    def amounts = upto(target + 1)
    def initial = transform(amounts, fn a -> if a == 0: 1 else: 0)
    def table = fold(coins, initial, fn prev, coin -> fold(amounts, [], fn row, a ->
        row + [prev[a] + (if a >= coin: row[a - coin] else: 0)]
    ))
    table[target]
}

defn fewest(coins, target) -> {
    defn cell(row, a) -> if a == 0: 0 else: fold(coins, null, fn best, coin -> {
        def sub = if coin <= a: row[a - coin] else: null
        if sub == null: best
        elif best == null or sub + 1 < best: sub + 1
        else: best
    })
    def table = fold(upto(target + 1), [], fn row, a -> row + [cell(row, a)])
    table[target]
}

{
    ways: transform(ways_cases, fn c -> ways(c[0], c[1])),
    fewest: transform(fewest_cases, fn c -> fewest(c[0], c[1])),
}
