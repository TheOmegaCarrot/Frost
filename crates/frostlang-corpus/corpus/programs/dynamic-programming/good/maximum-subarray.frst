# Kadane's maximum subarray sum: an Array pattern takes the first element to
# seed the state Map, and a fold over the rest tracks the best sum ending
# here and the best overall. An all-negative input yields its largest
# element, Ints and Floats mix freely, and the empty input yields Null.
#= {
#=     result: [6, -1, 5, 2.5, null],
#=     inputs: {
#=         runs: [
#=             [-2, 1, -3, 4, -1, 2, 1, -5, 4],
#=             [-3, -1, -2],
#=             [5],
#=             [0.5, -1, 2.5],
#=             [],
#=         ],
#=     },
#= }
defn larger(a, b) -> if a > b: a else: b

defn best_sum(xs) -> match xs {
    [] => null,
    [first, ...rest] => fold(rest, {here: first, best: first}, fn s, x -> {
        def here = larger(x, s.here + x)
        {here, best: larger(s.best, here)}
    }).best,
}

transform(runs, best_sum)
