# The length of a longest strictly increasing subsequence, quadratic DP by
# folds: for each element, a fold over the earlier elements and their lengths
# (paired by index) finds the best one it can extend. Equal elements do not
# extend each other, and Strings compare by code point.
#= {
#=     result: [4, 1, 0, 1, 3],
#=     inputs: {
#=         runs: [
#=             [10, 9, 2, 5, 3, 7, 101, 18],
#=             [7, 7, 7],
#=             [],
#=             [5, 4, 3, 2, 1],
#=             ['b', 'a', 'c', 'é', 'd'],
#=         ],
#=     },
#= }
defn upto(n) -> if n == 0: [] else: upto(n - 1) + [n - 1]

defn larger(a, b) -> if a > b: a else: b

defn longest(xs) -> {
    def lengths = fold(xs, [], fn found, x -> {
        def extendable = fold(upto(len(found)), 0, fn best, j ->
            if xs[j] < x: larger(best, found[j]) else: best
        )
        found + [extendable + 1]
    })
    fold(lengths, 0, larger)
}

transform(runs, longest)
