# Pascal's triangle, each row folded from the previous one by pairing
# neighbors. Row 66's middle entry, C(66, 33), still fits in an Int; row 67's,
# C(67, 33), does not, and the additions wrap in two's complement rather than
# raising, giving its value modulo 2^64 as a signed Int.
#= {
#=     result: {
#=         small: [[1], [1, 1], [1, 2, 1], [1, 3, 3, 1], [1, 4, 6, 4, 1], [1, 5, 10, 10, 5, 1]],
#=         fits: 7219428434016265740,
#=         wraps: -4220223336089263246,
#=     },
#=     inputs: {small_count: 6, last: 67},
#= }
defn next_row(row) -> {
    def middle = fold(row, {previous: null, sums: []}, fn s, x ->
        if s.previous == null: {previous: x, sums: []}
        else: {previous: x, sums: s.sums + [s.previous + x]}
    )
    [1] + middle.sums + [1]
}

defn rows(n, row, acc) -> if n == 0: acc else: rows(n - 1, next_row(row), acc + [row])

def all = rows(last + 1, [1], [])
{
    small: rows(small_count, [1], []),
    fits: all[66][33],
    wraps: all[67][33],
}
