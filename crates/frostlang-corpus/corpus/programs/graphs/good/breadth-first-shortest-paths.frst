# A breadth-first search, level by level: each level folds over the frontier
# with a state Map of distances, parents, and the next frontier, so the first
# discovery of a node fixes its distance. The shortest path is then rebuilt
# by walking parents back from the goal. An isolated node gets no distance,
# and the start's own path is just itself.
#= {
#=     result: {
#=         distances: {a: 0, b: 1, c: 1, d: 2, e: 2, f: 3},
#=         path: ['a', 'b', 'd', 'f'],
#=         trivial: ['a'],
#=         unreachable: null,
#=     },
#=     inputs: {
#=         graph: {
#=             a: ['b', 'c'],
#=             b: ['a', 'd'],
#=             c: ['a', 'd', 'e'],
#=             d: ['b', 'c', 'f'],
#=             e: ['c', 'f'],
#=             f: ['d', 'e'],
#=             g: [],
#=         },
#=     },
#= }
defn discover(state, node) -> reduce(graph[node], state, fn acc, n -> {
    def {dist, parent, next} = acc
    if has(dist, n): acc
    else: {dist: dist + {[n]: dist[node] + 1}, parent: parent + {[n]: node}, next: next + [n]}
})

defn search(frontier, dist, parent) -> if frontier == []: {dist, parent} else: do {
    def level = reduce(frontier, {dist, parent, next: []}, discover)
    search(level.next, level.dist, level.parent)
}

defn path_to(parent, node) -> if node == null: [] else: path_to(parent, parent[node]) + [node]

def {dist, parent} = search(['a'], {a: 0}, {})
{
    distances: dist,
    path: path_to(parent, 'f'),
    trivial: path_to(parent, 'a'),
    unreachable: dist['g'],
}
