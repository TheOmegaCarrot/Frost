# A topological sort by depth-first post-order: every dependency is placed
# before what depends on it. Roots are taken in the Map's ascending key
# order, and the state threads through folds as a Map holding the finished
# set, the in-progress path (to detect cycles), and the order so far.
#= {
#=     result: [['core', 'lib', 'log', 'app', 'test'], [], ['solo']],
#=     inputs: {
#=         modules: {
#=             test: ['app'],
#=             app: ['lib', 'log'],
#=             lib: ['core'],
#=             log: ['core'],
#=             core: [],
#=         },
#=     },
#= }
defn order(deps) -> {
    defn visit(state, name) ->
        if has(state.done, name): state
        elif has(state.path, name): error($'cycle at ${name}')
        else: do {
            def entered = state + {path: state.path + {[name]: true}}
            def after = reduce(deps[name], entered, visit)
            after + {
                done: after.done + {[name]: true},
                path: state.path,
                order: after.order + [name],
            }
        }
    def start = {done: {}, path: {}, order: []}
    reduce(deps, start, fn state, name, uses -> visit(state, name)).order
}

[order(modules), order({}), order({solo: []})]
