# Union-find over an immutable parent Map. `find` returns the root together
# with a compressed parent Map, which the caller threads onward: path
# compression without mutation. Folding the edges joins the sets, and a
# final fold groups each node under its root. Node 5 is found again after
# its root moved, so its parent is compressed to the new root, while node 2,
# never found again, still points at its old parent.
#= {
#=     result: [[[1, 2, 3, 4, 5], [6], [7]], [1, 3], true, false],
#=     inputs: {
#=         nodes: [1, 2, 3, 4, 5, 6, 7],
#=         edges: [[1, 2], [3, 4], [2, 5], [4, 1], [5, 1]],
#=     },
#= }
def {nodes, edges} = import('inputs')
defn find(parents, x) -> {
    def parent = parents[x]
    if parent == x: [x, parents]
    else: do {
        def [root, compressed] = find(parents, parent)
        [root, compressed + {[x]: root}]
    }
}
defn union(parents, edge) -> {
    def [a, b] = edge
    def [root_a, after_a] = find(parents, a)
    def [root_b, after_b] = find(after_a, b)
    if root_a == root_b: after_b else: after_b + {[root_b]: root_a}
}
defn same_set(parents, a, b) -> find(parents, a)[0] == find(parents, b)[0]

def singletons = reduce(nodes, {}, fn acc, n -> acc + {[n]: n})
def joined = reduce(edges, singletons, union)
def groups = reduce(nodes, {}, fn acc, n -> do {
    def root = find(joined, n)[0]
    acc + {[root]: (acc[root] or []) + [n]}
})
[values(groups), [joined[2], joined[5]], same_set(joined, 5, 2), same_set(joined, 4, 6)]
