# Two functions can recurse into each other when one is defined inside the
# other: `odd` exists only inside `even`, and calls back out to it.
#= {result: [true, false, true]}
def even = fn even(k) -> if k == 0: true else: (fn odd(m) -> if m == 0: false else: even(m - 1))(k - 1)
[even(10), even(7), even(0)]
