# The Frost-written combinators work over functions and arguments known only
# at runtime.
#= {
#=     result: [[1, 2, 3], 30, ['a', 'b'], 'c'],
#=     inputs: {f: fn a, b, c -> [a, b, c], one: 1, x: 2, k: 'c'},
#= }
[
    curry(f, one)(2, 3),
    compose(fn v -> v + 1, fn v -> v * 10)(x),
    collect('a', 'b'),
    const(k)(),
]
