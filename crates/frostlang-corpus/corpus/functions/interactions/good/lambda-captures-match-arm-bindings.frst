# A lambda made in a match arm captures that arm's bindings, which outlive
# the match through it.
#= {result: [3, 'b', [2, [3]]], inputs: {v: [1, 2], m: {k: 'b'}, w: [1, 2, 3]}}
def from_array = match v {
    [a, b] => fn -> a + b,
}
def from_map = match m {
    {k} => fn -> k,
}
def from_rest = match w {
    [_, second, ...rest] => fn -> [second, rest],
}
[from_array(), from_map(), from_rest()]
