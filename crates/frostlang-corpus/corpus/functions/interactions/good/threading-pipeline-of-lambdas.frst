# A multiline `@` pipeline threads a value through lambdas and globals,
# each receiving the previous result as its first argument.
#= {result: [20, 40], inputs: {xs: [1, 2, 3, 4]}}
(
    xs
    @ filter(fn v -> v % 2 == 0)
    @ map(fn v -> v * 10)
    @ (fn arr, factor -> map(arr, fn v -> v * factor))(1)
)
