# Int arithmetic in a function body wraps on overflow, in both directions,
# with arguments known only at runtime.
#= {
#=     result: [-9223372036854775808, 9223372036854775807, -9223372036854775808],
#=     inputs: {max: 9223372036854775807, min: -9223372036854775808, big: 4611686018427387904},
#= }
def inc = fn x -> x + 1
def dec = fn x -> x - 1
def double = fn x -> x * 2
[inc(max), dec(min), double(big)]
