# `map`, `filter`, and `reduce` expressions take lambdas that capture the
# enclosing function's parameters.
#= {result: [[3, 6, 9], [2, 3], 16], inputs: {k: 3, lim: 1, start: 10}}
def scale = fn xs, by -> map xs with fn v -> v * by
def above = fn xs, floor -> filter xs with fn v -> v > floor
def total = fn xs, first -> reduce xs init: first with fn acc, v -> acc + v
[scale([1, 2, 3], k), above([1, 2, 3], lim), total([1, 2, 3], start)]
