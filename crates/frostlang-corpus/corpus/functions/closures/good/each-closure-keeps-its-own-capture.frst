# Closures made by separate calls each keep their own captured value; making
# a later one does not disturb an earlier one.
#= {result: [10, 20, 15]}
def make = fn p -> fn -> p
def f1 = make(10)
def f2 = make(20)
def make_adder = fn k -> fn x -> x + k
def add5 = make_adder(5)
make_adder(100)
[f1(), f2(), add5(10)]
