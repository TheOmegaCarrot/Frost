# A callee building a new value from its argument leaves the caller's value
# unchanged, for Arrays and Maps alike.
#= {
#=     result: [[1, 2, 3, 4], [1, 2, 3], {a: 1, b: 2}, {a: 1}],
#=     inputs: {xs: [1, 2, 3], m: {a: 1}},
#= }
def {xs, m} = import('inputs')
def append = fn arr -> arr + [4]
def add_b = fn table -> table + {b: 2}
[append(xs), xs, add_b(m), m]
