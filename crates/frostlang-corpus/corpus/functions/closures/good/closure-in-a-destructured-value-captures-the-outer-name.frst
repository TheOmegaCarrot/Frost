# A lambda in the value of a destructuring `def` captures the outer binding of
# a name the pattern is about to bind, since the value is evaluated before
# the pattern binds anything.
#= {result: [2, 1], inputs: {one: 1, two: 2}}
def x = one
def pair = do {
    def [x, read] = [two, fn -> x]
    [x, read()]
}
pair
