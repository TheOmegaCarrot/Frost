# Captures of known constants (which the optimizer may build in) mix with
# captures of runtime values without disturbing each other's order.
#= {result: [20, 1, 10, 2, 30, 1], inputs: {one: 1, two: 2}}
def k1 = 10
def k2 = 20
def k3 = 30
def make = fn a, b -> fn -> [k2, a, k1, b, k3, a]
make(one, two)()
