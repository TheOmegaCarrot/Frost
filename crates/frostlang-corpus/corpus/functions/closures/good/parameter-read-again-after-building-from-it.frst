# A parameter read several times keeps its value across reads, even when
# earlier reads build new values from it and the argument was built fresh for
# the call. Subtle: the VM may reuse a uniquely owned value in place, which
# must never be observable.
#= {
#=     result: [[1, 2, 3], [1, 2, 4], [1, 2], {a: 1, b: 2}, {a: 1}, '1y', '1'],
#=     inputs: {one: 1},
#= }
def {one} = import('inputs')
def arrays = fn a -> [a + [3], a + [4], a]
def maps = fn t -> [t + {b: 2}, t]
def strings = fn t -> [t + 'y', t]
arrays([one, 2]) + maps({a: one}) + strings(to_string(one))
