# An argument is a whole expression, so a trailing `@` threads into that
# argument, not into the call's result: `map(xs, inc @ hundredfold())` maps
# with `hundredfold(inc)`. Parentheses thread the whole call instead. Subtle
# because `map(xs, inc) @ len()` reads alike but threads the call's result.
#= {result: [[200, 300], 2], inputs: {xs: [1, 2]}}
defn inc(x) -> x + 1
defn hundredfold(f) -> fn x -> f(x) * 100
[map(xs, inc @ hundredfold()), map(xs, inc) @ len()]
