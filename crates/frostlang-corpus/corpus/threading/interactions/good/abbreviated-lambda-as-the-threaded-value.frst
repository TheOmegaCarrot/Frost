# An abbreviated lambda can be the threaded value, as the function argument
# of a call that takes the function first.
#= {result: [6, [3, 4]], inputs: {xs: [2, 3]}}
def {xs} = import('inputs')
defn apply_to(f, v) -> f(v)
defn map_over(f, ys) -> map(ys, f)
[$($ * 2) @ apply_to(3), $($ + 1) @ map_over(xs)]
