# A runtime value of any type can be threaded.
#= {
#=     result: ['Null', 'Int', 'Float', 'Bool', 'String', 'Bytes', 'Array', 'Map', 'Function'],
#=     inputs: {values: [null, 1, 1.5, true, 's', x'00', [], {}, fn x -> x]},
#= }
[
    values[0] @ type(),
    values[1] @ type(),
    values[2] @ type(),
    values[3] @ type(),
    values[4] @ type(),
    values[5] @ type(),
    values[6] @ type(),
    values[7] @ type(),
    values[8] @ type(),
]
