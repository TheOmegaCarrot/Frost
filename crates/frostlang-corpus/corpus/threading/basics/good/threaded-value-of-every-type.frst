# A value of any type can be threaded.
#= {
#=     result: ['Null', 'Int', 'Float', 'Bool', 'String', 'Bytes', 'Array', 'Map', 'Function'],
#=     inputs: {f: fn x -> x},
#= }
def {f} = import('inputs')
[
    null @ type(),
    1 @ type(),
    1.5 @ type(),
    true @ type(),
    's' @ type(),
    x'00' @ type(),
    [] @ type(),
    {} @ type(),
    f @ type(),
]
