# One chain may mix callees of every kind: a global, a local lambda, a Map
# member, an Array element, and a parenthesized lambda.
#= {result: 15, inputs: {n: 2}}
defn inc(x) -> x + 1
def ops = {double: fn x -> x * 2}
def fns = [fn x -> x - 1]
n @ plus(1) @ inc() @ ops.double() @ fns[0]() @ (fn x -> x * 2 + 1)()
