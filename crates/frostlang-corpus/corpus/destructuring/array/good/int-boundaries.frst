# The extreme Int values destructure unchanged, and arithmetic on a bound
# element stays exact.
#= {
#=     result: [9223372036854775807, -9223372036854775808, 9223372036854775806],
#=     inputs: {xs: [9223372036854775807, -9223372036854775808]},
#= }
def {xs} = import('inputs')
def [max, min] = xs
[max, min, max - 1]
