# A mismatch the optimizer can see ahead of time is not a compile error: a def
# that would raise, in a function never called or a branch never taken, never
# raises.
#= {result: 'fine'}
defn never() -> {
    def [a] = [1, 2]
    a
}
def flag = false
if flag: do {
    def {missing} = {present: 1}
    missing
}
else: 'fine'
