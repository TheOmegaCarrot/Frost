# A `reduce ... with` step destructures both the accumulator and the element.
#= {result: {sum: 9, max: 5}, inputs: {points: [{v: 3}, {v: 5}, {v: 1}]}}
reduce points init: {sum: 0, max: 0} with fn acc, point -> {
    def {sum, max} = acc
    def {v} = point
    {sum: sum + v, max: if v > max: v else: max}
}
