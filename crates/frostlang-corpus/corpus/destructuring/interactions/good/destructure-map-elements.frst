# A `map` lambda destructures Map elements, constants or not.
#= {
#=     result: [['ada', 'bo'], ['cy']],
#=     inputs: {people: [{name: 'ada', age: 36}, {name: 'bo', age: 2}]},
#= }
def {people} = import('inputs')
def from_input = map(people, fn person -> {
    def {name} = person
    name
})
def from_literal = map([{name: 'cy'}], fn person -> {
    def {name} = person
    name
})
[from_input, from_literal]
