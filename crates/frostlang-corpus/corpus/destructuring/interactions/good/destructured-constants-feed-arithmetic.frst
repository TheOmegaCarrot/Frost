# Names bound from a literal feed later arithmetic, which must agree with the
# same arithmetic over runtime values.
#= {result: [42, 42, 9223372036854775807], inputs: {pair: [40, 2]}}
def {pair} = import('inputs')
def [a, b] = [40, 2]
def [c, d] = pair
def [big] = [9223372036854775806]
[a + b, c + d, big + 1]
