# The same pattern binds the same parts in a def and in a `match` arm: the two
# share one pattern grammar.
#= {
#=     result: [true, [1, 'x', [3], {k: 'x'}]],
#=     inputs: {v: [1, {k: 'x'}, 3]},
#= }
def {v} = import('inputs')
def [a, {k} as m, ...r] = v
def from_def = [a, k, r, m]
def from_match = match v {
    [a, {k} as m, ...r] => [a, k, r, m],
}
[from_def == from_match, from_def]
