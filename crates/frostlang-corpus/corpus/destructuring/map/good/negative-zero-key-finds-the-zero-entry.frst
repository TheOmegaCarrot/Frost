# A computed key looks up by `==`, under which `-0.0` equals `0.0`: a pattern
# keyed by either zero finds an entry made with the other, so both keys of one
# pattern bind the same entry, folded and at runtime.
#= {
#=     result: ['zero', 'zero', 'neg', 'neg'],
#=     inputs: {m: {[-0.0]: 'neg'}, z: 0.0},
#= }
def {[-0.0]: a, [0.0]: b} = {[0.0]: 'zero'}
def {[z]: c, [-0.0]: d} = m
[a, b, c, d]
