# A literal part compares with `==`, under which negative zero equals zero, so
# `0.0` matches `-0.0` and the reverse, folded and at runtime.
#= {result: [1, 2, 3, 4], inputs: {xs: [3, -0.0], ys: [4, 0.0]}}
def [a, 0.0] = [1, -0.0]
def [b, -0.0] = [2, 0.0]
def [c, 0.0] = xs
def [d, -0.0] = ys
[a, b, c, d]
