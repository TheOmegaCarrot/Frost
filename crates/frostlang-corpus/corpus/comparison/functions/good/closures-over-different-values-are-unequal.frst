# Closures made by one lambda over different captured values behave
# differently, so they are unequal, while each equals itself.
#= {result: [false, true], inputs: {one: 1, two: 2}}
def adder = fn n -> fn x -> x + n
def add_one = adder(one)
def add_two = adder(two)
[
    add_one == add_two,
    add_one == add_one,
]
