# An `if` branch extends as far as it can, so a comparison after `else:`
# belongs to the branch: `if c: 1 else: 2 == 2` is
# `if c: 1 else: (2 == 2)`. An `if` may also be a comparison's right operand.
#= {result: [true, 1, true], inputs: {yes: true, no: false}}
[
    if no: 1 else: 2 == 2,
    if yes: 1 else: 2 == 2,
    1 == if yes: 1 else: 2,
]
