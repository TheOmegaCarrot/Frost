# Int arithmetic overflow raises instead of wrapping, so one past the greatest
# Int is an error rather than the least Int. The operands are known only at
# runtime.
#= {
#=     raises: ['Int overflow', '9223372036854775807 + 1'],
#=     inputs: {max: 9223372036854775807, one: 1},
#= }
def {max, one} = import('inputs')
max + one < 0
