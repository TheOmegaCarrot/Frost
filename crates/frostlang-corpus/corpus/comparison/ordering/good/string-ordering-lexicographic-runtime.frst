# Lexicographic String ordering on text known only at runtime.
#= {
#=     result: [true, true, false, true, true],
#=     inputs: {abc: 'abc', ab: 'ab', empty: '', b: 'b'},
#= }
def {abc, ab, empty, b} = import('inputs')
[
    abc < 'abd',
    ab < abc,
    abc < ab,
    empty < ab,
    b > abc,
]
