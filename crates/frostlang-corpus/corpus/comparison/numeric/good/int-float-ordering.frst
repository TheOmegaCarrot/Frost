# Unlike `==`, the ordering operators compare an Int with a Float by value, in
# either operand order. A Float's fraction breaks a tie with its whole part.
#= {result: [true, false, true, true, true, true, true, true]}
[
    1 < 2.5,
    3 < 2.5,
    2.5 < 3,
    3 < 3.5,
    -3 < -2.5,
    -3 > -3.5,
    -1 < -0.5,
    0 > -0.5,
]
