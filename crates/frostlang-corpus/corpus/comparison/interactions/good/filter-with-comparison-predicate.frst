# `filter` with a lambda or an abbreviated lambda keeps the elements a comparison holds
# for, with Int and Float elements compared by value.
#= {
#=     result: [[3, 4.5, 10], [3, 4.5, 10], {b: 5}],
#=     inputs: {xs: [1, 3, 2.5, 4.5, 10], m: {a: 1, b: 5}},
#= }
[
    xs @ filter(fn x -> x >= 3),
    filter(xs, $($ > 2.5)),
    m @ filter(fn k, v -> v > 1),
]
