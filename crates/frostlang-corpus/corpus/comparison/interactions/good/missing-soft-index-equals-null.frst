# A soft index of a missing key yields Null, which `==` tells apart from a
# key present with a falsy value.
#= {result: [true, false, true, false], inputs: {m: {present: false}, xs: [0]}}
def {m, xs} = import('inputs')
[
    m['absent'] == null,
    m['present'] == null,
    xs[5] == null,
    xs[0] == null,
]
