# A reduce that keeps the greater of its accumulator and each element finds the
# maximum, across mixed Ints and Floats and negative values; ties keep the
# earlier element, so the Int `7` wins over the later Float `7.0`.
#= {
#=     result: [7, 'pear', -1],
#=     inputs: {numbers: [3, -2, 7, 6.5, 7.0], words: ['apple', 'pear', 'fig'], negatives: [-5, -1, -3]},
#= }
def {numbers, words, negatives} = import('inputs')
defn greater(a, b) -> if b > a: b else: a
[
    reduce(numbers, greater),
    words @ reduce(greater),
    reduce(negatives, greater),
]
