# Map equality on Maps known only at runtime, including a Map assembled from
# entries in a different order.
#= {
#=     result: [true, false, true, true],
#=     inputs: {m: {a: 1, b: 2, c: 3}, n: {a: 1, b: 2}, one: 1},
#= }
[
    m == {c: 3, b: 2, a: one},
    m == n,
    n + {c: 3} == m,
    {c: 3} + n == m,
]
