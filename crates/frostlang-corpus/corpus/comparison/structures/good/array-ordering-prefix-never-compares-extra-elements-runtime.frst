# Past the end of the shorter Array only length decides, with Arrays known
# only at runtime: an extra element that could not be ordered is never
# compared.
#= {
#=     result: [true, false, true],
#=     inputs: {short: [1], long: [1, null], empty: [], maps: [{}]},
#= }
def {short, long, empty, maps} = import('inputs')
[
    short < long,
    long <= short,
    empty < maps,
]
