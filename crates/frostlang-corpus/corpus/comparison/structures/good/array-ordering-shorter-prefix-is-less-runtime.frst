# A proper prefix sorts first, with Arrays known only at runtime.
#= {
#=     result: [true, false, true, true],
#=     inputs: {short: [1, 2], long: [1, 2, 3], empty: []},
#= }
def {short, long, empty} = import('inputs')
[
    short < long,
    long < short,
    empty < short,
    empty <= empty,
]
