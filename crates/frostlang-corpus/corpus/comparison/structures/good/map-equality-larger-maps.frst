# Map equality holds for Maps of a few dozen entries built in different ways:
# a literal, a merge of two halves in either order, and a fold adding one
# entry at a time. One extra or differing entry makes them unequal.
#= {result: [true, true, true, false, false], inputs: {keys: ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't']}}
def literal = {
    a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9, j: 10,
    k: 11, l: 12, m: 13, n: 14, o: 15, p: 16, q: 17, r: 18, s: 19, t: 20,
}
def low = {a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9, j: 10}
def high = {k: 11, l: 12, m: 13, n: 14, o: 15, p: 16, q: 17, r: 18, s: 19, t: 20}
def folded = fold(keys, {}, fn acc, k -> acc + {[k]: len(acc) + 1})
[
    low + high == literal,
    high + low == literal,
    folded == literal,
    literal + {u: 21} == literal,
    literal + {t: 0} == literal,
]
