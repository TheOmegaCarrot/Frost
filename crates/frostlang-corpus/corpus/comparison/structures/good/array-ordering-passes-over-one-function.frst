# Ordering passes over element pairs equal by `==`, and one Function equals
# itself, so Arrays sharing a leading Function are ordered by what follows.
# Subtle because a Function is not orderable, and only its identity makes the
# pair equal.
#= {result: [true, false, true], inputs: {one: 1, two: 2}}
def {one, two} = import('inputs')
def handler = fn x -> x
[
    [handler, one] < [handler, two],
    [handler, one] > [handler, two],
    [handler, one] <= [handler, one],
]
