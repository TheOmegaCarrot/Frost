# Array ordering is lexicographic, so an element pair that orders as equal is
# passed over and the next pair decides. Subtle: `1` and `1.0` order as equal
# but are unequal by `==`, so the Arrays order by their second elements while
# remaining unequal.
#= {
#=     result: [false, true, false, true, false],
#=     inputs: {ints: [1, 3], mixed: [1.0, 2]},
#= }
[
    ints < mixed,
    ints > mixed,
    ints <= mixed,
    ints >= mixed,
    ints == mixed,
]
