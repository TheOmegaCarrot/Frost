# Ordering passes over element pairs that are `==` without ordering them, with
# Arrays known only at runtime: the equal Maps are skipped, and the first
# unequal pair, 2 against 3, decides.
#= {
#=     result: false,
#=     inputs: {a: [{k: 1}, 2], b: [{k: 1}, 3]},
#=     known_issue: 'FROST-154',
#= }
a >= b
