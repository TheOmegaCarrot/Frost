# Int arithmetic wraps in two's complement, so a wrapped result equals the Int
# at the other end of the range. The operands are known only at runtime.
#= {
#=     result: [true, true, true],
#=     inputs: {max: 9223372036854775807, min: -9223372036854775808, one: 1},
#= }
[
    max + one == min,
    min - one == max,
    max * 2 == -2,
]
