# Equality never raises, and values of different types are never equal: each
# of these "zero-like" values of eight types equals itself and nothing else.
#= {
#=     result: [
#=         [true, false, false, false, false, false, false, false],
#=         [false, true, false, false, false, false, false, false],
#=         [false, false, true, false, false, false, false, false],
#=         [false, false, false, true, false, false, false, false],
#=         [false, false, false, false, true, false, false, false],
#=         [false, false, false, false, false, true, false, false],
#=         [false, false, false, false, false, false, true, false],
#=         [false, false, false, false, false, false, false, true],
#=     ],
#= }
def values = [null, false, 0, 0.0, '', x'', [], {}]
transform(values, fn a -> transform(values, fn b -> a == b))
