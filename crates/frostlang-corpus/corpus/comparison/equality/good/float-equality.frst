# `==` and `!=` on Floats compare their values; differently written literals
# of one value are equal.
#= {result: [true, false, true, true, true, false, true, true]}
[
    2.5 == 2.5,
    2.5 == 2.6,
    1e3 == 1000.0,
    .5 == 0.5,
    1_000.5 == 1000.5,
    -1.5 == 1.5,
    1.7976931348623157e308 == 1.7976931348623157e308,
    2.5 != 2.6,
]
