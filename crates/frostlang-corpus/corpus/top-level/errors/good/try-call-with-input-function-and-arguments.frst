# `try_call` of a function and arguments only known at runtime, both when the
# function returns and when it raises.
#= {
#=     result: [{ok: true, value: 42}, false, 'from input'],
#=     inputs: {
#=         double: fn x -> x * 2,
#=         fail: fn msg -> error(msg),
#=         args: [21],
#=     },
#= }
def {double, fail, args} = import('inputs')
def failed = try_call(fail, ['from input'])
[try_call(double, args), failed.ok, failed.error]
