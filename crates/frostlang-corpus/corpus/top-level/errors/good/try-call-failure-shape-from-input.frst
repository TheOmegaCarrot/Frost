# The failure shape of `try_call` when the raised value is only known at
# runtime.
#= {
#=     result: {ok: false, error: {code: 7}, trace: ['error', 'raise']},
#=     inputs: {payload: {code: 7}},
#= }
def {payload} = import('inputs')
defn raise(value) -> [error(value)]
try_call(raise, [payload])
