# A destructuring `def` of a runtime value, whose names are never read, still
# checks its pattern and raises when the value does not fit.
#= {
#=     raises: 'expected an Array',
#=     lints: [['unused binding', '`only`']],
#=     inputs: {xs: [1, 2]},
#= }
def {xs} = import('inputs')
def [only] = xs
'unreached'
