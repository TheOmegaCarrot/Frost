# Int overflow wraps in two's complement and never raises, so `try_call`
# reports success with the wrapped value.
#= {
#=     result: [
#=         {ok: true, value: -9223372036854775808},
#=         {ok: true, value: 9223372036854775807},
#=     ],
#= }
[
    try_call(fn -> 9223372036854775807 + 1),
    try_call(fn -> -9223372036854775808 - 1),
]
