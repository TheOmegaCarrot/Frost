# The `map`, `filter`, and `reduce` expressions work inside an interpolation.
#= {result: ['first 2', 'kept 2', 'total 6'], inputs: {xs: [1, 2, 3]}}
[
    $'first ${(map xs with fn x -> x * 2)[0]}',
    $'kept ${len(filter xs with fn x -> x > 1)}',
    $'total ${reduce xs with fn (acc, x) -> acc + x}',
]
