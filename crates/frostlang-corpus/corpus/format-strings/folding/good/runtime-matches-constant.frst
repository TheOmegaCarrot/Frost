# The same format String over a constant and over a runtime value of every
# type gives equal Strings: folding never changes a rendering.
#= {
#=     result: [true, true, true, true, true, true, true, true],
#=     inputs: {values: [null, true, -7, 2.5, 'é', x'00ff', [1, ['a']], {[1]: {b: 2.5}}]},
#= }
def constants = [null, true, -7, 2.5, 'é', x'00ff', [1, ['a']], {[1]: {b: 2.5}}]
[
    $'<${null}>' == $'<${values[0]}>',
    $'<${true}>' == $'<${values[1]}>',
    $'<${-7}>' == $'<${values[2]}>',
    $'<${2.5}>' == $'<${values[3]}>',
    $'<${'é'}>' == $'<${values[4]}>',
    $'<${x'00ff'}>' == $'<${values[5]}>',
    $'<${[1, ['a']]}>' == $'<${values[6]}>',
    $'<${constants[7]}>' == $'<${values[7]}>',
]
