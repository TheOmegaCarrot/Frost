# A Unicode escape accepts the whole scalar range: U+0000, the last scalar
# before the surrogates, the first after them, and U+10FFFF, with up to six
# digits including leading zeros.
#= {result: [true, true, true, true, 'J']}
[
    $'\u{0}' == "\0",
    $'\u{d7ff}' == "\u{D7FF}",
    $'\u{e000}' == "\u{E000}",
    $'\u{10ffff}' == "\u{10FFFF}",
    $'\u{00004a}',
]
