# Format Strings as match arm bodies interpolate the arm's bindings, from Array
# and Map patterns alike.
#= {
#=     result: ['pair 1 and 2', 'named ada, 36', 'int 5'],
#=     inputs: {subjects: [[1, 2], {name: 'ada', age: 36}, 5]},
#= }
def {subjects} = import('inputs')
map(subjects, fn s -> match s {
    [a, b] => $'pair ${a} and ${b}',
    {name, age: years} => $'named ${name}, ${years}',
    n is Int => $'int ${n}',
})
