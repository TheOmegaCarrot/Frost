# Each interpolated value, of every type, renders exactly as `to_string`
# renders it, with literal text joined around it unchanged.
#= {
#=     result: [true, true, true, true, true, true, true, true, true],
#=     inputs: {values: [null, true, 7, 2.5, 'text', x'00ff', [1, 'a'], {k: 'v'}, fn -> 1]},
#= }
map(values, fn v -> $'<${v}>' == '<' + to_string(v) + '>')
