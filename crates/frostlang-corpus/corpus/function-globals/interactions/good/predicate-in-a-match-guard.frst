# Predicates in guards pick an arm; the first guard that holds wins.
#= {result: ['text', 'number', 'other', 'nothing'], inputs: {xs: ['a', 1.5, [1], null]}}
defn describe(v) -> match v {
    x if: is_string(x) => 'text',
    x if: is_numeric(x) => 'number',
    x if: is_nonnull(x) => 'other',
    _ => 'nothing',
}
map(xs, describe)
