# The arguments `curry` and `bcurry` fix are evaluated once, when the
# curried function is made, not again on each of its calls. Subtle once
# currying is inlined: substituting the argument expressions into the call
# would run them on every call.
#= {
#=     result: [[[1, 2], [1, 3]], [[2, 1], [3, 1]]],
#=     printed: ['curry', 'bcurry'],
#= }
def leading = curry(collect, do {
    print('curry')
    1
})
def trailing = bcurry(collect, do {
    print('bcurry')
    1
})
[[leading(2), leading(3)], [trailing(2), trailing(3)]]
