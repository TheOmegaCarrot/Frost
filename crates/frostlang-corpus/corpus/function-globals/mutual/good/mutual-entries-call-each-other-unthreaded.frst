# Entries reach one another through their first argument, here called without
# threading.
#= {result: [true, false, false, true]}
def {even, odd} = mutual({
    even: fn r, n -> if n == 0: true else: r.odd(r, n - 1),
    odd: fn r, n -> if n == 0: false else: r.even(r, n - 1),
})
[even(10), even(7), odd(10), odd(7)]
