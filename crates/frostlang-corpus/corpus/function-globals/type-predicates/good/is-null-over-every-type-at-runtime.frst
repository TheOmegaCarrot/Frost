# `is_null` is true for Null alone, on values known only at run time.
#= {
#=     result: [true, false, false, false, false, false, false, false, false, false],
#=     inputs: {n: null, b: false, i: 0, f: 0.0, s: '', y: x'', a: [], m: {}, g: fn -> null, h: len},
#= }
def {n, b, i, f, s, y, a, m, g, h} = import('inputs')
[
    is_null(n),
    is_null(b),
    is_null(i),
    is_null(f),
    is_null(s),
    is_null(y),
    is_null(a),
    is_null(m),
    is_null(g),
    is_null(h),
]
