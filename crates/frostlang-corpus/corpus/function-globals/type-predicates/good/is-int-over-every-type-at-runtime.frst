# `is_int` is true for Int alone, on values known only at run time.
#= {
#=     result: [false, false, true, false, false, false, false, false, false, false],
#=     inputs: {n: null, b: false, i: 0, f: 0.0, s: '', y: x'', a: [], m: {}, g: fn -> null, h: len},
#= }
def {n, b, i, f, s, y, a, m, g, h} = import('inputs')
[
    is_int(n),
    is_int(b),
    is_int(i),
    is_int(f),
    is_int(s),
    is_int(y),
    is_int(a),
    is_int(m),
    is_int(g),
    is_int(h),
]
