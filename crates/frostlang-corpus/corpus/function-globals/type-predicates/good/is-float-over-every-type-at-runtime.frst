# `is_float` is true for Float alone, on values known only at run time.
#= {
#=     result: [false, false, false, true, false, false, false, false, false, false],
#=     inputs: {n: null, b: false, i: 0, f: 0.0, s: '', y: x'', a: [], m: {}, g: fn -> null, h: len},
#= }
[
    is_float(n),
    is_float(b),
    is_float(i),
    is_float(f),
    is_float(s),
    is_float(y),
    is_float(a),
    is_float(m),
    is_float(g),
    is_float(h),
]
