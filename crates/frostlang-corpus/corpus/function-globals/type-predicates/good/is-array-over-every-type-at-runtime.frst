# `is_array` is true for Array alone, on values known only at run time.
#= {
#=     result: [false, false, false, false, false, false, true, false, false, false],
#=     inputs: {n: null, b: false, i: 0, f: 0.0, s: '', y: x'', a: [], m: {}, g: fn -> null, h: len},
#= }
[
    is_array(n),
    is_array(b),
    is_array(i),
    is_array(f),
    is_array(s),
    is_array(y),
    is_array(a),
    is_array(m),
    is_array(g),
    is_array(h),
]
