# `is_bytes` is true for Bytes alone. A String is not Bytes, even empty.
#= {result: [false, false, false, false, false, true, false, false, false, false]}
[
    is_bytes(null),
    is_bytes(false),
    is_bytes(0),
    is_bytes(0.0),
    is_bytes(''),
    is_bytes(x''),
    is_bytes([]),
    is_bytes({}),
    is_bytes(fn -> null),
    is_bytes(len),
]
