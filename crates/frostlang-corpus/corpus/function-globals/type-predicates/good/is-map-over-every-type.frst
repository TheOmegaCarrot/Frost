# `is_map` is true for Map alone. An Array is not a Map.
#= {result: [false, false, false, false, false, false, false, true, false, false]}
[
    is_map(null),
    is_map(false),
    is_map(0),
    is_map(0.0),
    is_map(''),
    is_map(x''),
    is_map([]),
    is_map({}),
    is_map(fn -> null),
    is_map(len),
]
