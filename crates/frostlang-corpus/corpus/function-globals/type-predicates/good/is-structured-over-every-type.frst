# `is_structured` is true for Array and Map, empty ones included, and
# nothing else.
#= {result: [false, false, false, false, false, false, true, true, false, false]}
[
    is_structured(null),
    is_structured(false),
    is_structured(0),
    is_structured(0.0),
    is_structured(''),
    is_structured(x''),
    is_structured([]),
    is_structured({}),
    is_structured(fn -> null),
    is_structured(len),
]
