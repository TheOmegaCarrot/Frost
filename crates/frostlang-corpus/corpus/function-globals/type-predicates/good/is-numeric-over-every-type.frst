# `is_numeric` is true for Int and Float, and nothing else.
#= {result: [false, false, true, true, false, false, false, false, false, false]}
[
    is_numeric(null),
    is_numeric(false),
    is_numeric(0),
    is_numeric(0.0),
    is_numeric(''),
    is_numeric(x''),
    is_numeric([]),
    is_numeric({}),
    is_numeric(fn -> null),
    is_numeric(len),
]
