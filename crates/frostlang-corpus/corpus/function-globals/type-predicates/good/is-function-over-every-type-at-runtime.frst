# `is_function` is true for Function alone, on values known only at run
# time.
#= {
#=     result: [false, false, false, false, false, false, false, false, true, true],
#=     inputs: {n: null, b: false, i: 0, f: 0.0, s: '', y: x'', a: [], m: {}, g: fn -> null, h: len},
#= }
def {n, b, i, f, s, y, a, m, g, h} = import('inputs')
[
    is_function(n),
    is_function(b),
    is_function(i),
    is_function(f),
    is_function(s),
    is_function(y),
    is_function(a),
    is_function(m),
    is_function(g),
    is_function(h),
]
