# `is_nonnull` is true for every type but Null, on values known only at run
# time.
#= {
#=     result: [false, true, true, true, true, true, true, true, true, true],
#=     inputs: {n: null, b: false, i: 0, f: 0.0, s: '', y: x'', a: [], m: {}, g: fn -> null, h: len},
#= }
[
    is_nonnull(n),
    is_nonnull(b),
    is_nonnull(i),
    is_nonnull(f),
    is_nonnull(s),
    is_nonnull(y),
    is_nonnull(a),
    is_nonnull(m),
    is_nonnull(g),
    is_nonnull(h),
]
