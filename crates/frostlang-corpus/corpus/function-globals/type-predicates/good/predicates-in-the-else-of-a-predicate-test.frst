# A failed predicate test rules out one type only: in the `else` branch the
# value may still be any other type, and the predicates tell which.
#= {
#=     result: ['int', [true, true, false], [false, false, true], [false, false, false]],
#=     inputs: {samples: [1, 1.5, null, 'a']},
#= }
map samples with fn v -> if is_int(v): 'int' else: [is_float(v), is_numeric(v), is_null(v)]
