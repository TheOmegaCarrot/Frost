# `is_numeric` is true for Int and Float, on values known only at run time.
#= {
#=     result: [false, false, true, true, false, false, false, false, false, false],
#=     inputs: {n: null, b: false, i: 0, f: 0.0, s: '', y: x'', a: [], m: {}, g: fn -> null, h: len},
#= }
def {n, b, i, f, s, y, a, m, g, h} = import('inputs')
[
    is_numeric(n),
    is_numeric(b),
    is_numeric(i),
    is_numeric(f),
    is_numeric(s),
    is_numeric(y),
    is_numeric(a),
    is_numeric(m),
    is_numeric(g),
    is_numeric(h),
]
