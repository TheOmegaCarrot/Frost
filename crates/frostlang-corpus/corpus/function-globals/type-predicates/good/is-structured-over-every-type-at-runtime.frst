# `is_structured` is true for Array and Map, on values known only at run
# time.
#= {
#=     result: [false, false, false, false, false, false, true, true, false, false],
#=     inputs: {n: null, b: false, i: 0, f: 0.0, s: '', y: x'', a: [], m: {}, g: fn -> null, h: len},
#= }
def {n, b, i, f, s, y, a, m, g, h} = import('inputs')
[
    is_structured(n),
    is_structured(b),
    is_structured(i),
    is_structured(f),
    is_structured(s),
    is_structured(y),
    is_structured(a),
    is_structured(m),
    is_structured(g),
    is_structured(h),
]
