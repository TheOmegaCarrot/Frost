# `is_bool` is true for Bool alone, on values known only at run time.
#= {
#=     result: [false, true, false, false, false, false, false, false, false, false],
#=     inputs: {n: null, b: false, i: 0, f: 0.0, s: '', y: x'', a: [], m: {}, g: fn -> null, h: len},
#= }
[
    is_bool(n),
    is_bool(b),
    is_bool(i),
    is_bool(f),
    is_bool(s),
    is_bool(y),
    is_bool(a),
    is_bool(m),
    is_bool(g),
    is_bool(h),
]
