# `is_primitive` is true for Null, Bool, Int, Float, String, and Bytes, on
# values known only at run time.
#= {
#=     result: [true, true, true, true, true, true, false, false, false, false],
#=     inputs: {n: null, b: false, i: 0, f: 0.0, s: '', y: x'', a: [], m: {}, g: fn -> null, h: len},
#= }
[
    is_primitive(n),
    is_primitive(b),
    is_primitive(i),
    is_primitive(f),
    is_primitive(s),
    is_primitive(y),
    is_primitive(a),
    is_primitive(m),
    is_primitive(g),
    is_primitive(h),
]
