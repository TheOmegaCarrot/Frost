# Spreading an Array into a call neither consumes nor changes it: the same
# Array can be spread again and read afterward. Subtle because the VM may
# reuse a uniquely owned Array in place.
#= {result: [[1, 2], [1, 2], [1, 2]], inputs: {args: [1, 2]}}
def {args} = import('inputs')
def first = call(collect, args)
def second = call(collect, args)
[first, second, args]
