# `call` spreads an Array longer than a 16-bit count can hold, filling the
# fixed parameters first and gathering every remaining element into the
# rest parameter. Subtle because an argument count kept in 16 bits would
# wrap past 65535.
#= {result: [[0, 1, 65535], 65537, 65536], inputs: {n: 65537}}
def args = range(n)
[
    call(fn a, b, ...rest -> [a, b, len(rest)], args),
    len(call(collect, args)),
    call(rev_args(collect), args)[0],
]
