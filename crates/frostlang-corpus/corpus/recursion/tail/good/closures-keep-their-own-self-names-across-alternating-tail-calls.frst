# Two functions tail-call each other in turn, each leaving behind a closure
# over its own name. Each closure keeps the function that made it, though
# the frame it was made in is reused by the other function's call.
#= {result: [true, false, true, false]}
defn ping(n, made, other) -> if n == 0: made else: other(n - 1, made + [fn -> ping], ping)
defn pong(n, made, other) -> if n == 0: made else: other(n - 1, made + [fn -> pong], pong)
def made = ping(4, [], pong)
transform(made, fn m -> m() == ping)
