# A recursive flatten: empty Arrays vanish, and Maps are leaves.
#= {result: [[], [1, 2, 3, {k: [4]}, null, 5.5]]}
defn flatten(xs) -> match xs {
    [] => [],
    [head, ...tail] => (if is_array(head): flatten(head) else: [head]) + flatten(tail),
}
[flatten([[], [[]]]), flatten([[1, [2]], [], [[3, [{k: [4]}]]], null, [[[5.5]]]])]
