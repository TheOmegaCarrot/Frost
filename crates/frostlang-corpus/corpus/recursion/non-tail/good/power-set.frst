# A recursion that uses its sub-result twice: the subsets of an Array.
#= {result: [[[]], [[], [3], [2], [2, 3], [1], [1, 3], [1, 2], [1, 2, 3]]]}
defn subsets(xs) -> match xs {
    [] => [[]],
    [head, ...tail] => do {
        def rest = subsets(tail)
        rest + map(rest, fn s -> [head] + s)
    },
}
[subsets([]), subsets([1, 2, 3])]
