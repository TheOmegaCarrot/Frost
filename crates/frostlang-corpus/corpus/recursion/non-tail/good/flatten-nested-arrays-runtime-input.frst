# A recursive flatten over nested Arrays known only at runtime: empty Arrays
# vanish, and Maps and Null are leaves.
#= {result: [1, 2, 3, {k: [4]}, null, 5.5], inputs: {tree: [[1, [2]], [], [[3, [{k: [4]}]]], null, [[[5.5]]]]}}
def {tree} = import('inputs')
defn flatten(xs) -> match xs {
    [] => [],
    [head, ...tail] => (if is_array(head): flatten(head) else: [head]) + flatten(tail),
}
flatten(tree)
