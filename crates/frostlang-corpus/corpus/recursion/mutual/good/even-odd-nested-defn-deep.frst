# A local `defn` that calls its enclosing function, which calls it in turn:
# a mutual recursion entirely in tail position, a hundred thousand calls deep.
#= {result: [true, false]}
defn even(n) -> {
    defn odd(m) -> if m == 0: false else: even(m - 1)
    if n == 0: true else: odd(n - 1)
}
[even(100000), even(99999)]
