# A `defn` and an abbreviated lambda recurse mutually in tail position. The
# abbreviated lambda cannot name itself, so it is passed itself as a
# placeholder argument and hands itself back on every call.
#= {result: [true, false, true]}
def odd = $(if $1 == 0: false else: $2($1 - 1, $3))
defn even(n, odd) -> if n == 0: true else: odd(n - 1, even, odd)
[even(0, odd), even(100001, odd), even(100000, odd)]
