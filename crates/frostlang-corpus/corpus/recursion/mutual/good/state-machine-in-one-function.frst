# Mutually recursive states folded into one function that matches on a state
# tag: each state hands off to the next by a tail call.
#= {result: [[3, 3, 3], [34, 33, 33]]}
defn run(state, n, counts) -> if n == 0: [counts.a, counts.b, counts.c]
    else: match state {
        'a' => run('b', n - 1, counts + {a: counts.a + 1}),
        'b' => run('c', n - 1, counts + {b: counts.b + 1}),
        'c' => run('a', n - 1, counts + {c: counts.c + 1}),
    }
[run('a', 9, {a: 0, b: 0, c: 0}), run('a', 100, {a: 0, b: 0, c: 0})]
