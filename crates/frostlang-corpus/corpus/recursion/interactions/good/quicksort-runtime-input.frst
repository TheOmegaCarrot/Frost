# Quicksort over an Array of Strings known only at runtime. Strings order by
# their text, non-ASCII included.
#= {result: ['', 'apple', 'banana', 'cherry', 'é'], inputs: {words: ['cherry', 'é', 'apple', '', 'banana']}}
defn qsort(xs) -> match xs {
    [] => [],
    [pivot, ...rest] => qsort(select(rest, $($ < pivot))) + [pivot] + qsort(select(rest, $($ >= pivot))),
}
qsort(words)
