# A counter stepped one at a time past the bottom of the Int range, from a
# start known only at runtime, raises rather than wrapping.
#= {
#=     raises: 'Int overflow: -9223372036854775808 + -1',
#=     inputs: {near_min: -9223372036854775806},
#= }
def {near_min} = import('inputs')
defn step(n, by, times) -> if times == 0: n else: step(n + by, by, times - 1)
step(near_min, -1, 4)
