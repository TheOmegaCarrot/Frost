# Appending to an accumulator Array through a few thousand tail calls builds
# it in order.
#= {result: [[], [0, 1, 2, 3, 4], 5000, 4999]}
defn range_to(n, i, acc) -> if i == n: acc else: range_to(n, i + 1, acc + [i])
def big = range_to(5000, 0, [])
[range_to(0, 0, []), range_to(5, 0, []), len(big), big[4999]]
