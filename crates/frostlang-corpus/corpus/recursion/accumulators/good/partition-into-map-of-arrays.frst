# A structured accumulator: a Map of two Arrays, rebuilt at each step with one
# side extended.
#= {result: [{evens: [], odds: []}, {evens: [0, -2, 4], odds: [1, 3, -5]}]}
defn partition(xs, acc) -> match xs {
    [] => acc,
    [x, ...rest] => partition(rest, if x % 2 == 0: acc + {evens: acc.evens + [x]} else: acc + {odds: acc.odds + [x]}),
}
[partition([], {evens: [], odds: []}), partition([0, 1, -2, 3, 4, -5], {evens: [], odds: []})]
