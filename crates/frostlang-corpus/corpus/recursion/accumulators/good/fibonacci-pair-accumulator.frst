# Two accumulators carry consecutive Fibonacci numbers, so each is computed
# once. The accumulators come right up to the top of the Int range exactly.
#= {result: [0, 1, 2880067194370816120, 4660046610375530309]}
defn fib(n, a, b) -> if n == 0: a else: fib(n - 1, b, a + b)
[fib(0, 0, 1), fib(1, 0, 1), fib(90, 0, 1), fib(91, 0, 1)]
