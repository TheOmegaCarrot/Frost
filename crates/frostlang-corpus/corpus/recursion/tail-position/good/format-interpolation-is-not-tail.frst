# A call inside a format string's interpolation is not in tail position, even
# as the only interpolation: the String is built after it returns.
#= {result: 495}
defn down(n) -> if n == 0: error('bottom') else: $'${down(n - 1)}'
defn frames(n) -> len(try_call(down, [n]).trace)
frames(500) - frames(5)
