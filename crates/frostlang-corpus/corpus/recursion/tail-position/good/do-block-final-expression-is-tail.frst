# The final expression of a `do` block in tail position is in tail position,
# after the block's own definitions and statements.
#= {result: 0}
defn down(n) -> if n == 0: error('bottom') else: do {
    def m = n - 1
    m + 1
    down(m)
}
defn frames(n) -> len(try_call(down, [n]).trace)
frames(500) - frames(5)
