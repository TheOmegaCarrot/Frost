# A `match` guard is a condition like any other: `and`, `or`, and `not` combine
# its tests, and a guard that is falsy moves on to the next arm.
#= {
#=     result: ['small even', 'small odd', 'large or negative', 'not an Int'],
#=     lints: [['unused binding', '`n`']],
#=     inputs: {xs: [4, 3, 40, 'x']},
#= }
transform(xs, fn x -> match x {
    n is Int if: n > 0 and n < 10 and n % 2 == 0 => 'small even',
    n is Int if: not (n >= 10 or n < 0) => 'small odd',
    n is Int => 'large or negative',
    _ => 'not an Int',
})
