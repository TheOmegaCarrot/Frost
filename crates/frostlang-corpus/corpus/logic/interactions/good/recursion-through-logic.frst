# A recursive call may be the right operand of `and` or `or`, and recursion
# stops where the logic short-circuits.
#= {
#=     result: [true, false, false],
#=     inputs: {with_negative: [3, 1, -2, 5], all_positive: [1, 2], empty: []},
#= }
def {with_negative, all_positive, empty} = import('inputs')
defn any_negative(xs, i) -> i < len(xs) and (xs[i] < 0 or any_negative(xs, i + 1))
[
    any_negative(with_negative, 0),
    any_negative(all_positive, 0),
    any_negative(empty, 0),
]
