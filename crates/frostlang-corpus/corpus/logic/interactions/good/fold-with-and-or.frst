# Folding with `and` finds the first falsy element or else the last element;
# folding with `or` finds the first truthy one. An empty collection yields the
# initial value.
#= {
#=     result: [3, null, true, 2, null, false],
#=     inputs: {truthy: [1, 'a', 3], mixed: [1, null, false], empty: [], late: [null, false, 2, 4]},
#= }
[
    fold(truthy, true, fn acc, x -> acc and x),
    fold(mixed, true, fn acc, x -> acc and x),
    fold(empty, true, fn acc, x -> acc and x),
    fold(late, false, fn acc, x -> acc or x),
    reduce mixed with fn acc, x -> acc and x,
    fold(empty, false, fn acc, x -> acc or x),
]
