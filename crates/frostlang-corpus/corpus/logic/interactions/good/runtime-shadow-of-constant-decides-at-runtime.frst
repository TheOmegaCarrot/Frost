# A runtime binding that shadows a constant one decides a logical by its own
# runtime value; once its block ends, the outer constant is back in view.
# Subtle because propagating the outer constant into the block would be wrong.
#= {
#=     result: [null, 1, 3],
#=     lints: [['unused binding', '`t`']],
#=     inputs: {x: null, one: 1},
#= }
def t = true
def inner = do {
    def t = x
    t and 1
}
def u = null
def other = do {
    def u = one
    u or 2
}
[inner, other, u or 3]
