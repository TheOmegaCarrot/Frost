# `or` yields its left operand when that is truthy, and otherwise its right
# operand, unchanged: the result is a deciding operand, never a coerced Bool.
#= {result: [5, 5, 5, false, null, 0, 'default', 2.5]}
[
    5 or true,
    null or 5,
    false or 5,
    null or false,
    false or null,
    false or 0,
    null or 'default',
    2.5 or 1,
]
