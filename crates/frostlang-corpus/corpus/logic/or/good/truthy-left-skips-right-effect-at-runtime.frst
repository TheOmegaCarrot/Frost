# A truthy left operand known only at runtime short-circuits `or` in the VM:
# the right operand's `print` never runs.
#= {result: [true, 0, ''], inputs: {t: true, zero: 0, empty: ''}}
[
    t or print('right of true'),
    zero or print('right of 0'),
    empty or print('right of the empty String'),
]
