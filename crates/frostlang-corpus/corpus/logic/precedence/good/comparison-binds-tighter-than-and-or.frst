# Comparisons bind tighter than `and` and `or`, so each side of a logical
# operator may be a whole comparison without parentheses.
#= {
#=     result: [false, true, true, false],
#=     inputs: {x: 5},
#= }
[
    1 < 2 and 3 > 4,
    1 == 2 or 2 != 3,
    x > 0 and x < 10,
    x <= 0 or x >= 10,
]
