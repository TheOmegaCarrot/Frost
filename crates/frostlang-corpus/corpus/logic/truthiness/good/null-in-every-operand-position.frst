# Null is falsy as either operand of `and` and `or`, and as the operand of
# `not`, whether a literal or known only at runtime.
#= {
#=     result: [
#=         [null, null, null, null, true],
#=         [null, null, null, null, true],
#=     ],
#=     inputs: {n: null, one: 1},
#= }
[
    [null and 1, 1 and null, null or null, null and null, not null],
    [n and one, one and n, n or n, n and n, not n],
]
