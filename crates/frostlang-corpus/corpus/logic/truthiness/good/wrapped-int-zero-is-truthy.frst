# Int overflow wraps, and an Int that wraps around to zero or to the least Int
# is as truthy as any other.
#= {
#=     result: [0, 0, -9223372036854775808, -9223372036854775808],
#=     inputs: {max: 9223372036854775807, min: -9223372036854775808},
#= }
[
    (-9223372036854775808 * 2) or 'falsy',
    (min * 2) or 'falsy',
    (9223372036854775807 + 1) or 'falsy',
    (max + 1) or 'falsy',
]
