# A fold that stores each step's accumulator in a history while extending the
# accumulator keeps every stored step as it was when stored.
#= {result: {history: [[], [1], [1, 2]], current: [1, 2, 3]}, inputs: {xs: [1, 2, 3]}}
def step = fn state, x -> {
    history: state.history + [state.current],
    current: state.current + [x],
}
fold(xs, {history: [], current: []}, step)
