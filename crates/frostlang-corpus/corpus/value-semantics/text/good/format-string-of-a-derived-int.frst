# A format string interpolating an Int and a value computed from it leaves
# the Int binding unchanged, even at the Int boundary.
#= {result: ['9223372036854775807 9223372036854775806', 9223372036854775807], inputs: {n: 9223372036854775807}}
def {n} = import('inputs')
def m = n
[$'${m} ${m - 1}', m]
