# A binding used as a computed key in several arms' Map patterns, and read
# again in the arm that matches, is the original each time.
#= {result: [[1, 2], 'ké'], lints: [['unused binding', '`v`']], inputs: {s: 'ké'}}
def {s} = import('inputs')
def k = s + ''
def m = {[k]: [1]}
match m {
    {[k]: v} if: len(v) == 5 => 'never',
    {[k + '!']: v} => 'never',
    {[k]: v} => [v + [2], k],
}
