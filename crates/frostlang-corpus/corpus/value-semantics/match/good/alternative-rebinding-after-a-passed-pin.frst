# The first alternative binds `x`, compares it with a pin of that same `x`
# (which matches), and then fails on a later element. The second alternative
# binds `x` afresh, and the arm sees that value unchanged, though the first
# alternative's comparison read it.
#= {result: [[1], [1, 0]], inputs: {n: 1}}
match [[n], [n], 5] {
    [x, (x), 2] | [x, _, _] => [x, x + [0]],
}
