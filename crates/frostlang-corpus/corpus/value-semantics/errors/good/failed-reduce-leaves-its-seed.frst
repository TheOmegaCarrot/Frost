# A reduce that raises after extending its accumulator, caught by `try_call`,
# leaves the seed it started from as it was.
#= {result: [false, [0]], inputs: {n: 0}}
def {n} = import('inputs')
def seed = [n]
def step = fn acc, x -> if x == 3: error('stop') else: acc + [x]
def r = try_call(fn -> reduce([1, 2, 3], seed, step))
[r.ok, seed]
