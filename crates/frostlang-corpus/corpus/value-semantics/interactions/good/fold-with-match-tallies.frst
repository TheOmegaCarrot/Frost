# A fold whose step matches each item to update a tally Map builds the right
# tally, and the starting tally is unchanged.
#= {
#=     result: [{ints: [1, 3], strs: ['a'], other: 1}, {ints: [], strs: [], other: 0}],
#=     inputs: {items: [1, 'a', 3, null]},
#= }
def empty = {ints: [], strs: [], other: 0}
defn step(tally, item) -> match item {
    i is Int => tally + {ints: tally.ints + [i]},
    s is String => tally + {strs: tally.strs + [s]},
    _ => tally + {other: tally.other + 1},
}
[fold(items, empty, step), empty]
