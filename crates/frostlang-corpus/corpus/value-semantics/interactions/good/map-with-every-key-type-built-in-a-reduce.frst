# A Map built by a reduce from entries of every key type holds them all, and a
# snapshot taken partway keeps only the entries it had.
#= {
#=     result: [
#=         {[true]: 1, [2]: 2, [2.5]: 3, s: 4, [x'ff']: 5},
#=         {[true]: 1, [2]: 2},
#=     ],
#=     inputs: {entries: [[true, 1], [2, 2], [2.5, 3], ['s', 4], [x'ff', 5]]},
#= }
def {entries} = import('inputs')
def step = fn state, entry -> {
    m: state.m + {[entry[0]]: entry[1]},
    early: if len(state.m) == 2: state.m else: state.early,
}
def done = reduce(entries, {m: {}, early: null}, step)
[done.m, done.early]
