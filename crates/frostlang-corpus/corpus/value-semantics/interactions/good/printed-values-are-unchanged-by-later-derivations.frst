# A value printed, then derived from, prints the same afterward: what a
# program observes of a binding never changes.
#= {result: 3, printed: ['1', '3', '1'], inputs: {n: 1}}
def {n} = import('inputs')
def xs = [n]
print(to_string(len(xs)))
def ys = xs + xs + xs
print(to_string(len(ys)))
print(to_string(len(xs)))
len(ys)
