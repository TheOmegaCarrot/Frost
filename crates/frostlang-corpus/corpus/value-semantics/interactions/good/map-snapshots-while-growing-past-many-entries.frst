# A Map grown one entry at a time to many entries keeps every snapshot taken
# along the way at the size it had then, whatever form the Map takes as it
# grows.
#= {result: [100, 8, 16, 7, null, 15, null], inputs: {stop: 100}}
def {stop} = import('inputs')
defn grow(k, m, snapshots) -> if k == stop: [m, snapshots] else: do {
    def kept = if k == 8 or k == 16: snapshots + [m] else: snapshots
    grow(k + 1, m + {[k]: k}, kept)
}
def [full, snapshots] = grow(0, {}, [])
def [small, larger] = snapshots
[len(full), len(small), len(larger), small[7], small[8], larger[15], larger[16]]
