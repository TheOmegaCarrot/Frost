# An element read out of an Array at that Array's last use, then extended,
# leaves the element's other binding unchanged. The outer Array is given up
# by the read, but the element it held is still held by `inner`.
#= {result: [[1, 2], [1]], inputs: {n: 1}}
def {n} = import('inputs')
def inner = [n]
def outer = [inner]
def grown = outer[0] + [2]
[grown, inner]
