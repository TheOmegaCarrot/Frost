# An Array holding the least Int, and one built from that element plus one,
# are independent: the derived element does not reach the original.
#= {result: [[-9223372036854775808], [-9223372036854775807]], inputs: {n: -9223372036854775808}}
def {n} = import('inputs')
def xs = [n]
def ys = [xs[0] + 1]
[xs, ys]
