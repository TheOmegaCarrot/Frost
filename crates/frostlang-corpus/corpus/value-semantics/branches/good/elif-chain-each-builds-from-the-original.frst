# Every arm of an `elif` chain that derives from one binding builds from the
# original, and the binding is unchanged after the chain.
#= {result: [[[1, 'a'], [1, 'b'], [1, 'c']], [1]], inputs: {n: 1}}
def {n} = import('inputs')
def xs = [n]
defn pick(k) -> if k == 1: xs + ['a'] elif k == 2: xs + ['b'] else: xs + ['c']
[[pick(1), pick(2), pick(3)], xs]
