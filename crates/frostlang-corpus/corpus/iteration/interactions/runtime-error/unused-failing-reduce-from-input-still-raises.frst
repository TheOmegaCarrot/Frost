# A `reduce` over runtime values bound to a name that is never read still
# runs, so its operation's error still surfaces.
#= {
#=     raises: 'division by zero',
#=     lints: [['unused binding', '`unused`']],
#=     inputs: {xs: [1, 0]},
#= }
def unused = reduce(xs, 1, fn acc, x -> acc / x)
'unreachable'
