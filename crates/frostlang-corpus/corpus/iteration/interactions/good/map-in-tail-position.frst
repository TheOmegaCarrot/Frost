# A `map` as a function's result, where it is a tail call, returns its value
# to the caller like any other call.
#= {result: [[2, 3], [[2, 3]]], inputs: {xs: [1, 2]}}
def {xs} = import('inputs')
defn bump(ys) -> map(ys, fn y -> y + 1)
defn wrapped(ys) -> [map(ys, fn y -> y + 1)]
[bump(xs), wrapped(xs)]
