# An abbreviated lambda may hold a `fn` lambda, here as the operation of a
# `map` inside it. Its `$` is the abbreviated lambda's argument, each row;
# the inner lambda's `x` is each element of that row.
#= {
#=     result: [[2, 3], []],
#=     lints: ['lambda in abbreviated lambda'],
#=     inputs: {rows: [[1, 2], []]},
#= }
def {rows} = import('inputs')
map(rows, $(map($, fn x -> x + 1)))
