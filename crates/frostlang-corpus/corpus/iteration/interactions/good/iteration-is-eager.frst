# The iteration functions are eager: a `map` runs every call of its operation
# before the next statement starts, not when its result is first used.
#= {
#=     result: [1, 2],
#=     printed: ['map 1', 'map 2', 'after', 'filter 1', 'filter 2'],
#=     inputs: {xs: [1, 2]},
#= }
def {xs} = import('inputs')
def ys = map(xs, fn x -> {
    print($'map ${x}')
    x
})
print('after')
filter(ys, fn y -> {
    print($'filter ${y}')
    true
})
