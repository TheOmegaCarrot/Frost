# The function forms take the structure first, so `@` threads a pipeline
# through them; `fold`'s init follows the threaded structure.
#= {result: [[10, 30], 40, 46], inputs: {xs: [1, 2, 3]}}
def picked = xs @ select(fn x -> x != 2) @ transform(fn x -> x * 10)
[picked, picked @ fold(fn acc, x -> acc + x), picked @ fold(6, fn acc, x -> acc + x)]
