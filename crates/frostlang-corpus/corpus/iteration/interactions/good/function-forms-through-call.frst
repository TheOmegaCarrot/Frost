# The function forms are ordinary functions: `call` applies them to an
# argument Array, including `fold`'s optional init.
#= {result: [[2, 3], [2], 3, 13], inputs: {xs: [1, 2]}}
def inc = fn x -> x + 1
def add = fn acc, x -> acc + x
[
    call(transform, [xs, inc]),
    call(select, [xs, fn x -> x > 1]),
    call(fold, [xs, add]),
    call(fold, [xs, 10, add]),
]
