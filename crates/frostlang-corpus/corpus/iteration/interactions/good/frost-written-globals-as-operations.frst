# Globals written in Frost, and the functions they return, serve as
# operations like any other function.
#= {
#=     result: [[1, 2], ['x', 'y'], [2, 12], [11, 12], [0, 0], {}],
#=     inputs: {
#=         xs: [1, null, 2],
#=         records: [{name: 'x'}, {name: 'y'}],
#=         pairs: [[1, 2], [3, 4]],
#=         ys: [1, 2],
#=         m: {a: 1},
#=     },
#= }
def {xs, records, pairs, ys, m} = import('inputs')
[
    filter(xs, inv(is_null)),
    map(records, index('name')),
    map(pairs, spread(fn a, b -> a * b)),
    map(ys, curry(fn a, b -> a + b, 10)),
    map(ys, const(0)),
    map(m, const({})),
]
