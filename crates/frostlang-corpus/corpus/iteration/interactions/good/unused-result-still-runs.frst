# A `map` bound to a name that is never read still runs, effects and all:
# leaving a binding unread never skips computing it.
#= {
#=     result: 'end',
#=     printed: ['1', '2'],
#=     lints: [['unused binding', '`unused`']],
#=     inputs: {xs: [1, 2]},
#= }
def {xs} = import('inputs')
def unused = map(xs, fn x -> print(x))
'end'
