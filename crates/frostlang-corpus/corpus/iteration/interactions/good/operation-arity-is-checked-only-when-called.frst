# An iteration function checks that its operation is a function up front,
# but the operation's arity only matters when it is called. Subtle: each
# operation here has the wrong arity for its use, yet none is ever called:
# the structures are empty, or `reduce` has a lone element to seed with.
#= {
#=     result: [[], {}, [], 7, 0],
#=     inputs: {empty: [], none: {}, one: [7]},
#= }
def {empty, none, one} = import('inputs')
[
    map(empty, fn -> 0),
    filter(none, fn x -> true),
    each(empty, fn a, b, c -> null),
    reduce(one, fn x -> x),
    reduce(none, 0, fn acc, k -> acc),
]
