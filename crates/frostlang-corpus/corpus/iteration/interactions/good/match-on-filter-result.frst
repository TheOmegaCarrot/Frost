# A `filter`'s result can be matched directly, as here, where whether
# anything survived it picks the arm.
#= {
#=     result: ['first: 3', 'nothing'],
#=     lints: [['unused binding', '`rest`']],
#=     inputs: {xs: [1, 3, 5], ys: [1]},
#= }
def {xs, ys} = import('inputs')
defn first_big(zs) -> match filter(zs, fn z -> z > 2) {
    [] => 'nothing',
    [first, ...rest] => $'first: ${first}',
}
[first_big(xs), first_big(ys)]
