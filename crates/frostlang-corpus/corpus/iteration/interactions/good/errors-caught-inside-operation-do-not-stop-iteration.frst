# An error caught inside the operation, by `try_call`, does not reach the
# `map`, so iteration carries on past the failing element.
#= {
#=     result: [[1, null, 3], [1, null, 3]],
#=     printed: ['1', '2', '3'],
#=     inputs: {xs: [1, 2, 3]},
#= }
def guarded = fn x -> {
    def outcome = try_call(fn -> if x == 2: error('skip') else: x)
    if outcome.ok: outcome.value else: null
}
def literal = map([1, 2, 3], guarded)
def runtime = map(xs, fn x -> {
    print(x)
    guarded(x)
})
[literal, runtime]
