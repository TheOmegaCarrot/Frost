# `reduce` called like a function with only a structure and a lambda passes
# no initial value, so the help should point to `fold(xs, f)`. Subtle: the
# lambda's own parameter list holds a comma, which must not count as a
# separate argument.
#= {rejects: '`fold(xs, f)`'}
def xs = [1]
reduce(xs, fn acc, x -> acc + x)
