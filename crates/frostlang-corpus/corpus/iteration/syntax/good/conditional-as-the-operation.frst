# The operation may be an `if` expression choosing between functions. Its
# `else` branch is the last part of the form, so it extends to the end, and
# the chosen function is what the form calls per element.
#= {
#=     result: [[2, 3], [10, 20]],
#=     inputs: {xs: [1, 2], up: true, down: false},
#= }
defn inc(x) -> x + 1
defn tenfold(x) -> x * 10
[
    map xs with if up: inc else: tenfold,
    map xs with if down: inc else: tenfold,
]
