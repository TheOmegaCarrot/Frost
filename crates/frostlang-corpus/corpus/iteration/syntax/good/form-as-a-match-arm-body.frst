# A form can be a `match` arm's body. Subtle: its lambda's body would extend
# as far as it can, but the comma separating arms ends it, so the next arm
# is not swallowed into the lambda.
#= {result: [[10, 20], 'none'], inputs: {xs: [1, 2], empty: []}}
defn scaled(ys) -> match ys {
    [_, ..._] => map ys with fn y -> y * 10,
    _ => 'none',
}
[scaled(xs), scaled(empty)]
