# `reduce` takes its initial value before the function. Subtle: written the
# other way round, the function is taken as the initial value and the initial
# value as the function, so the error is about the last argument not being a
# Function.
#= {raises: ['reduce', 'Function', 'argument 3', 'Int']}
reduce([1, 2], fn acc, x -> acc + x, 0)
