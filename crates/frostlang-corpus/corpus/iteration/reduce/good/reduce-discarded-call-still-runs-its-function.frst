# A `reduce` call whose result is unused still calls its function, with or
# without an initial value, over a literal Array as over a runtime one.
#= {result: 'done', printed: ['2', '3', '4'], inputs: {xs: [4]}}
reduce([1, 2], fn acc, x -> print(to_string(x)))
reduce([3], null, fn acc, x -> print(to_string(x)))
reduce(xs, 0, fn acc, x -> print(to_string(x)))
'done'
