# A `fold` inside another's function can take the outer accumulator as its
# init, threading one running total through every row of a nested Array.
#= {result: [1, 3, 6, 10], inputs: {rows: [[1, 2], [], [3, 4]]}}
fold(rows, [], fn acc, row -> fold(row, acc, fn inner, x -> {
    def last = if inner == []: 0 else: inner[len(inner) - 1]
    inner + [last + x]
}))
