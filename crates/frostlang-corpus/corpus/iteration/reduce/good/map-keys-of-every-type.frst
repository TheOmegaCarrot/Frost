# Every key type reaches the operation as a value of that type, in type order:
# Bool, Int, Float, String, Bytes.
#= {
#=     result: ['Bool', 'Int', 'Float', 'String', 'Bytes'],
#=     inputs: {m: {[x'ff']: 5, s: 4, [3.5]: 3, [2]: 2, [true]: 1}},
#= }
def {m} = import('inputs')
reduce(m, [], fn acc, k, v -> acc + [type(k)])
