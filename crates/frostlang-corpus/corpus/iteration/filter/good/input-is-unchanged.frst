# `filter` produces a new structure; the one it filters is unchanged.
#= {
#=     result: [[1, 2, 3], [2], {a: 1, b: 2}, {b: 2}],
#=     inputs: {xs: [1, 2, 3], m: {a: 1, b: 2}},
#= }
def {xs, m} = import('inputs')
def ys = filter(xs, fn x -> x == 2)
def n = filter(m, fn k, v -> v == 2)
[xs, ys, m, n]
