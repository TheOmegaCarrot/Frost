# `filter` calls its predicate exactly once per element, first to last,
# whether the element is kept or not, as the printed trace shows.
#= {
#=     result: [2, 2],
#=     printed: ['1', '2', '3', '2'],
#=     inputs: {xs: [1, 2, 3, 2]},
#= }
filter(xs, fn x -> {
    print(to_string(x))
    x == 2
})
