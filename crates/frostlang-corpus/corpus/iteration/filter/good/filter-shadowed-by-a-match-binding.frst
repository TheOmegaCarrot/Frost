# A match pattern binding the name `filter` replaces the global within its
# arm, so a call there is to the bound value; outside the arm the global is
# back.
#= {result: [[1, 2], [2]], inputs: {xs: [1, 2], picks: [fn s, f -> s]}}
def {xs, picks} = import('inputs')
def keep_big = fn x -> x > 1
def in_arm = match picks {
    [filter] => filter(xs, keep_big),
}
[in_arm, filter(xs, keep_big)]
