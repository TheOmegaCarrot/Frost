# A native global serves as `select`'s predicate. Over a Map, a two-parameter
# native receives the key and the value: `equal` keeps entries whose key is
# its own value, `starts_with` those whose key starts with the value.
#= {
#=     result: [[1, 2], {a: 'a'}, {abc: 'ab', b: 'b'}],
#=     inputs: {
#=         xs: [1, 'one', 2, null],
#=         m: {a: 'a', b: 'c'},
#=         prefixes: {abc: 'ab', b: 'b', cd: 'x'},
#=     },
#= }
[select(xs, is_int), select(m, equal), select(prefixes, starts_with)]
