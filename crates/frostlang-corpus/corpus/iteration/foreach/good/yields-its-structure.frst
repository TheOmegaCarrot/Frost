# `foreach` yields the structure it iterated, whatever the operation returns.
#= {
#=     result: [[1, 2], {a: 1}, [1, 2], {a: 1}],
#=     inputs: {xs: [1, 2], m: {a: 1}},
#= }
[
    foreach [1, 2] with fn x -> x * 100,
    foreach {a: 1} with fn k, v -> null,
    foreach xs with fn x -> x * 100,
    foreach m with fn k, v -> null,
]
