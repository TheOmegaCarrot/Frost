# A variadic operation shows what `foreach` passes it: one argument, the
# element, per Array element, and two, key then value, per Map entry.
#= {
#=     result: null,
#=     printed: ['Int', 'Null', 'String Int'],
#=     inputs: {xs: [7, null], m: {a: 1}},
#= }
def show = fn ...args -> print(reduce (map args with type) with fn acc, t -> acc + ' ' + t)
foreach xs with show
foreach m with show
null
