# A `foreach` inside another's operation runs to completion for each outer
# element before the outer one moves on, so their effects interleave by
# element, not by level.
#= {
#=     result: [1, 2],
#=     printed: ['outer 1', '1a', '1b', 'outer 2', '2a', '2b'],
#=     inputs: {xs: [1, 2], tags: ['a', 'b']},
#= }
foreach xs with fn x -> {
    print($'outer ${x}')
    foreach tags with fn t -> print($'${x}${t}')
}
