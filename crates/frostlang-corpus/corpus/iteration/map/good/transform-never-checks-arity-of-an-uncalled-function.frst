# A function's parameter count is checked only when it is called, so over an
# empty structure `transform` accepts a function of any arity. Subtle: each
# of these would fail on the first element or entry.
#= {
#=     result: [[], {}, [], {}],
#=     inputs: {xs: [], m: {}},
#= }
[
    transform([], fn a, b, c -> a),
    transform({}, fn x -> {}),
    transform(xs, fn -> 1),
    transform(m, fn k, v, extra -> {}),
]
