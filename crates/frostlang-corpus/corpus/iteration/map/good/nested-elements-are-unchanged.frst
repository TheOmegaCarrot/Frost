# An operation that builds on each element, here appending to an inner Array,
# leaves the elements of the mapped Array unchanged. Subtle: the runtime may
# update a uniquely-held value in place, and an inner Array handed to the
# operation is still shared with the outer one.
#= {result: [[[1], [2]], [[1, 0], [2, 0]]], inputs: {xs: [[1], [2]]}}
def {xs} = import('inputs')
def ys = map(xs, fn row -> row + [0])
[xs, ys]
