# A function with a rest parameter after its required ones takes whatever
# `transform` passes beyond them: nothing over an Array, the value over a Map.
#= {
#=     result: [[[1, []], [2, []]], {a: [1]}],
#=     inputs: {xs: [1, 2], m: {a: 1}},
#= }
[transform(xs, fn x, ...rest -> [x, rest]), transform(m, fn k, ...rest -> {[k]: rest})]
