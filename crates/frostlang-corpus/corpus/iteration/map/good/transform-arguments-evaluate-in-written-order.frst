# `transform` evaluates its arguments in the order written, the structure and
# then the function, and only then calls the function on each element.
#= {
#=     result: [2, 3],
#=     printed: ['structure', 'function', 'call', 'call'],
#=     inputs: {xs: [1, 2]},
#= }
transform(
    do {
        print('structure')
        xs
    },
    do {
        print('function')
        fn x -> {
            print('call')
            x + 1
        }
    },
)
