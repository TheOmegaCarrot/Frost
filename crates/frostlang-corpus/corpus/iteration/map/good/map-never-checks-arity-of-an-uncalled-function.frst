# A function's parameter count is checked only when it is called, so over an
# empty structure `map` accepts a function of any arity. Subtle: each
# of these would fail on the first element or entry.
#= {
#=     result: [[], {}, [], {}],
#=     inputs: {xs: [], m: {}},
#= }
def {xs, m} = import('inputs')
[
    map([], fn a, b, c -> a),
    map({}, fn x -> {}),
    map(xs, fn -> 1),
    map(m, fn k, v, extra -> {}),
]
