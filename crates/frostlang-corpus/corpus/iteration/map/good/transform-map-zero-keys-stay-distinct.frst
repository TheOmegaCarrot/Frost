# When two entries' results hold `0.0` and `-0.0` keys, `transform` keeps both
# entries, each key as written, with `-0.0` first in iteration order whichever
# entry produced it. Subtle: the two keys are different, so neither result
# overwrites the other.
#= {
#=     result: [[[-0.0, 0.0], ['from b', 'from a']], [[-0.0, 0.0], ['from a', 'from b']]],
#=     inputs: {m: {b: 'from b', a: 'from a'}},
#= }
def positive_first = transform(m, fn k, v -> if k == 'a': {[0.0]: v} else: {[-0.0]: v})
def negative_first = transform(m, fn k, v -> if k == 'a': {[-0.0]: v} else: {[0.0]: v})
[
    [keys(positive_first), values(positive_first)],
    [keys(negative_first), values(negative_first)],
]
