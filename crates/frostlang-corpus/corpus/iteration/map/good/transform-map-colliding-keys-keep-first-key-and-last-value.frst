# When two entries' results collide on equal keys, `transform` keeps the key
# from the earlier entry and the value from the later one. Subtle: `0.0` and
# `-0.0` are equal keys yet print differently, so the kept key is observable;
# entries are visited in key order, so `a`'s result comes first.
#= {
#=     result: [['0.0', 'from b'], ['-0.0', 'from b']],
#=     inputs: {m: {b: 'from b', a: 'from a'}},
#= }
def positive_first = transform(m, fn k, v -> if k == 'a': {[0.0]: v} else: {[-0.0]: v})
def negative_first = transform(m, fn k, v -> if k == 'a': {[-0.0]: v} else: {[0.0]: v})
[
    [to_string(keys(positive_first)[0]), values(positive_first)[0]],
    [to_string(keys(negative_first)[0]), values(negative_first)[0]],
]
