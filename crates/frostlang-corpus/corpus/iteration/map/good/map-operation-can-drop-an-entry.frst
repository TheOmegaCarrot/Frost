# An operation returning an empty Map drops that entry from the result,
# whether the optimizer computes the `map` ahead of time or it runs on a
# runtime Map.
#= {result: [{a: 1, c: 3}, {a: 1, c: 3}], inputs: {m: {a: 1, b: 2, c: 3}}}
def {m} = import('inputs')
def drop_two = fn k, v -> if v == 2: {} else: {[k]: v}
[map({a: 1, b: 2, c: 3}, drop_two), map(m, drop_two)]
