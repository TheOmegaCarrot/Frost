# A function with a rest parameter after its required ones takes whatever
# `map` passes beyond them: nothing over an Array, the value over a Map.
#= {
#=     result: [[[1, []], [2, []]], {a: [1]}],
#=     inputs: {xs: [1, 2], m: {a: 1}},
#= }
[map(xs, fn x, ...rest -> [x, rest]), map(m, fn k, ...rest -> {[k]: rest})]
