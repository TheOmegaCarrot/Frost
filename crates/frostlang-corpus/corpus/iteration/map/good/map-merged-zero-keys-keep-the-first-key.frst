# When the operation's results collide on `0.0` and `-0.0`, the merged entry
# keeps the key produced first and the value produced last, as colliding Map
# keys always do, whether the optimizer computes the `map` ahead of time or
# it runs on a runtime Map. Subtle: the Int key `1` is visited before the
# Float key, so its zero comes first, and only `to_string` shows which zero
# survived.
#= {
#=     result: [
#=         '{ [-0.0]: "from 0.0" }',
#=         '{ [0.0]: "from -0.0" }',
#=         '{ [-0.0]: "from 0.0" }',
#=         '{ [0.0]: "from -0.0" }',
#=     ],
#=     inputs: {m: {[0.0]: 'from 0.0', [1]: 'from 1'}, n: {[-0.0]: 'from -0.0', [1]: 'from 1'}},
#= }
defn to_negative(k, v) -> {[if is_int(k): -0.0 else: k]: v}
defn to_positive(k, v) -> {[if is_int(k): 0.0 else: k]: v}
[
    to_string(map {[0.0]: 'from 0.0', [1]: 'from 1'} with to_negative),
    to_string(map {[-0.0]: 'from -0.0', [1]: 'from 1'} with to_positive),
    to_string(map m with to_negative),
    to_string(map n with to_positive),
]
