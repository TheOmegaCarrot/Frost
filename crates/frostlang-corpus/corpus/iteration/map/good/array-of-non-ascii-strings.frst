# `map` passes non-ASCII Strings through intact.
#= {
#=     result: [['héllo!', '日本!', '🧊!'], ['héllo!', '日本!', '🧊!']],
#=     inputs: {xs: ['héllo', '日本', '🧊']},
#= }
def {xs} = import('inputs')
def literal = map(['héllo', '日本', '🧊'], fn s -> s + '!')
def runtime = map(xs, fn s -> s + '!')
[literal, runtime]
