# Int arithmetic in a `map` operation wraps in two's complement, whether the
# optimizer computes it ahead of time or it runs on runtime values.
#= {
#=     result: [
#=         [-9223372036854775808, -9223372036854775807],
#=         [-9223372036854775808, -9223372036854775807],
#=     ],
#=     inputs: {xs: [9223372036854775807, -9223372036854775808]},
#= }
def literal = map [9223372036854775807, -9223372036854775808] with fn x -> x + 1
def runtime = map xs with fn x -> x + 1
[literal, runtime]
