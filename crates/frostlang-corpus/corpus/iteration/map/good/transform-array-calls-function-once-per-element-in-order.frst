# `transform` calls its function exactly once per element, first to last,
# including for repeated and Null elements, as the printed trace shows.
#= {
#=     result: [30, null, 30],
#=     printed: ['3', 'null', '3'],
#=     inputs: {xs: [3, null, 3]},
#= }
transform(xs, fn x -> {
    print(to_string(x))
    if is_null(x): null else: x * 10
})
