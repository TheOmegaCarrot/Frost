# Keys of different types are visited Bool, then Int, then Float, then
# String, then Bytes. Subtle: an Int key comes before every Float key, even a
# smaller one, and negative keys come before positive ones within a type.
#= {
#=     result: {},
#=     printed: ['false', 'true', '-1', '2', '0.5', '9.5', 'A', 'a', 'Bytes'],
#=     inputs: {
#=         m: {
#=             [x'00']: 0,
#=             a: 0,
#=             A: 0,
#=             [9.5]: 0,
#=             [0.5]: 0,
#=             [2]: 0,
#=             [-1]: 0,
#=             [true]: 0,
#=             [false]: 0,
#=         },
#=     },
#= }
map(m, fn k, v -> {
    print(if is_bytes(k): 'Bytes' else: to_string(k))
    {}
})
