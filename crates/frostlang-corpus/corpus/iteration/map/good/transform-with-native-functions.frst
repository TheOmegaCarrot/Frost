# A native global serves as `transform`'s function, over a literal Array the
# optimizer may compute ahead of time and over a runtime one alike.
#= {
#=     result: [['1', 'null'], ['1', 'null'], [false, true], [1, null]],
#=     inputs: {xs: [1, null]},
#= }
[transform([1, null], to_string), transform(xs, to_string), transform(xs, is_null), transform(xs, id)]
