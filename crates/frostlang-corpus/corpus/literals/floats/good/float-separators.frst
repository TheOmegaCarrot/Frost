# `_` separators may appear in a Float's whole part, fraction, and exponent, trailing
# any of them, and never change its value.
#= {
#=     result: [
#=         1000.5, 1.5, 10.5, 1000.0001, 1.5, 1.05, 0.1, 0.5,
#=         10000000000.0, 100000.0, 100000.0, 0.1, 1e-10, 100000.0,
#=         100000.0, 150.0, 150.0, 50.0, 50.0, 100000000000.0,
#=     ],
#= }
[
    1_000.5,
    1_.5,
    1__0.5,
    1_000.000_1,
    1.5_,
    1.0_5,
    .1_0,
    .5_,
    1e1_0,
    1e_5,
    1e+_5,
    1E-_1,
    1e-1_0,
    1e5_,
    1_e5,
    1.5_e2,
    1.5e_2_,
    .5e_2,
    .5_e2,
    1_0e1_0,
]
