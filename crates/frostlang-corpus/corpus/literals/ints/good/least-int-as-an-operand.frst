# The least Int literal works wherever an operand goes: in parentheses, as an
# element, as an argument, and as the right side of a binary operator.
#= {result: [-9223372036854775808, [-9223372036854775808], 'Int', -9223372036854775807]}
[
    (-9223372036854775808),
    [-9223372036854775808],
    type(-9223372036854775808),
    1 + -9223372036854775808,
]
