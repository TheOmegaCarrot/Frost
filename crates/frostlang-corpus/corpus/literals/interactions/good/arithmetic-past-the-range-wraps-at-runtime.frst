# Arithmetic past the Int range wraps the same way on Ints known only at runtime, and
# lands on the range-end literals.
#= {
#=     result: [true, true, true],
#=     inputs: {max: 9223372036854775807, min: -9223372036854775808},
#= }
[
    max + 1 == -9223372036854775808,
    min - 1 == 0x7fff_ffff_ffff_ffff,
    max * 2 == -2,
]
