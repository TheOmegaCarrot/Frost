# Literals that look alike stay distinct values when they share a program: `1`
# and `1.0` keep their types, and `-0.0` keeps its sign, which its String form
# shows. Merging look-alike constants must not conflate them.
#= {result: [['Int', 'Float', 'Int', 'Float'], ['0.0', '-0.0', '0.0']]}
[
    map([1, 1.0, 1, 1.0], fn x -> type(x)),
    map([0.0, -0.0, 0.0], fn x -> to_string(x)),
]
