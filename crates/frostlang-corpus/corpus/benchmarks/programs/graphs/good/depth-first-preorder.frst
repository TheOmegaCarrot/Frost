# A depth-first walk over an adjacency Map, threading the visit order through
# a fold over each node's neighbors. A cycle back to the start is cut off by
# the seen check, and a node that only points into the graph (f) is never
# reached from it.
#= {
#=     result: [['a', 'b', 'd', 'c', 'e'], ['e'], ['f', 'a', 'b', 'd', 'c', 'e']],
#=     inputs: {
#=         graph: {
#=             a: ['b', 'c'],
#=             b: ['d'],
#=             c: ['d', 'e'],
#=             d: ['a'],
#=             e: [],
#=             f: ['a'],
#=         },
#=     },
#=     bench: {
#=         inputs: {
#=             graph: {a: ['n0'], e: [], f: ['a']} + from_entries(map(range(150), fn i -> {
#=                 key: $'n${i}',
#=                 value: [$'n${(i * 2 + 1) % 150}', $'n${(i * 3 + 2) % 150}'],
#=             })),
#=         },
#=     },
#= }
def {graph} = import('inputs')
defn contains(xs, x) -> reduce(xs, false, fn found, y -> found or y == x)

defn visit(node, seen) ->
    if contains(seen, node): seen
    else: reduce(graph[node], seen + [node], fn acc, next -> visit(next, acc))

[visit('a', []), visit('e', []), visit('f', [])]
