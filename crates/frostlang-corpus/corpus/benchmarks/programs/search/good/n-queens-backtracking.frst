# N-queens by backtracking: a placement is an Array of column indexes, one
# per row, and each row folds over the candidate columns, collecting every
# completed board found below a safe one. Boards come out in lexicographic
# order, sizes 2 and 3 have none, and size 6 has fewer than size 5.
#= {
#=     result: {
#=         counts: [1, 0, 0, 2, 10, 4],
#=         four: [[1, 3, 0, 2], [2, 0, 3, 1]],
#=         first_of_six: [1, 3, 5, 0, 2, 4],
#=     },
#=     inputs: {sizes: [1, 2, 3, 4, 5, 6]},
#=     bench: true,
#= }
def {sizes} = import('inputs')
defn upto(n) -> if n == 0: [] else: upto(n - 1) + [n - 1]

defn absolute(x) -> if x < 0: -x else: x

defn safe(placed, column) -> {
    def row = len(placed)
    reduce(upto(row), true, fn ok, r ->
        ok and placed[r] != column and absolute(placed[r] - column) != row - r
    )
}

defn solutions(n) -> {
    def columns = upto(n)
    defn extend(placed) ->
        if len(placed) == n: [placed]
        else: reduce(columns, [], fn found, column ->
            if safe(placed, column): found + extend(placed + [column]) else: found
        )
    extend([])
}

{
    counts: map(sizes, fn n -> len(solutions(n))),
    four: solutions(4),
    first_of_six: solutions(6)[0],
}
