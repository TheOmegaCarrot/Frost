# A vending machine folded over events of different shapes: Map patterns
# pick out coins and selections, guards check the item and the credit in
# order (first matching arm wins), and a refund with no credit returns
# nothing more.
#= {
#=     result: {
#=         credit: 0,
#=         dispensed: ['cola', 'chips'],
#=         returned: 25,
#=         messages: ['need 50', 'no gum'],
#=     },
#=     inputs: {
#=         events: [
#=             {select: 'cola'},
#=             {coin: 25},
#=             {coin: 25},
#=             {select: 'cola'},
#=             {coin: 100},
#=             {select: 'gum'},
#=             {select: 'chips'},
#=             'refund',
#=             'refund',
#=         ],
#=         prices: {cola: 50, chips: 75},
#=     },
#=     bench: {
#=         inputs: {
#=             events: tile([
#=                 {select: 'cola'},
#=                 {coin: 25},
#=                 {coin: 25},
#=                 {select: 'cola'},
#=                 {coin: 100},
#=                 {select: 'gum'},
#=                 {select: 'chips'},
#=                 'refund',
#=             ], 80),
#=             prices: {cola: 50, chips: 75},
#=         },
#=     },
#= }
def {events, prices} = import('inputs')
defn handle(state, event) -> match event {
    {coin} => state + {credit: state.credit + coin},
    {select: item} if: not has(prices, item) => state + {messages: state.messages + [$'no ${item}']},
    {select: item} if: state.credit < prices[item] => state + {messages: state.messages + [$'need ${prices[item]}']},
    {select: item} => state + {
        credit: state.credit - prices[item],
        dispensed: state.dispensed + [item],
    },
    'refund' => state + {credit: 0, returned: state.returned + state.credit},
}

reduce(events, {credit: 0, dispensed: [], returned: 0, messages: []}, handle)
