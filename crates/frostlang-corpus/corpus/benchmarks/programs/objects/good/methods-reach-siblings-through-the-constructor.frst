# Methods that use their sibling methods: since a `def` cannot see itself,
# a method reaches the object by calling its constructor again by name,
# which `defn` makes visible inside its own body. Vectors scale, add, and
# measure themselves this way, and a derived method builds on two others.
#= {
#=     result: {
#=         sum: [4, 6],
#=         scaled: [3, 6],
#=         length_squared: 25,
#=         doubled: [6, 8],
#=     },
#=     inputs: {ax: 1, ay: 2, bx: 3, by: 4},
#=     bench: true,
#= }
def {ax, ay, bx, by} = import('inputs')
defn vector(x, y) -> {
    coords: fn -> [x, y],
    plus: fn other -> {
        def [ox, oy] = other.coords()
        vector(x + ox, y + oy)
    },
    times: fn k -> vector(x * k, y * k),
    dot: fn other -> {
        def [ox, oy] = other.coords()
        x * ox + y * oy
    },
    length_squared: fn -> vector(x, y).dot(vector(x, y)),
    doubled_sum: fn other -> vector(x, y).plus(other).times(2),
}

def a = vector(ax, ay)
def b = vector(bx, by)
{
    sum: a.plus(b).coords(),
    scaled: a.times(3).coords(),
    length_squared: b.length_squared(),
    doubled: b.doubled_sum(vector(0, 0)).coords(),
}
