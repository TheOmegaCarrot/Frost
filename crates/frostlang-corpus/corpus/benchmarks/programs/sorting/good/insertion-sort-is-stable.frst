# An insertion sort folded over its input, placing each element after every
# element not greater than it, so equal elements keep their input order.
# Records sort by age with ties in input order. Subtle: 2.0 and 2 are not
# equal under `==`, but neither is less than the other, so they too keep
# their input order.
#= {
#=     result: [
#=         ['e', 'b', 'd', 'a', 'c'],
#=         [-0.5, 1.5, 2.0, 2, 3],
#=         [2, 2.0],
#=     ],
#=     inputs: {
#=         people: [
#=             {name: 'a', age: 30},
#=             {name: 'b', age: 25},
#=             {name: 'c', age: 30},
#=             {name: 'd', age: 25},
#=             {name: 'e', age: 20},
#=         ],
#=         numbers: [3, 2.0, 1.5, 2, -0.5],
#=         flipped: [2, 2.0],
#=     },
#=     bench: {
#=         inputs: {
#=             people: map(range(45), fn i -> {name: $'p${i}', age: i * 37 % 15}),
#=             numbers: map(range(45), fn i -> {
#=                 if i % 3 == 0: i * 13 % 20 - 5
#=                 elif i % 3 == 1: (i * 7 % 20 - 5) * 1.0
#=                 else: (i * 11 % 40 - 10) / 2.0
#=             }),
#=             flipped: [2, 2.0],
#=         },
#=     },
#= }
def {people, numbers, flipped} = import('inputs')
defn sort_by(xs, key) -> {
    defn insert(sorted, x) -> match sorted {
        [] => [x],
        [first, ...rest] => if key(x) < key(first): [x] + sorted else: [first] + insert(rest, x),
    }
    reduce(xs, [], insert)
}

defn identity(x) -> x

[
    sort_by(people, fn person -> person.age) @ map(fn person -> person.name),
    sort_by(numbers, identity),
    sort_by(flipped, identity),
]
