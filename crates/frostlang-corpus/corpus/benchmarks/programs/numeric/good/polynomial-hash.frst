# A polynomial hash folded over character codes, reduced modulo a prime at
# every step as real hashes are, so the multiply never leaves the Int range.
# The empty input hashes to the seed.
#= {
#=     result: [384764074, 912832879, 7, 7000021, 216893570],
#=     inputs: {
#=         inputs_to_hash: [
#=             [104, 101, 108, 108, 111, 32, 119, 111, 114, 108, 100],
#=             [104, 101, 108],
#=             [],
#=             [0],
#=             [255, 255, 255, 255, 255, 255, 255, 255],
#=         ],
#=     },
#=     bench: {
#=         inputs: {
#=             inputs_to_hash: map(range(20), fn n -> map(range(n * 20), fn i -> (i * 31 + n) % 256)),
#=         },
#=     },
#= }
def {inputs_to_hash} = import('inputs')
defn hash(codes) -> reduce(codes, 7, fn h, code -> (h * 1000003 + code) % 1000000007)
map(inputs_to_hash, hash)
