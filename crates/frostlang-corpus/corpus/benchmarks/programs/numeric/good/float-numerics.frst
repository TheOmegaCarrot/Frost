# Floating-point numerics: the trapezoid rule integrates x^2 over [0, 1] with
# four strips (dyadic values, so the sum is exact), and Newton's method for
# the square root of 2 runs until an iteration stops changing the guess.
# Int and Float operands mix, a Float result never compares equal to an Int,
# and every step is deterministic IEEE arithmetic.
#= {
#=     result: {
#=         area: 0.34375,
#=         root: 1.414213562373095,
#=         iterations: 6,
#=         halves: [1.5, 1.4166666666666665, 1.4142156862745097],
#=         exact_int_is_not_float: false,
#=     },
#=     inputs: {strips: 4, target: 2},
#=     bench: {inputs: {strips: 500, target: 2}},
#= }
def {strips, target} = import('inputs')
defn from_to(low, high) -> if low > high: [] else: [low] + from_to(low + 1, high)

defn trapezoid(f, a, b, n) -> {
    def h = (b - a) / n
    def inner = reduce(from_to(1, n - 1), 0.0, fn sum, i -> sum + f(a + i * h))
    h * ((f(a) + f(b)) / 2 + inner)
}

defn newton(x, guess, steps, seen) -> {
    def better = (guess + x / guess) / 2.0
    if better == guess: {root: guess, iterations: steps, seen}
    else: newton(x, better, steps + 1, seen + [better])
}

def solved = newton(target, 1.0, 1, [])
{
    area: trapezoid(fn x -> x * x, 0.0, 1.0, strips),
    root: solved.root,
    iterations: solved.iterations,
    halves: [solved.seen[0], solved.seen[1], solved.seen[2]],
    exact_int_is_not_float: trapezoid(fn x -> 2, 0.0, 1.0, strips) == 2,
}
