# A pipeline threaded with `@`: keep the even numbers, square them, and sum.
# Subtle: -2 is even (its remainder is 0), and the empty input reaches the
# reduce's initial value without any stage calling its function.
#= {
#=     result: [56, 0, 4, 0],
#=     inputs: {
#=         runs: [[1, 2, 3, 4, 5, 6], [], [-2, 7], [1, 3, 5]],
#=     },
#=     bench: {inputs: {runs: map(range(40), fn n -> range(-n, 3 * n))}},
#= }
def {runs} = import('inputs')
defn sum_of_even_squares(xs) -> (
    xs
    @ filter(fn x -> x % 2 == 0)
    @ map(fn x -> x * x)
    @ reduce(0, fn total, x -> total + x)
)

map(runs, sum_of_even_squares)
