# A restocking pass over a Map of items: `filter` keeps the entries below
# their minimum, `map` turns each into an order quantity (its operation
# returns a one-entry Map, merged into the result), and a `reduce` without an
# initial value joins the report lines, seeding with the first.
#= {
#=     result: {
#=         orders: {bolts: 15, gears: 3},
#=         report: 'bolts x15, gears x3',
#=         empty: {},
#=     },
#=     inputs: {
#=         inventory: {
#=             nuts: {stock: 50, min: 10},
#=             bolts: {stock: 5, min: 20},
#=             gears: {stock: 0, min: 3},
#=             washers: {stock: 7, min: 7},
#=         },
#=     },
#=     bench: {
#=         inputs: {
#=             inventory: from_entries(map(range(1000), fn i -> {
#=                 key: $'part${i}',
#=                 value: {stock: i % 40, min: i % 25},
#=             })),
#=         },
#=     },
#= }
def {inventory} = import('inputs')
defn restock(items) -> {
    def low = filter(items, fn name, item -> item.stock < item.min)
    map(low, fn name, item -> {[name]: item.min - item.stock})
}

def orders = restock(inventory)
def lines = reduce(orders, [], fn acc, name, quantity -> acc + [$'${name} x${quantity}'])
{
    orders,
    report: reduce(lines, fn joined, line -> joined + ', ' + line),
    empty: restock({}),
}
