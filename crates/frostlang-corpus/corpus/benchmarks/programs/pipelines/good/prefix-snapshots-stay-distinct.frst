# Running prefixes and cumulative inventories: each step extends the last
# element of the accumulator, which the accumulator still holds, so every
# earlier prefix must survive unchanged. The same holds for Maps merged
# step by step and for Strings concatenated.
#= {
#=     result: {
#=         prefixes: [[], [1], [1, 2], [1, 2, 3]],
#=         stock: [{}, {a: 1}, {a: 1, b: 2}, {a: 4, b: 2}],
#=         words: ['', 'é', 'é日', 'é日x'],
#=         untouched: [1, 2, 3],
#=     },
#=     inputs: {
#=         xs: [1, 2, 3],
#=         deliveries: [{item: 'a', n: 1}, {item: 'b', n: 2}, {item: 'a', n: 3}],
#=         chars: ['é', '日', 'x'],
#=     },
#=     bench: {
#=         inputs: {
#=             xs: range(200),
#=             deliveries: map(range(200), fn i -> {item: $'item${i % 10}', n: i % 7 + 1}),
#=             chars: tile(['é', '日', 'x'], 70),
#=         },
#=     },
#= }
def {xs, deliveries, chars} = import('inputs')
def prefixes = reduce(xs, [[]], fn acc, x -> acc + [acc[-1] + [x]])
def stock = reduce(deliveries, [{}], fn acc, d -> {
    def last = acc[-1]
    acc + [last + {[d.item]: (last[d.item] or 0) + d.n}]
})
def words = reduce(chars, [''], fn acc, c -> acc + [acc[-1] + c])
{prefixes, stock, words, untouched: xs}
