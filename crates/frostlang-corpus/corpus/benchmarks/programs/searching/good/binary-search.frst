# A binary search over a sorted Array by index arithmetic: the midpoint uses
# truncating Int division, and a missing value yields Null. It finds the
# first and last elements, misses values below, between, and above, and finds
# nothing in an empty Array.
#= {
#=     result: [3, 0, 5, null, null, null, null, 2],
#=     inputs: {
#=         sorted: [1, 3, 5, 7, 9, 11],
#=         empty: [],
#=         words: ['ant', 'bee', 'cat', 'dog'],
#=     },
#=     bench: true,
#= }
def {sorted, empty, words} = import('inputs')
defn search(xs, target) -> {
    defn between(low, high) -> if low > high: null else: do {
        def middle = low + (high - low) / 2
        def found = xs[middle]
        if found == target: middle
        elif found < target: between(middle + 1, high)
        else: between(low, middle - 1)
    }
    between(0, len(xs) - 1)
}

[
    search(sorted, 7),
    search(sorted, 1),
    search(sorted, 11),
    search(sorted, 0),
    search(sorted, 4),
    search(sorted, 12),
    search(empty, 1),
    search(words, 'cat'),
]
