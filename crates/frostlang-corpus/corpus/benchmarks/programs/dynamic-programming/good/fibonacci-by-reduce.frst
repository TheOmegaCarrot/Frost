# Fibonacci numbers by reducing a pair over a counted Array. The pair also
# holds the next number, so F(91) is the last whose pair fits in an Int.
#= {
#=     result: [0, 1, 55, 4660046610375530309],
#=     inputs: {ns: [0, 1, 10, 91]},
#=     bench: true,
#= }
def {ns} = import('inputs')
defn upto(n) -> if n == 0: [] else: upto(n - 1) + [n - 1]
defn fib(n) -> reduce(upto(n), [0, 1], fn pair, i -> [pair[1], pair[0] + pair[1]])[0]
map(ns, fib)
