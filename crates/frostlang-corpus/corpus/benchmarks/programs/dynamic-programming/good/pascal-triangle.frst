# Pascal's triangle, each row folded from the previous one by pairing
# neighbors, built up to row 66, the last whose middle entry, C(66, 33), fits
# in an Int. Subtle because the next row is only built while one is wanted:
# building row 67 would overflow.
#= {
#=     result: {
#=         small: [[1], [1, 1], [1, 2, 1], [1, 3, 3, 1], [1, 4, 6, 4, 1], [1, 5, 10, 10, 5, 1]],
#=         middle: 7219428434016265740,
#=     },
#=     inputs: {small_count: 6, last: 66},
#=     bench: true,
#= }
def {small_count, last} = import('inputs')
defn next_row(row) -> {
    def middle = reduce(row, {previous: null, sums: []}, fn s, x ->
        if s.previous == null: {previous: x, sums: []}
        else: {previous: x, sums: s.sums + [s.previous + x]}
    )
    [1] + middle.sums + [1]
}
defn rows(count, built) -> if len(built) == count: built else: rows(count, built + [next_row(built[-1])])
def all = rows(last + 1, [[1]])
{
    small: rows(small_count, [[1]]),
    middle: all[last][last / 2],
}
