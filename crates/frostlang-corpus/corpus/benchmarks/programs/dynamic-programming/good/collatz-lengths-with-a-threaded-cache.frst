# Memoization without mutation: the cache is a Map threaded through every
# call, each call returning its answer together with the grown cache, and a
# fold carries it from one starting number to the next. Below 30, 27 has the
# longest Collatz sequence, 112 terms; the cache ends holding every number
# any sequence visited.
#= {
#=     result: {best: 27, length: 112, cached: 140, lengths_to_ten: [1, 2, 8, 3, 6, 9, 17, 4, 20, 7]},
#=     inputs: {limit: 30},
#=     bench: true,
#= }
def {limit} = import('inputs')
defn length(n, cache) ->
    if has(cache, n): [cache[n], cache]
    else: do {
        def next = if n % 2 == 0: n / 2 else: 3 * n + 1
        def [rest, grown] = length(next, cache)
        [rest + 1, grown + {[n]: rest + 1}]
    }

defn from_to(low, high) -> if low > high: [] else: [low] + from_to(low + 1, high)

def final = reduce(from_to(1, limit - 1), {best: null, length: 0, cache: {[1]: 1}, lengths: []}, fn s, n -> {
    def [l, cache] = length(n, s.cache)
    def longer = l > s.length
    {
        best: if longer: n else: s.best,
        length: if longer: l else: s.length,
        cache,
        lengths: s.lengths + [l],
    }
})

{
    best: final.best,
    length: final.length,
    cached: len(final.cache),
    lengths_to_ten: map(from_to(0, 9), fn i -> final.lengths[i]),
}
