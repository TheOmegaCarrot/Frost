# The Fibonacci reduction over constant arguments, which the optimizer may
# compute ahead of time: its results must agree with the runtime's, up to
# F(91), the last whose pair fits in an Int.
#= {result: [0, 1, 55, 4660046610375530309], bench: true}
defn upto(n) -> if n == 0: [] else: upto(n - 1) + [n - 1]
defn fib(n) -> reduce(upto(n), [0, 1], fn pair, i -> [pair[1], pair[0] + pair[1]])[0]
[fib(0), fib(1), fib(10), fib(91)]
