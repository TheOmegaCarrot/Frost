# A Lisp-like evaluator over nested Arrays: Ints are numbers, Strings are
# symbols, and an Array is a special form or an application. `if` and `let`
# are matched as literal heads before the general application arm, whose
# operator is looked up in a Map of Frost functions and folded over the
# evaluated arguments, so `+` and `-` take any number of them.
#= {
#=     result: [16, 10, 7, 0, 'small'],
#=     inputs: {
#=         programs: [
#=             ['let', 'x', 4, ['if', ['<', 'x', 5], ['*', 'x', 'x'], 0]],
#=             ['+', 1, 2, 3, 4],
#=             ['-', 10, 1, 2],
#=             ['let', 'x', 9, ['if', ['<', 'x', 5], ['*', 'x', 'x'], 0]],
#=             ['let', 'n', ['-', 3, 5], ['if', ['<', 'n', 0], 'label', 'other']],
#=         ],
#=     },
#=     bench: {
#=         inputs: {
#=             programs: map(range(200), fn i ->
#=                 ['let', 'x', i, ['if', ['<', 'x', 100], ['*', 'x', 'x'], ['-', 'x', 1, 2]]]),
#=         },
#=     },
#= }
def {programs} = import('inputs')
def builtins = {
    ['+']: fn a, b -> a + b,
    ['-']: fn a, b -> a - b,
    ['*']: fn a, b -> a * b,
    ['<']: fn a, b -> a < b,
}

defn evaluate(expr, env) -> match expr {
    n is Int => n,
    symbol is String => if has(env, symbol): env[symbol] else: error($'unbound symbol ${symbol}'),
    ['if', test, yes, no] => if evaluate(test, env): evaluate(yes, env) else: evaluate(no, env),
    ['let', name, value, body] => evaluate(body, env + {[name]: evaluate(value, env)}),
    [op, ...args] => do {
        def operation = builtins[op] or error($'unknown operator ${op}')
        reduce(map(args, fn arg -> evaluate(arg, env)), operation)
    },
}

map(programs, fn program -> evaluate(program, {label: 'small', other: 'large'}))
