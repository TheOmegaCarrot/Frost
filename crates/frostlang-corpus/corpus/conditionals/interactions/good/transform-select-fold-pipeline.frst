# `if`s as callbacks of the pipeline functions `transform`, `select`, and
# `fold`, threaded with `@`.
#= {result: 'fizz,buzz,fizz', inputs: {ns: [1, 3, 5, 6, 7]}}
(
    ns
    @ transform(fn n -> if n % 3 == 0: 'fizz' elif n % 5 == 0: 'buzz')
    @ select(fn s -> if s: true else: false)
    @ fold('', fn (acc, s) -> if acc == '': s else: acc + ',' + s)
)
