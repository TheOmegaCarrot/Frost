# A function recursing from every branch of an `elif` chain, one through a
# `do` block, completes a hundred thousand steps.
#= {result: 150000, inputs: {start: 100000}}
defn down(n, acc) -> if n == 0: acc
    elif n % 2 == 0: do {
        def m = n - 1
        down(m, acc + 2)
    }
    else: down(n - 1, acc + 1)
down(start, 0)
