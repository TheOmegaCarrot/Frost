# A `do` block may be the value a `match` examines, unparenthesized: the
# block's closing brace ends the subject, and the next brace opens the arms.
#= {result: ['empty', 'one'], inputs: {lists: [[], [1]]}}
map lists with fn xs -> match do {
    def n = len(xs)
    n
} {
    0 => 'empty',
    _ => 'one',
}
