# `has` in a condition finds a Map key of each key type, and an absent key
# takes the alternate.
#= {
#=     result: ['yes', 'yes', 'yes', 'yes', 'yes', 'no'],
#=     inputs: {
#=         m: {s: 1, [2]: 2, [0.5]: 3, [true]: 4, [x'ff']: 5},
#=         keys: ['s', 2, 0.5, true, x'ff', 'absent'],
#=     },
#= }
map keys with fn k -> if has(m, k): 'yes' else: 'no'
