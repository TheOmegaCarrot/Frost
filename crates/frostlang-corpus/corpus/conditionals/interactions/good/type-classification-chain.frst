# An `elif` chain of `is_*` tests classifies a value of every type.
#= {
#=     result: ['Null', 'Bool', 'Int', 'Float', 'String', 'Bytes', 'Array', 'Map', 'Function'],
#=     inputs: {values: [null, false, 0, 0.5, 'é', x'00', [], {}, fn -> 1]},
#= }
def {values} = import('inputs')
defn classify(v) -> if is_null(v): 'Null'
    elif is_bool(v): 'Bool'
    elif is_int(v): 'Int'
    elif is_float(v): 'Float'
    elif is_string(v): 'String'
    elif is_bytes(v): 'Bytes'
    elif is_array(v): 'Array'
    elif is_map(v): 'Map'
    elif is_function(v): 'Function'
    else: 'unknown'
map(values, classify)
