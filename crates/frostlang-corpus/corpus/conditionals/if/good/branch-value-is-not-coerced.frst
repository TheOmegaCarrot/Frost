# An `if` yields its taken branch's value exactly, of whatever type: the
# condition's truthiness never leaks into the result.
#= {result: ['yes', false, null, 0, [], {}]}
[
    if 1: 'yes' else: 2,
    if true: false else: true,
    if true: null else: 1,
    if null: 1 else: 0,
    if 'x': [] else: {},
    if false: [] else: {},
]
