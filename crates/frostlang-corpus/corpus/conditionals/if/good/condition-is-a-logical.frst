# A condition built from `and` and `not` decides by its whole value.
#= {
#=     result: [1, 2, 2, 2],
#=     inputs: {cases: [[true, false], [true, true], [false, false], [false, true]]},
#= }
def {cases} = import('inputs')
defn pick(a, b) -> if a and not b: 1 else: 2
map(cases, fn case -> call(pick, case))
