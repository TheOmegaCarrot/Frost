# An `if` nests in each branch of another, and every combination of the
# runtime conditions reaches its own leaf.
#= {
#=     result: [1, 2, 3, 4],
#=     inputs: {cases: [[true, true], [true, false], [false, true], [false, false]]},
#= }
defn pick(a, b) -> if a: (if b: 1 else: 2) else: (if b: 3 else: 4)
map cases with fn case -> call(pick, case)
