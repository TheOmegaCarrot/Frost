# Without parentheses, an `if` in a consequent takes the first `else`, and the
# outer `if` the second. Subtle: the nesting is decided by order alone.
#= {
#=     result: [1, 2, 3, 3],
#=     inputs: {cases: [[true, true], [true, false], [false, true], [false, false]]},
#= }
defn pick(a, b) -> if a: if b: 1 else: 2 else: 3
map cases with fn case -> call(pick, case)
