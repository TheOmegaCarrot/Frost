# A consequent `match` whose last arm is an `if` without `else` closes it at
# the match's brace, so an `elif` and `else` after the brace continue the
# outer chain. Subtle: the arm has no trailing comma, so only the brace ends
# the inner `if`.
#= {
#=     result: ['one', null, 'two', 'other'],
#=     inputs: {cases: [[true, 1], [true, 3], [false, 2], [false, 3]]},
#= }
defn describe(a, v) -> if a: match v {
    n is Int => if n == 1: 'one'
} elif v == 2: 'two' else: 'other'
map cases with fn c -> call(describe, c)
