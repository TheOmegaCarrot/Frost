# Inside a match, a line break may fall on either side of `as`.
#= {
#=     result: [{a: 1}, {a: 1}],
#=     lints: [['unused binding', '`a`'], ['unused binding', '`a`']],
#=     inputs: {v: {a: 1}},
#= }
[
    match v {
        {a}
            as m => m,
    },
    match v {
        {a} as
            m => m,
    },
]
