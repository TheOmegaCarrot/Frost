# A later alternative sees only the names bound before the alternative and its
# own: a parenthesized name there reads the enclosing binding, never the one an
# earlier, failed alternative made. Subtle: the first alternative binds `x` to
# 5 before failing; the second compares with the outer `x`, 7.
#= {result: 3, inputs: {v: [5, 7, 3]}}
def x = 7
match v {
    [x, 1, _] | [_, (x), x] => x,
    _ => 0,
}
