# Matches drive the callbacks of `map`, `filter`, and `reduce`.
#= {result: [[1, 2, 0], [[1], [2]], 3], inputs: {xs: [[1], [2], 'x']}}
def heads = map(xs, fn v -> match v {
    [h] => h,
    _ => 0,
})
def arrays = filter(xs, fn v -> match v {
    _ is Array => true,
    _ => false,
})
def total = reduce(heads, fn (acc, h) -> match h {
    n is Int => acc + n,
})
[heads, arrays, total]
