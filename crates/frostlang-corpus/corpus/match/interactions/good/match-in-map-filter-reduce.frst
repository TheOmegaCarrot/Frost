# Matches drive the dedicated `map`, `filter`, and `reduce` expressions.
#= {result: [[1, 2, 0], [[1], [2]], 3], inputs: {xs: [[1], [2], 'x']}}
def heads = map xs with fn v -> match v {
    [h] => h,
    _ => 0,
}
def arrays = filter xs with fn v -> match v {
    _ is Array => true,
    _ => false,
}
def total = reduce heads with fn (acc, h) -> match h {
    n is Int => acc + n,
}
[heads, arrays, total]
