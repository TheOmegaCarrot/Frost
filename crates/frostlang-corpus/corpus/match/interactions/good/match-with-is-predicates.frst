# The `is_*` predicates in a guard agree with the type constraints in a
# pattern.
#= {result: ['String', 'Int', 'Null', 'other'], inputs: {xs: ['s', 1, null, [1]]}}
transform(xs, fn v -> match v {
    x if: is_string(x) => 'String',
    x if: is_int(x) => 'Int',
    x if: is_null(x) => 'Null',
    _ => 'other',
})
