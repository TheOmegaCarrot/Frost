# Matches inside callbacks of the threaded `filter`, `reduce`, and `each`.
#= {
#=     result: [[{ok: 1}, {ok: 3}], 4],
#=     printed: ['error: bad'],
#=     lints: [['unused binding', '`ok`'], ['unused binding', '`err`']],
#=     inputs: {rs: [{ok: 1}, {err: 'bad'}, {ok: 3}]},
#= }
def oks = rs @ filter(fn r -> match r { {ok} => true, _ => false })
def sum = rs @ reduce(0, fn acc, r -> match r { {ok} => acc + ok, {err} => acc })
rs @ each(fn r -> match r {
    {err} => print($'error: ${err}'),
    _ => null,
})
[oks, sum]
