# A match target may be an unparenthesized `if`, with or without `else`: its
# last branch ends at the brace that opens the arms.
#= {result: [['one', 'two'], ['one', 'none']], inputs: {t: true, f: false}}
def {t, f} = import('inputs')
defn with_else(c) -> match if c: 1 else: 2 {
    1 => 'one',
    _ => 'two',
}
defn without_else(c) -> match if c: 1 {
    null => 'none',
    1 => 'one',
}
[[with_else(t), with_else(f)], [without_else(t), without_else(f)]]
