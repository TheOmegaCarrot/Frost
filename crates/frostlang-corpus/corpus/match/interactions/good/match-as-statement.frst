# A match used as a statement runs for its effects and its value is dropped;
# later statements run normally.
#= {
#=     result: 7,
#=     printed: ['matched 2'],
#=     lints: [['unused binding', '`a`'], ['unused binding', '`a`']],
#=     inputs: {v: [1, 2]},
#= }
def {v} = import('inputs')
match v {
    [a, b] => print($'matched ${b}'),
}
match v {
    {a} => 0,
    [..._] => 0,
}
7
