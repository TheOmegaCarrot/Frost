# A Map pattern's shorthand entry `{_}` is exactly `{_: _}`: it requires a key
# named "_" and binds nothing. Subtle: it is not an any-entry wildcard; that
# reading would need `{foo}` to stop being plain shorthand for `{foo: foo}`.
#= {result: ['no _ key', 'has _ key'], inputs: {xs: [{a: 1}, {_: 1}]}}
map(xs, fn v -> match v {
    {_} => 'has _ key',
    _ => 'no _ key',
})
