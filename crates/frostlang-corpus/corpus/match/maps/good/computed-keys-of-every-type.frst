# Computed keys of every valid Map key type (Bool, Int, Float, String, Bytes)
# look up their entries by value.
#= {
#=     result: ['bool', 'int', 'float', 'string', 'bytes'],
#=     inputs: {v: {[true]: 'bool', [1]: 'int', [1.5]: 'float', s: 'string', [x'00']: 'bytes'}},
#= }
def {v} = import('inputs')
match v {
    {[true]: b, [1]: i, [1.5]: f, ['s']: s, [x'00']: by} => [b, i, f, s, by],
}
