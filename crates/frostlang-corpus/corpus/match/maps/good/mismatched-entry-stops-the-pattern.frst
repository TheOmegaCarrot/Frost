# A present key whose value fails its pattern stops the Map pattern: later
# keys are not evaluated.
#= {
#=     result: 'no match',
#=     printed: ['a'],
#=     lints: [['unused binding', '`y`']],
#=     inputs: {v: {a: 1, b: 2}},
#= }
def {v} = import('inputs')
defn key(k) -> {
    print(k)
    k
}
match v {
    {[key('a')]: 2, [key('b')]: y} => 'match',
    _ => 'no match',
}
