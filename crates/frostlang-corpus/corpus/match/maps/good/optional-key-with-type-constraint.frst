# `{age? is Int}` means absent, or present and an Int. A present value of
# another type, Null included, does not match and the arm falls through.
#= {
#=     result: [['int', 3], ['int', null], ['other'], ['other'], ['other']],
#=     inputs: {a: {age: 3}, b: {}, c: {age: 's'}, d: {age: null}, e: 7},
#= }
def {a, b, c, d, e} = import('inputs')
defn read(m) -> match m {
    {age? is Int} => ['int', age],
    _ => ['other'],
}
[read(a), read(b), read(c), read(d), read(e)]
