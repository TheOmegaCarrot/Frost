# Inside a match, a line break may fall on either side of `is`.
#= {
#=     result: ['Int', 'String'],
#=     lints: [['unused binding', '`n`'], ['unused binding', '`n`']],
#=     inputs: {i: 1, s: 'a'},
#= }
def {i, s} = import('inputs')
defn kind(v) -> match v {
    n
        is Int => 'Int',
    n is
        String => 'String',
}
[kind(i), kind(s)]
