# A bare type name in a pattern is an ordinary binding, not a type test:
# `String => ...` matches every value and binds it to the name `String`.
# Subtle: type names are contextual keywords, valid as identifiers though
# inadvisable, so this means `_ is String` only to the reader.
#= {
#=     result: 'text',
#=     lints: [['type name binding', '`String`'], ['unused binding', '`String`']],
#=     inputs: {v: 5},
#= }
def {v} = import('inputs')
match v {
    1 => 'one',
    String => 'text',
}
