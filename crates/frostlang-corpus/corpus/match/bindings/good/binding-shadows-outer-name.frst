# A name in a pattern binds afresh, shadowing an enclosing name of the same
# spelling only within its arm; the outer name is unchanged afterwards.
# Subtle: the bare name binds rather than compares with the outer value.
#= {result: [2, 1], inputs: {v: 2}}
def {v} = import('inputs')
def x = 1
def r = match v {
    x => x,
}
[r, x]
