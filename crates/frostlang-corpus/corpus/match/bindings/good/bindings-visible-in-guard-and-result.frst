# An arm's bindings are visible to both its guard and its result.
#= {
#=     result: 'descending',
#=     lints: [['unused binding', '`a`'], ['unused binding', '`b`']],
#=     inputs: {v: [3, 1]},
#= }
def {v} = import('inputs')
match v {
    [a, b] if: a > b => 'descending',
    [a, b] => 'ascending',
}
