# A parenthesized value is evaluated only when matching reaches it: values in
# arms already failed, or after a failed part, never run.
#= {result: 'third', printed: ['0', '3', '1', '2'], inputs: {v: [1, 2]}}
defn note(n) -> {
    print(to_string(n))
    n
}
match v {
    [(note(0)), (note(9))] => 'first',
    [_, (note(3))] => 'second',
    [(note(1)), (note(2))] => 'third',
}
