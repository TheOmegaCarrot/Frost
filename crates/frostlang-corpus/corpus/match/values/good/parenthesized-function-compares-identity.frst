# A Function is equal only to itself: the same closure matches its own
# parenthesized name, and an identical-looking lambda made separately does not.
#= {result: ['same', 'different']}
def f = fn -> 1
def g = fn -> 1
[
    match f { (f) => 'same', _ => 'different' },
    match g { (f) => 'same', _ => 'different' },
]
