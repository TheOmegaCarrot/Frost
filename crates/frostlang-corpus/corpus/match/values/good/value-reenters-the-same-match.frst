# A parenthesized value may call the enclosing function, running the same match
# while the outer one is partway through its pattern; the outer arm then
# carries on. Here each pair's second element must be its first's depth plus
# one.
#= {result: [0, 1, 2, 'bad'], inputs: {xs: [null, [null, 1], [[null, 1], 2], [[null, 1], 3]]}}
defn depth(v) -> match v {
    null => 0,
    [inner, (depth(inner) + 1)] => depth(inner) + 1,
    _ => 'bad',
}
map(xs, depth)
