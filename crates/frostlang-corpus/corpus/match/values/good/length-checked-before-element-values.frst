# An Array pattern checks the length before evaluating any element value, so
# a wrong-length target runs none of them.
#= {result: 'other', printed: [], inputs: {v: [1]}}
def {v} = import('inputs')
defn note(n) -> {
    print(to_string(n))
    n
}
match v {
    [(note(1)), (note(2))] => 'pair',
    _ => 'other',
}
