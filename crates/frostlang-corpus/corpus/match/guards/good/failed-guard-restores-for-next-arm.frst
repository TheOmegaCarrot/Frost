# After a destructuring arm's guard fails, the next arm sees the whole target
# afresh, and surrounding values are undisturbed.
#= {
#=     result: [6, 9],
#=     lints: [
#=         ['unused binding', '`a`'],
#=         ['unused binding', '`b`'],
#=         ['unused binding', '`c`'],
#=         ['unused binding', '`a`'],
#=     ],
#=     inputs: {v: [1, [2, 3]]},
#= }
def {v} = import('inputs')
[
    match v {
        [a, [b, c]] if: false => 0,
        {a} => 0,
        [a, [b, c]] => a + b + c,
    },
    9,
]
