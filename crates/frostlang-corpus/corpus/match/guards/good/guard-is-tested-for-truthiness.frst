# A guard need not be a Bool: it passes when truthy. Only Null and `false`
# fail it; 0, empty Strings, and empty structures pass.
#= {
#=     result: ['pass', 'pass', 'pass', 'pass', 'pass', 'pass', 'fail', 'fail'],
#=     inputs: {xs: [true, 0, 0.0, '', [], {}, null, false]},
#= }
transform(xs, fn g -> match 1 {
    _ if: g => 'pass',
    _ => 'fail',
})
