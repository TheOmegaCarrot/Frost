# Arms are tried top to bottom, stopping at the first that matches: the guards
# of later arms never run.
#= {
#=     result: 3,
#=     printed: ['1', '2', '3'],
#=     lints: [['unused binding', '`x`']],
#=     inputs: {v: 3},
#= }
def {v} = import('inputs')
defn check(label, ok) -> {
    print(label)
    ok
}
match v {
    x if: check('1', x == 1) => 1,
    x if: check('2', x == 2) => 2,
    x if: check('3', x == 3) => 3,
    x if: check('4', true) => 4,
}
