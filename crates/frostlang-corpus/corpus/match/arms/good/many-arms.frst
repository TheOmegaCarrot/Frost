# A match with many arms tries each in turn; values near the end are reached.
#= {result: ['a', 'f', 'l', 'other'], inputs: {xs: [1, 6, 12, 13]}}
map(xs, fn n -> match n {
    1 => 'a',
    2 => 'b',
    3 => 'c',
    4 => 'd',
    5 => 'e',
    6 => 'f',
    7 => 'g',
    8 => 'h',
    9 => 'i',
    10 => 'j',
    11 => 'k',
    12 => 'l',
    _ => 'other',
})
