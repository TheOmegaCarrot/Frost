# An Int literal pattern matches an equal Int, including zero and negatives.
#= {result: ['zero', 'one', 'minus one', 'other'], inputs: {xs: [0, 1, -1, 2]}}
def {xs} = import('inputs')
defn name(n) -> match n {
    0 => 'zero',
    1 => 'one',
    -1 => 'minus one',
    _ => 'other',
}
map(xs, name)
