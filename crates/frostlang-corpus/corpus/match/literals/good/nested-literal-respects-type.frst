# A literal nested in an Array pattern matches only its own type, as at the top
# level: the element 1 never matches the pattern element 1.0, nor 1.0 the
# pattern element 1.
#= {result: ['Int', 'Float'], inputs: {xs: [[1], [1.0]]}}
transform(xs, fn v -> match v {
    [1.0] => 'Float',
    [1] => 'Int',
})
