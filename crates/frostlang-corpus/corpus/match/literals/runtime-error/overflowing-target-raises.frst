# Int overflow raises, so the largest Int plus one never reaches the literal
# pattern for the smallest Int. Subtle: the target is computed at runtime here,
# so the error comes from the VM, not the optimizer.
#= {raises: ['Int overflow', '9223372036854775807 + 1'], inputs: {max: 9223372036854775807, one: 1}}
def {max, one} = import('inputs')
defn name(n) -> match n {
    9223372036854775807 => 'max',
    -9223372036854775808 => 'min',
}
name(max + one)
