# An Array pattern never matches a non-Array, even one with a length or
# elements: Strings, Bytes, and Maps fall through.
#= {
#=     result: ['other', 'other', 'other', 'other', 'other'],
#=     lints: [
#=         ['unused binding', '`x`'],
#=         ['unused binding', '`x`'],
#=         ['unused binding', '`y`'],
#=     ],
#=     inputs: {xs: ['ab', x'0000', {a: 1}, null, 5]},
#= }
def {xs} = import('inputs')
map(xs, fn v -> match v {
    [] => 'empty',
    [x] => 'one',
    [x, y] => 'two',
    [..._] => 'any',
    _ => 'other',
})
