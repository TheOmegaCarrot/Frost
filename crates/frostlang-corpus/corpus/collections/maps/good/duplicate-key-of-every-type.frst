# The last entry wins for a repeated key of every key type.
#= {
#=     result: [
#=         {[true]: 2},
#=         {[1]: 2},
#=         {[1.5]: 2},
#=         {['s']: 2},
#=         {[x'00']: 2},
#=     ],
#= }
[
    {[true]: 1, [true]: 2},
    {[1]: 1, [1]: 2},
    {[1.5]: 1, [1.5]: 2},
    {['s']: 1, ['s']: 2},
    {[x'00']: 1, [x'00']: 2},
]
