# The `index` global makes a function reading one key, behaving as a soft
# index: Null for a missing entry, negative Array indexes from the end.
#= {
#=     result: [[1, 3], ['ada', null], 30],
#=     inputs: {rows: [[1, 2], [3, 4]], people: [{name: 'ada'}, {}], xs: [10, 20, 30]},
#= }
[map(rows, index(0)), map(people, index('name')), index(-1)(xs)]
