# A match subject may be an index or field read, and an out-of-range read is
# matched as Null.
#= {result: ['two', 'none', 'map'], inputs: {xs: [1, 2], m: {inner: {}}}}
defn describe(v) -> match v {
    2 => 'two',
    null => 'none',
    _ is Map => 'map',
    _ => 'other',
}
[describe(xs[1]), describe(xs[5]), describe(m.inner)]
