# The zeros of colliding-zero-keys-keep-the-first-key, known only at runtime,
# collide the same way, in a literal and in a merge: the entry keeps the key
# inserted first and the value inserted last. `to_string` shows the kept key's
# sign.
#= {
#=     result: ['{ [0.0]: "b" }', '{ [-0.0]: "b" }', '{ [-0.0]: 2 }', '{ [0.0]: 2 }'],
#=     inputs: {z: 0.0, nz: -0.0},
#= }
[
    to_string({[z]: 'a', [nz]: 'b'}),
    to_string({[nz]: 'a', [z]: 'b'}),
    to_string({[nz]: 1} + {[z]: 2}),
    to_string({[z]: 1} + {[nz]: 2}),
]
