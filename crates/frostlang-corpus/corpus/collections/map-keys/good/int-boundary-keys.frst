# The largest and smallest Ints are ordinary, distinct keys, found whether
# written as a literal or computed in range. The smallest Int is computed,
# since its magnitude has no literal.
#= {result: ['max', 'min', 'min', 'max', 2]}
def max = 9223372036854775807
def min = -9223372036854775807 - 1
def m = {[max]: 'max', [min]: 'min'}
[m[9223372036854775807], m[-9223372036854775807 - 1], m[min + 1 - 1], m[max - 1 + 1], len(m)]
