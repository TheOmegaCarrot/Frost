# Int keys at the boundaries, supplied at runtime, round-trip through a Map,
# including when a key is recomputed in range.
#= {
#=     result: ['max', 'min', 'max', 'min'],
#=     inputs: {max: 9223372036854775807, min: -9223372036854775808, one: 1},
#= }
def {max, min, one} = import('inputs')
def m = {[max]: 'max', [min]: 'min'}
[m[max], m[min], m[max - one + one], m[min + one - one]]
