# Int keys at the boundaries, supplied at runtime, round-trip through a Map,
# and wrapping past one boundary lands on the other's key.
#= {
#=     result: ['max', 'min', 'min', 'max'],
#=     inputs: {max: 9223372036854775807, one: 1},
#= }
def min = max + one
def m = {[max]: 'max', [min]: 'min'}
[m[max], m[min], m[max + one], m[min - one]]
