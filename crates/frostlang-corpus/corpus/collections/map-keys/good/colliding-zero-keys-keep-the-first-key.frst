# `0.0` and `-0.0` are equal, so as Map keys they collide. As with any
# colliding equal keys, the entry keeps the key inserted first and the value
# inserted last. Subtle: the two zeros render differently, so the kept key's
# sign shows through `to_string`.
#= {
#=     result: ['{ [0.0]: "b" }', '{ [-0.0]: "b" }', '{ [-0.0]: 2 }', '{ [-0.0]: 1 }'],
#= }
[
    to_string({[0.0]: 'a', [-0.0]: 'b'}),
    to_string({[-0.0]: 'a', [0.0]: 'b'}),
    to_string({[-0.0]: 1} + {[0.0]: 2}),
    to_string({[-0.0]: 1}),
]
