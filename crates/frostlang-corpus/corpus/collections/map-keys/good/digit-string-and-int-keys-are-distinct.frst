# A String of digits is not an Int: `'1'` and `1` are distinct Map keys, each
# found only by its own type, at compile time and at runtime.
#= {
#=     result: [2, 'int', 'string', null, 'int', 'string'],
#=     inputs: {i: 1, s: '1', m: {[1]: 'int'}},
#= }
def both = {[1]: 'int', ['1']: 'string'}
[len(both), both[1], both['1'], m['1'], m[i], {[s]: 'string'}['1']]
