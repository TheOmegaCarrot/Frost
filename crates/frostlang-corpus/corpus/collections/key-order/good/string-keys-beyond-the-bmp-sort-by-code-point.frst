# String keys beyond the Basic Multilingual Plane sort after every key inside
# it. Subtle because an order by UTF-16 code units would put the emoji
# (leading surrogate U+D83D) before U+E000 and U+FFFF.
#= {result: ['z', '\u{e000}', '\u{ffff}', '\u{1f600}'], inputs: {emoji: '😀'}}
def m = {[emoji]: 1, ['\u{ffff}']: 2, ['\u{e000}']: 3, ['z']: 4}
reduce(m, [], fn acc, k, v -> acc + [k])
