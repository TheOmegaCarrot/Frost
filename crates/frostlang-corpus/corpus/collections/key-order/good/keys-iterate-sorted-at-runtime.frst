# A Map built from runtime keys iterates them in the same sorted order as one
# built from constants.
#= {
#=     result: [false, true, -3, 2, 1.5, 'a', 'b', x'00'],
#=     inputs: {keys: ['b', x'00', 2, 1.5, true, false, 'a', -3]},
#= }
def m = fold(keys, {}, fn acc, k -> acc + {[k]: null})
fold(m, [], fn acc, k, v -> acc + [k])
