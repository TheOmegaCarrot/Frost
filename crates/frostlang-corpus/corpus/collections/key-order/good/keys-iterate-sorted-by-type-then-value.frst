# A Map iterates its keys sorted, whatever order they were written in: by
# type first (Bool, Int, Float, String, Bytes), then by value within a type.
#= {result: [false, true, -3, 2, 1.5, 'a', 'b', x'00']}
def m = {
    ['b']: 1,
    [x'00']: 2,
    [2]: 3,
    [1.5]: 4,
    [true]: 5,
    [false]: 6,
    ['a']: 7,
    [-3]: 8,
}
reduce(m, [], fn acc, k, v -> acc + [k])
