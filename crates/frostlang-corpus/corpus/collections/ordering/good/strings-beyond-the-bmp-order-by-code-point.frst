# A code point beyond the Basic Multilingual Plane orders after every code
# point inside it. Subtle because an order by UTF-16 code units would put the
# emoji's leading surrogate (U+D83D) before U+FFFF.
#= {result: [true, true, false], inputs: {top: '\u{ffff}', emoji: '😀'}}
[top < emoji, '\u{ffff}' < '\u{1f600}', emoji < '\u{e000}']
