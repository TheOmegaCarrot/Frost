# Equal Arrays order as equal whatever they hold: element pairs equal by `==`
# are passed over without being ordered, so `<=` and `>=` are true and `<` is
# false. Subtle: Null and Map are not orderable themselves.
#= {result: [true, true, false, true], inputs: {a: [null], b: [null], m: [{}]}}
[a <= b, a >= b, a < b, m <= [{}]]
