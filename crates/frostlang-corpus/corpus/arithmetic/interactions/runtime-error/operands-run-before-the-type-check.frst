# Both operands are evaluated before the operator checks their types: in
# `'a' + (1 / 0)` the operands could never be added, yet the division by zero
# in the right operand raises first. Subtle because the left operand's type
# alone already dooms the addition.
#= {raises: 'division by zero', inputs: {one: 1, zero: 0}}
def {one, zero} = import('inputs')
'a' + (one / zero)
