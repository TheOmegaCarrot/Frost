# A deeply parenthesized expression mixing every operator evaluates from the
# innermost group outward.
#= {result: [1, 1], inputs: {one: 1, two: 2, three: 3, four: 4, five: 5, six: 6}}
def {one, two, three, four, five, six} = import('inputs')
[
    (((((1 + 2) * 3) - 4) / 5) % 6) * -(-1),
    (((((one + two) * three) - four) / five) % six) * -(-one),
]
