# A constant computation too long for the compiler to evaluate ahead of time
# still gives the exact answer at runtime, wrapping included. Subtle because
# every argument is constant, yet the work must be left for runtime.
#= {result: [5000050000, 9223372036854675807]}
defn sum_to(n, acc) -> if n == 0: acc else: sum_to(n - 1, acc + n)
defn add_greatest(n, acc) -> if n == 0: acc else: add_greatest(n - 1, acc + 9223372036854775807)
[
    sum_to(100000, 0),
    add_greatest(100001, 0),
]
