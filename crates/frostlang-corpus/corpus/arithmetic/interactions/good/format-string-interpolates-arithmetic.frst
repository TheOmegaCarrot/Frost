# A format string interpolates the value of an arithmetic expression, Ints
# and Floats each in their own form.
#= {result: ['3 and 3.5 and -1', '3 and 3.5 and -1'], inputs: {one: 1, two: 2, seven: 7}}
[
    $'${1 + 2} and ${7 / 2.0} and ${-7 % 3}',
    $'${one + two} and ${seven / 2.0} and ${-seven % 3}',
]
