# Because a remainder takes the dividend's sign, `x % 2 == 1` finds only the
# positive odd numbers: -3 % 2 is -1. `x % 2 != 0` finds them all. Subtle
# because it is the classic mistake with a truncating modulus.
#= {
#=     result: [[1, 3], [-3, -1, 1, 3], [-2, 0, 2]],
#=     inputs: {xs: [-3, -2, -1, 0, 1, 2, 3]},
#= }
[
    filter(xs, fn x -> x % 2 == 1),
    filter(xs, fn x -> x % 2 != 0),
    xs @ filter($($ % 2 == 0)),
]
