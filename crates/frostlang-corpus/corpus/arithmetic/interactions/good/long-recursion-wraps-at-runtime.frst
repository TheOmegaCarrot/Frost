# A long tail-recursive sum over arguments only known at runtime gives the
# exact answer, and a running sum of greatest Ints wraps at every step.
# 100001 times the greatest Int is the greatest Int minus 100000, modulo 2^64.
#= {result: [5000050000, 9223372036854675807], inputs: {count: 100000, odd_count: 100001, zero: 0}}
defn sum_to(n, acc) -> if n == 0: acc else: sum_to(n - 1, acc + n)
defn add_greatest(n, acc) -> if n == 0: acc else: add_greatest(n - 1, acc + 9223372036854775807)
[
    sum_to(count, zero),
    add_greatest(odd_count, zero),
]
