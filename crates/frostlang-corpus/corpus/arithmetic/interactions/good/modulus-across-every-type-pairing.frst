# `%` across every pairing of types, with nonzero values known only at
# runtime: it succeeds only between two Ints. Unlike the other arithmetic
# operators, a Float in either position is a type error.
#= {
#=     result: [
#=         [false, false, false, false, false, false, false, false, false],
#=         [false, false, false, false, false, false, false, false, false],
#=         [false, false, true, false, false, false, false, false, false],
#=         [false, false, false, false, false, false, false, false, false],
#=         [false, false, false, false, false, false, false, false, false],
#=         [false, false, false, false, false, false, false, false, false],
#=         [false, false, false, false, false, false, false, false, false],
#=         [false, false, false, false, false, false, false, false, false],
#=         [false, false, false, false, false, false, false, false, false],
#=     ],
#=     inputs: {values: [null, true, 2, 1.5, 'a', x'62', [1], {k: 1}, fn -> 1]},
#= }
map(values, fn a -> map(values,fn b -> try_call(fn -> a % b).ok))
