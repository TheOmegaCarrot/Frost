# Reducing with `+` sums the elements. The accumulator's type carries through:
# a Float start makes a Float sum, and an empty Array reduces to the start.
#= {result: [10, 10.0, 0, 6], inputs: {xs: [1, 2, 3, 4], empty: []}}
[
    reduce(xs, 0, fn acc, x -> acc + x),
    reduce(xs, 0.0, fn acc, x -> acc + x),
    reduce(empty, 0, fn acc, x -> acc + x),
    reduce([1, 2, 3], fn acc, x -> acc + x),
]
