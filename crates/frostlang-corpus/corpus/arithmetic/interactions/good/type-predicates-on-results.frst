# The type predicates see each result's type: Int over Ints, Float as soon as
# a Float is involved, and Numeric either way.
#= {result: [true, false, true, true, true, true], inputs: {seven: 7, two: 2}}
def {seven, two} = import('inputs')
[
    is_int(seven / two),
    is_float(seven / two),
    is_float(seven / 2.0),
    is_numeric(seven + 0.5),
    is_int(-seven),
    is_int(seven % two),
]
