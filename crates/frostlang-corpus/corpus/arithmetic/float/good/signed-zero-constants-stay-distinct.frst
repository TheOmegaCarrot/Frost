# The constants 0.0 and -0.0 in one function stay distinct, though they order
# as equal. The branch condition is an input, so the zeros are loaded as
# constants at runtime rather than folded into the result. Subtle because
# merging look-alike constants would lose the sign.
#= {result: ['0.0', '-0.0', '-0.0', '0.0'], inputs: {flag: true}}
def {flag} = import('inputs')
def positive = if flag: 0.0 else: 1
def negative = if flag: -0.0 else: 1
def product = if flag: 0.0 * -1.0 else: 1
def sum = if flag: -0.0 + 0.0 else: 1
[
    to_string(positive),
    to_string(negative),
    to_string(product),
    to_string(sum),
]
