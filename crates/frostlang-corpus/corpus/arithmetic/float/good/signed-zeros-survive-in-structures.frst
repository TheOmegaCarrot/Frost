# A signed-zero result keeps its sign inside a constant structure, even beside
# a structure holding 0.0. Subtle because the zeros order as equal and
# look alike, so treating the constants as interchangeable would lose the sign.
#= {result: ['0.0', '-0.0', '-0.0', '0.0']}
def positive = [0.0 * 1.0]
def negative = [0.0 * -1.0]
defn literal_negative() -> [-0.0]
defn literal_positive() -> [0.0]
[
    to_string(positive[0]),
    to_string(negative[0]),
    to_string(literal_negative()[0]),
    to_string(literal_positive()[0]),
]
