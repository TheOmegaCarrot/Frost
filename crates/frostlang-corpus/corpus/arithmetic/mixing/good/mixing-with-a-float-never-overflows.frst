# Once a Float is involved, arithmetic is Float arithmetic: the greatest Int
# plus 1.0 is a Float past the Int range, not an Int overflow.
#= {result: [9223372036854775808.0, true], inputs: {greatest: 9223372036854775807}}
def {greatest} = import('inputs')
[
    greatest + 1.0,
    greatest + 1.0 > 0,
]
