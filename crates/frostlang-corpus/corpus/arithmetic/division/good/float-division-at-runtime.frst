# Float division of operands only known at runtime is true division, rounding
# exactly as a folded quotient does.
#= {
#=     result: [3.5, -0.25, 0.3333333333333333, 2.0, 0.0],
#=     inputs: {one: 1.0, two: 2.0, three: 3.0, four: 4.0, five: 5.0, seven: 7.0, zero: 0.0, d: 2.5},
#= }
def {one, two, three, four, five, seven, zero, d} = import('inputs')
[
    seven / two,
    -one / four,
    one / three,
    five / d,
    zero / three,
]
