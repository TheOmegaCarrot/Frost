# `-` on two Floats only known at runtime takes the right operand from the
# left, rounding exactly as a folded difference does.
#= {
#=     result: [3.0, -3.0, 0.0, 1.0, 0.09999999999999998],
#=     inputs: {a: 5.5, b: 2.5, c: 1.25, d: -1.5, e: 0.3, f: 0.2},
#= }
def {a, b, c, d, e, f} = import('inputs')
[
    a - b,
    b - a,
    c - c,
    d - -b,
    e - f,
]
