# Negating 0.0 gives -0.0, which prints with its sign and is not equal to 0.0.
# Subtle because Int zero has no sign, but Float zero does.
#= {result: ['-0.0', '0.0', false, true], inputs: {zero: 0.0}}
def {zero} = import('inputs')
[
    to_string(-zero),
    to_string(-(-zero)),
    -zero == zero,
    -(-zero) == zero,
]
