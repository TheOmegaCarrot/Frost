# Int multiplication past the Int range keeps the low 64 bits of the product,
# in two's complement, instead of raising. The least Int times -1 is itself.
#= {
#=     result: [
#=         -2,
#=         1,
#=         0,
#=         -9223372036854775808,
#=         -9223372036854775808,
#=         9223372036854775805,
#=         0,
#=     ],
#= }
[
    9223372036854775807 * 2,
    9223372036854775807 * 9223372036854775807,
    -9223372036854775808 * -9223372036854775808,
    -9223372036854775808 * -1,
    9223372036854775807 * -9223372036854775808,
    9223372036854775807 * 3,
    -9223372036854775808 * 2,
]
