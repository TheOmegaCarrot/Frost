# Wrapping arithmetic is modular, so an overflow undone by a later step leaves
# the exact answer: overflowing on the way does not lose information.
#= {
#=     result: [9223372036854775807, -9223372036854775808, 6],
#=     inputs: {greatest: 9223372036854775807, least: -9223372036854775808},
#= }
[
    greatest + 1 - 1,
    least - 1 + 1,
    greatest + 4 - greatest + 2,
]
