# `map`, `filter`, and `reduce` are syntax, not calls to `transform`, `select`,
# and `fold`: shadowing those globals does not change the keyword forms, while
# a call to the shadowed name gets the binding.
#= {
#=     result: [[2, 3], [2], 3, 'mine'],
#=     lints: [['unused binding', '`select`'], ['unused binding', '`fold`']],
#= }
def transform = fn xs, f -> 'mine'
def select = fn xs, f -> 'mine'
def fold = fn xs, start, f -> 'mine'
[
    map [1, 2] with fn x -> x + 1,
    filter [1, 2] with fn x -> x > 1,
    reduce [1, 2] init: 0 with fn (acc, x) -> acc + x,
    [1] @ transform(fn x -> x),
]
