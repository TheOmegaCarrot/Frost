# `select`, `transform`, and `fold` call lambdas that read enclosing bindings,
# both constant and runtime.
#= {result: [[30, 40], 70], inputs: {limit: 2, xs: [1, 2, 3, 4]}}
def scale = 10
def kept = (xs
    @ select(fn x -> x > limit)
    @ transform(fn x -> x * scale))
[kept, fold(kept, 0, fn acc, x -> acc + x)]
