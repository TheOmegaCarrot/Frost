# Without forward references, two functions can still recurse into each other
# when one is handed the other as an argument.
#= {result: [true, false, false, true]}
defn is_odd_with(n, is_even) -> if n == 0: false else: is_even(n - 1)
defn is_even(n) -> if n == 0: true else: is_odd_with(n - 1, is_even)
[is_even(0), is_even(3), is_odd_with(0, is_even), is_odd_with(7, is_even)]
