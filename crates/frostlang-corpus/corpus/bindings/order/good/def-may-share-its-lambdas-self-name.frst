# `def f = fn f(...) -> ...` binds the same name twice in different scopes: the
# lambda's own name inside it, and the `def` outside. The lambda recurses
# through its own name, so this is the explicit form of `defn`.
#= {result: 'done', inputs: {n: 3}}
def f = fn f(k) -> if k == 0: 'done' else: f(k - 1)
f(n)
