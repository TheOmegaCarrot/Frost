# Captured Int boundaries wrap when the closure does arithmetic on them, both
# for a constant capture the compiler may build into the closure and for a
# runtime one.
#= {
#=     result: [-9223372036854775808, -9223372036854775808],
#=     inputs: {max: 9223372036854775807},
#= }
def big = 9223372036854775807
def folded = fn -> big + 1
def runtime = fn -> max + 1
[folded(), runtime()]
